---
export interface Props {
  title: string;
  description: string;
  /** Slug-style path beginning with `/`. Used for canonical + OG URL. */
  path?: string;
  /** Absolute or relative OG image. Defaults to /og/default.png. */
  image?: string;
  /** noindex flag for pages we don't want crawled. */
  noindex?: boolean;
  /** JSON-LD schema object. Will be stringified. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** og:type — "website" (default) or "article". */
  type?: 'website' | 'article';
}

const {
  title,
  description,
  path = '/',
  image = '/og/default.png',
  noindex = false,
  jsonLd,
  type = 'website',
} = Astro.props;

const site = Astro.site?.toString().replace(/\/$/, '') ?? 'https://pillexislabs.com';
const url = `${site}${path === '/' ? '' : path}`;
const ogImage = image.startsWith('http') ? image : `${site}${image}`;
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={url} />
{noindex && <meta name="robots" content="noindex,nofollow" />}

<!-- Open Graph -->
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={url} />
<meta property="og:type" content={type} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:site_name" content="Pillexis Labs" />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

{jsonLd && (
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
)}
