---
/**
 * Loads the Cal.com popup widget and wires booking analytics.
 *
 * Drop this once on any page that has a "Book a call" CTA. The widget
 * auto-binds to any element with these data attributes:
 *
 *   data-cal-link="pillexislabs/pillexis-labs-intro-call"
 *   data-cal-namespace="pillexis-labs-intro-call"
 *   data-cal-config='{"layout":"month_view"}'
 *
 * For click + conversion tracking, add `data-book-call="<source>"` to
 * the same element. The source string lands in GA + Pixel as the event
 * label, e.g. "nav", "hero", "quiz_result_shipper".
 */
---

{/* 1. Cal.com init — must be inline (no bundler). Lazy-loads embed.js
       into <head> on first Cal() call. */}
<script is:inline>
  (function (C, A, L) {
    let p = function (a, ar) { a.q.push(ar); };
    let d = C.document;
    C.Cal = C.Cal || function () {
      let cal = C.Cal;
      let ar = arguments;
      if (!cal.loaded) {
        cal.ns = {};
        cal.q = cal.q || [];
        d.head.appendChild(d.createElement("script")).src = A;
        cal.loaded = true;
      }
      if (ar[0] === L) {
        const api = function () { p(api, arguments); };
        const namespace = ar[1];
        api.q = api.q || [];
        if (typeof namespace === "string") {
          cal.ns[namespace] = cal.ns[namespace] || api;
          p(cal.ns[namespace], ar);
          p(cal, ["initNamespace", namespace]);
        } else {
          p(cal, ar);
        }
        return;
      }
      p(cal, ar);
    };
  })(window, "https://app.cal.com/embed/embed.js", "init");

  Cal("init", "pillexis-labs-intro-call", { origin: "https://cal.com" });
  Cal.ns["pillexis-labs-intro-call"]("ui", {
    hideEventTypeDetails: false,
    layout: "month_view",
  });
</script>

{/* 2. Booking analytics — Astro-bundled module. Imports the shared helper. */}
<script>
  import { bookingEvents } from '../lib/analytics.js';

  const CAL_NAMESPACE = 'pillexis-labs-intro-call';

  function getCookie(name: string): string {
    const match = document.cookie.match(
      new RegExp('(?:^|; )' + name.replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + '=([^;]*)'),
    );
    return match ? decodeURIComponent(match[1]) : '';
  }

  // Pass Meta click + browser cookies through Cal.com booking metadata so
  // the server-side webhook (netlify/functions/cal-booking.ts) can forward
  // them to the Conversions API for ad attribution. Cookies are set by the
  // Pixel script in BaseLayout.astro on first ad click.
  function patchCalConfigs(): void {
    const fbc = getCookie('_fbc');
    const fbp = getCookie('_fbp');
    const landingUrl = location.href;
    document.querySelectorAll<HTMLElement>('[data-cal-link]').forEach((el) => {
      let config: Record<string, any> = {};
      try {
        config = JSON.parse(el.getAttribute('data-cal-config') || '{}');
      } catch {
        config = {};
      }
      config.metadata = {
        ...(config.metadata || {}),
        ...(fbc ? { fbc } : {}),
        ...(fbp ? { fbp } : {}),
        landingUrl,
      };
      el.setAttribute('data-cal-config', JSON.stringify(config));
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', patchCalConfigs);
  } else {
    patchCalConfigs();
  }

  // Click tracking on every CTA with `data-book-call`.
  // Uses event delegation so we catch dynamically-added CTAs too
  // (e.g. the quiz result screen).
  document.addEventListener('click', (e) => {
    const target = (e.target as HTMLElement | null)?.closest('[data-book-call]');
    if (!target) return;

    // Stop the browser from also navigating to the href. We keep the
    // `<a href="https://cal.com/...">` for SEO + right-click + no-JS
    // fallback, but once JS is loaded the popup handles the booking
    // flow. Cal.com's own listener fires alongside ours and opens the
    // modal — preventDefault here just stops the duplicate new tab.
    if (target.hasAttribute('data-cal-link')) {
      e.preventDefault();
    }

    const source = target.getAttribute('data-book-call') || 'unknown';
    bookingEvents.clicked(source);

    // A CTA click is intent. Count a form open separately only after Cal's
    // embedded frame is present and visible, so popup failures are measurable.
    let attempts = 0;
    const findOpenForm = window.setInterval(() => {
      attempts += 1;
      const frame = Array.from(document.querySelectorAll<HTMLIFrameElement>('iframe'))
        .find((iframe) => iframe.src.includes('cal.com') && iframe.getClientRects().length > 0);
      if (frame) {
        window.clearInterval(findOpenForm);
        bookingEvents.formOpened(source);
      } else if (attempts >= 20) {
        window.clearInterval(findOpenForm);
      }
    }, 250);
  });

  // Record the first time a visitor sees each meaningful page section.
  const seenSections = new Set<string>();
  const sectionObserver = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (!entry.isIntersecting) return;
      const name = (entry.target as HTMLElement).dataset.analyticsSection;
      if (!name || seenSections.has(name)) return;
      seenSections.add(name);
      bookingEvents.sectionViewed(name);
      sectionObserver.unobserve(entry.target);
    });
  }, { threshold: 0.35 });
  document.querySelectorAll<HTMLElement>('[data-analytics-section]').forEach((section) => {
    sectionObserver.observe(section);
  });

  // Successful booking → conversion event for GA + Pixel Schedule.
  // Subscribe on the NAMESPACED Cal instance — the popup opens via
  // Cal.ns[namespace], not the global Cal, so `bookingSuccessful` events
  // only fire on the namespaced emitter. (Subscribing on global Cal here
  // was the bug that kept the Schedule / generate_lead events at zero.)
  // The init shim queues calls until embed.js loads, so calling this
  // before Cal is fully ready is safe.
  const ns = (window as any).Cal?.ns?.[CAL_NAMESPACE];
  if (typeof ns === 'function') {
    ns('on', {
      action: 'bookingSuccessful',
      callback: (e: any) => {
        const detail = e?.detail?.data;
        const uid: string | undefined = detail?.booking?.uid || detail?.uid;
        bookingEvents.scheduled(detail, uid);
      },
    });
  }
</script>
