---
import ThemeToggle from './ThemeToggle.astro';

export interface Props {
  links: { href: string; label: string }[];
  ctaLabel?: string;
  ctaSource?: string;
}

const { links, ctaLabel = 'Book a 20-min call', ctaSource = 'nav' } = Astro.props;
---

<nav class="site-nav" aria-label="Main navigation" data-site-nav>
  <div class="site-nav__inner">
    <a href="/" class="site-nav__logo" aria-label="Pillexis Labs home">
      <img src="/brand/logomark.svg" alt="" width="24" height="24" />
      <span>Pillexis Labs</span>
    </a>

    <div class="site-nav__desktop-links">
      {links.map((link) => <a href={link.href}>{link.label}</a>)}
    </div>

    <div class="site-nav__actions">
      <ThemeToggle />
      <a href="https://cal.com/pillexislabs/pillexis-labs-intro-call" target="_blank" rel="noopener" class="site-nav__cta site-nav__cta--desktop" data-cal-link="pillexislabs/pillexis-labs-intro-call" data-cal-namespace="pillexis-labs-intro-call" data-cal-config='{"layout":"month_view"}' data-book-call={ctaSource}>{ctaLabel}</a>
      <button class="site-nav__menu-button" type="button" aria-expanded="false" aria-controls="site-nav-menu" aria-label="Open navigation" data-nav-toggle>
        <span></span><span></span>
      </button>
    </div>
  </div>

  <div class="site-nav__mobile-menu" id="site-nav-menu" hidden data-nav-menu>
    <div class="site-nav__mobile-links">
      {links.map((link) => <a href={link.href}>{link.label}</a>)}
      <a href="https://cal.com/pillexislabs/pillexis-labs-intro-call" target="_blank" rel="noopener" class="site-nav__cta" data-cal-link="pillexislabs/pillexis-labs-intro-call" data-cal-namespace="pillexis-labs-intro-call" data-cal-config='{"layout":"month_view"}' data-book-call={`${ctaSource}_mobile`}>{ctaLabel}</a>
    </div>
  </div>
</nav>

<script>
  document.querySelectorAll<HTMLElement>('[data-site-nav]').forEach((nav) => {
    const button = nav.querySelector<HTMLButtonElement>('[data-nav-toggle]');
    const menu = nav.querySelector<HTMLElement>('[data-nav-menu]');
    if (!button || !menu) return;

    const setOpen = (open: boolean) => {
      button.setAttribute('aria-expanded', String(open));
      button.setAttribute('aria-label', open ? 'Close navigation' : 'Open navigation');
      menu.hidden = !open;
      nav.toggleAttribute('data-menu-open', open);
    };

    button.addEventListener('click', () => setOpen(button.getAttribute('aria-expanded') !== 'true'));
    menu.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setOpen(false)));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && button.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        button.focus();
      }
    });
    window.matchMedia('(min-width: 769px)').addEventListener('change', (event) => {
      if (event.matches) setOpen(false);
    });
  });
</script>
