---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "Forge · Your morning engineering brief for macOS";
const description = "Forge pulls overnight activity from GitHub, Slack, Linear, and Notion, and Claude turns it into one scannable 5-minute brief. Native macOS. Your keys. No servers.";
const path = "/forge";

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'Forge',
    applicationCategory: 'DeveloperApplication',
    operatingSystem: 'macOS',
    description,
    url: `https://pillexislabs.com${path}`,
    publisher: {
      '@type': 'Organization',
      name: 'Pillexis Labs',
      url: 'https://pillexislabs.com',
    },
    offers: { '@type': 'Offer', price: '49', priceCurrency: 'USD' },
  },
];
---

<BaseLayout title={title} description={description} path={path} image="/og/forge.png" jsonLd={jsonLd}>
  <!-- HERO -->
  <section class="hero">
    <div class="grid-bg" aria-hidden="true"></div>
    <div class="hero-bloom" aria-hidden="true"></div>
    <div class="hero-inner">
      <a href="/" class="back-link">
        <svg width="12" height="12" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 12H5M12 19l-7-7 7-7" />
        </svg>
        Pillexis Labs
      </a>

      <span class="pill-eyebrow">
        <span class="pill-dot"></span>
        Forge · A Pillexis Labs product
      </span>

      <h1 class="hero-title">
        Your morning engineering brief,<br/><em>in 5 minutes.</em>
      </h1>

      <p class="hero-sub">
        Forge pulls overnight activity from GitHub, Slack, Linear, and Notion, and Claude turns it into one scannable view. <strong>Your keys. Your machine. No servers.</strong>
      </p>

      <div class="hero-cta-row">
        <a href="https://github.com/anurag619/forge" class="btn-primary" target="_blank" rel="noopener">View on GitHub</a>
        <a href="#brief" class="btn-secondary">See the brief</a>
      </div>

      <div class="hero-meta">
        <span class="hero-meta-item">Source available</span>
        <span class="hero-meta-sep">·</span>
        <span class="hero-meta-item">Apple Silicon &amp; Intel</span>
        <span class="hero-meta-sep">·</span>
        <span class="hero-meta-item">macOS 13 Ventura+</span>
      </div>
    </div>
  </section>

  <!-- PROBLEM -->
  <section class="problem">
    <div class="container">
      <h2 class="section-title">50 notification emails. <em>Zero context.</em></h2>
      <p class="section-sub">
        GitHub pings, Slack mentions, Linear updates, Notion edits. Every CTO wakes up to the same inbox sludge. Forge reads it for you and tells you what changed, what shipped, and what's stuck.
      </p>
    </div>
  </section>

  <!-- THE BRIEF -->
  <section class="ritual" id="brief">
    <div class="container">
      <h2 class="section-title">One window. <em>Four sources.</em> Five minutes.</h2>
      <p class="section-sub">
        Merged PRs ranked by review depth. Slack channels condensed to decisions and mentions. Linear issues per team. Notion edits that matter. All summarized by Claude with the receipts inline.
      </p>

      <div class="source-grid">
        <div class="source-card source-gh">
          <div class="source-head">
            <span class="source-version">Source 01</span>
            <span class="source-label">GitHub</span>
          </div>
          <h3>Merged with signal.</h3>
          <p>PRs ranked by review depth, file scope, and reviewer trust. Title and description quality scored. Pushback and unreviewed merges flagged.</p>
        </div>

        <div class="source-card source-sl">
          <div class="source-head">
            <span class="source-version">Source 02</span>
            <span class="source-label">Slack</span>
          </div>
          <h3>Channels, not pings.</h3>
          <p>Per-channel digests with decisions extracted, blockers surfaced, and mentions of you on top. Read the room without opening it.</p>
        </div>

        <div class="source-card source-ln">
          <div class="source-head">
            <span class="source-version">Source 03</span>
            <span class="source-label">Linear</span>
          </div>
          <h3>What moved.</h3>
          <p>Issue updates grouped by team. NEW / DONE / UPD tagged. Priority, assignee, and recent comments inline.</p>
        </div>

        <div class="source-card source-nt">
          <div class="source-head">
            <span class="source-version">Source 04</span>
            <span class="source-label">Notion</span>
          </div>
          <h3>Edits that matter.</h3>
          <p>Pages updated overnight with a content summary and key points. Skip the firehose of revision notifications.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- PRIVACY -->
  <section class="sources" id="privacy">
    <div class="container">
      <h2 class="section-title">Built like a Mac app <em>should be.</em></h2>
      <p class="section-sub">
        Forge runs on your machine. Tokens live in the macOS Keychain. Data lives in a local SQLite file you can <code>cat</code>. No backend. No telemetry. No SaaS.
      </p>

      <div class="problem-grid">
        <div class="problem-card">
          <div class="problem-tag">Binary</div>
          <h3>Native Rust binary</h3>
          <p>~10MB signed .dmg. Built with Tauri. Apple Silicon and Intel.</p>
        </div>
        <div class="problem-card">
          <div class="problem-tag">Tokens</div>
          <h3>Keychain-scoped credentials</h3>
          <p>Every token lives in the macOS Keychain. None of them ever leave your Mac.</p>
        </div>
        <div class="problem-card">
          <div class="problem-tag">Storage</div>
          <h3>Local SQLite</h3>
          <p>One file at <code>~/.forge-brief/db.sqlite</code>. Inspect it yourself, back it up, throw it away.</p>
        </div>
        <div class="problem-card">
          <div class="problem-tag">Code</div>
          <h3>Source available</h3>
          <p>Read every line on GitHub. Build it yourself if you'd rather. Patches welcome.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="ritual">
    <div class="container">
      <h2 class="section-title">Three steps. <em>Five minutes.</em></h2>

      <div class="ritual-grid">
        <div class="ritual-step">
          <span class="ritual-num">Step 01</span>
          <h3>Install the .dmg</h3>
          <p>Signed and notarized. macOS 13 Ventura or later. Apple Silicon or Intel.</p>
        </div>
        <div class="ritual-step">
          <span class="ritual-num">Step 02</span>
          <h3>Paste your tokens</h3>
          <p>GitHub OAuth, an Anthropic API key, and the Slack, Linear, or Notion tokens you want. Pick any subset. Forge silently skips sources you haven't configured.</p>
        </div>
        <div class="ritual-step">
          <span class="ritual-num">Step 03</span>
          <h3>Open Forge tomorrow morning</h3>
          <p>Auto-syncs on launch. Your brief is waiting before your first sip of coffee.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="ritual" id="faq">
    <div class="container">
      <h2 class="section-title">Things people ask.</h2>

      <details>
        <summary>Does Forge send my data anywhere?</summary>
        <p>Only to the APIs you configure: GitHub, Slack, Linear, Notion, and Anthropic. Forge has no backend. We never see your tokens, your repos, your messages, or your brief. The app makes the same HTTP calls your browser would, just on your behalf.</p>
      </details>

      <details>
        <summary>Do I need to be on macOS?</summary>
        <p>Yes. Forge is a native Mac app. macOS 13 Ventura or later, Apple Silicon or Intel.</p>
      </details>

      <details>
        <summary>What if I don't have all four integrations?</summary>
        <p>Connect any subset. Forge silently skips sources you haven't configured. GitHub-only is a perfectly valid setup.</p>
      </details>

      <details>
        <summary>How much does Claude cost to run?</summary>
        <p>Forge uses Claude Haiku (cheap, fast). Per-PR about $0.001, per-channel-digest about $0.002. Typical solo CTO with 4 sources: $2 to $6 per month, billed to your Anthropic account directly.</p>
      </details>

      <details>
        <summary>Is it open source?</summary>
        <p>Source-available on GitHub. You can read every line, build it yourself, and run it locally today. A signed binary and a paid plan will follow once we're out of dogfood.</p>
      </details>

      <details>
        <summary>How do I export my data if I stop using it?</summary>
        <p>Your data is one SQLite file at <code>~/.forge-brief/db.sqlite</code>. Open it in any SQLite browser. Each brief is also a row of markdown-friendly text you can pipe wherever.</p>
      </details>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-final">
    <div class="container">
      <h2 class="section-title">Forge is in <em>dogfood.</em></h2>
      <p class="section-sub">
        The signed .dmg isn't public yet. The source is, and we're handing builds to a small group of engineering leads while we harden v0.4. Drop us a line if you'd like one.
      </p>
      <a href="mailto:contact@pillexislabs.com?subject=Forge%20early%20access" class="btn-primary">
        Email us for early access
      </a>
      <div class="cta-foot">
        <a href="/ai-labs">← Back to Pillexis Labs</a>
        <span class="sep">·</span>
        <a href="/">Work with us</a>
        <span class="sep">·</span>
        <a href="https://github.com/anurag619/forge" target="_blank" rel="noopener">GitHub</a>
      </div>
    </div>
  </section>

  <style>
    /* Section helpers */
    section { padding: 4.5rem 1.5rem; position: relative; }
    .container { max-width: var(--layout-max); margin: 0 auto; position: relative; }
    .eyebrow {
      font-family: var(--mono);
      font-size: 0.72rem;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--red);
      margin-bottom: 1.2rem;
    }
    .section-title {
      font-family: var(--sans);
      font-weight: 800;
      font-size: clamp(2rem, 4.4vw, 3.2rem);
      letter-spacing: -0.035em;
      line-height: 1.1;
      color: var(--text);
      margin-bottom: 1rem;
      max-width: 820px;
    }
    .section-title em {
      font-style: italic;
      background: linear-gradient(180deg, var(--peach) 0%, var(--red) 100%);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }
    .section-sub {
      color: var(--text-muted);
      font-size: 1.08rem;
      line-height: 1.65;
      max-width: 720px;
      margin-bottom: 3rem;
    }
    .section-sub code,
    .built .section-sub code {
      font-family: var(--mono);
      font-size: 0.88em;
      background: rgba(255, 255, 255, 0.04);
      padding: 0.1rem 0.4rem;
      border-radius: 4px;
      color: var(--peach);
    }

    /* Source accent palette (matches the brief's color coding) */
    .source-gh { --src-accent: #b6c5d5; --src-bg: rgba(182, 197, 213, 0.08); }
    .source-sl { --src-accent: #f3a5b8; --src-bg: rgba(243, 165, 184, 0.08); }
    .source-ln { --src-accent: #9aa8d6; --src-bg: rgba(154, 168, 214, 0.08); }
    .source-nt { --src-accent: #e8b864; --src-bg: rgba(232, 184, 100, 0.08); }

    /* HERO */
    .hero {
      padding: 7rem 1.5rem 4rem;
      overflow: hidden;
    }
    .hero-bloom {
      position: absolute;
      inset: 0;
      pointer-events: none;
      background:
        radial-gradient(ellipse 65% 50% at 20% 0%, rgba(255, 99, 99, 0.22), transparent 60%),
        radial-gradient(ellipse 70% 50% at 95% 30%, rgba(255, 140, 80, 0.12), transparent 70%);
    }
    .grid-bg {
      position: absolute; inset: 0; pointer-events: none; opacity: 0.5;
      background-image: radial-gradient(rgba(255, 255, 255, 0.045) 1px, transparent 1px);
      background-size: 22px 22px;
      -webkit-mask-image: linear-gradient(180deg, #000 5%, transparent 80%);
              mask-image: linear-gradient(180deg, #000 5%, transparent 80%);
    }
    .hero-inner { position: relative; max-width: 920px; margin: 0 auto; }

    .back-link {
      display: inline-flex; align-items: center; gap: 0.4rem;
      font-family: var(--mono); font-size: 0.72rem;
      letter-spacing: 0.16em; text-transform: uppercase;
      color: var(--text-muted); margin-bottom: 2.5rem;
      transition: color 0.2s, gap 0.2s;
    }
    .back-link:hover { color: var(--red); gap: 0.55rem; }

    .pill-eyebrow {
      display: inline-flex; align-items: center; gap: 0.55rem;
      font-family: var(--mono); font-size: 0.72rem; font-weight: 500;
      letter-spacing: 0.14em; text-transform: uppercase; color: var(--red);
      padding: 0.4rem 0.85rem;
      background: rgba(255, 99, 99, 0.08);
      border: 1px solid rgba(255, 99, 99, 0.22);
      border-radius: 7px;
      margin-bottom: 2rem;
    }
    .pill-dot {
      width: 6px; height: 6px; border-radius: 50%;
      background: var(--red); box-shadow: 0 0 10px var(--red);
    }

    .hero-title {
      font-family: var(--sans);
      font-weight: 800;
      font-size: clamp(2.5rem, 6.5vw, 4.6rem);
      letter-spacing: -0.045em;
      line-height: 1.02;
      color: var(--text);
      margin-bottom: 1.5rem;
    }
    .hero-title em {
      font-style: italic;
      background: linear-gradient(180deg, var(--peach) 0%, var(--red) 100%);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }
    .hero-sub {
      font-size: 1.15rem;
      color: var(--text-muted);
      line-height: 1.6;
      max-width: 720px;
      margin-bottom: 2rem;
    }
    .hero-meta {
      display: flex;
      align-items: center;
      gap: 0.55rem;
      flex-wrap: wrap;
      font-family: var(--mono);
      font-size: 0.72rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--text-dim);
      margin-bottom: 2.5rem;
    }
    .hero-meta-item {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
    }
    .hero-meta-sep { color: var(--hairline-strong); }
    .hero-meta-item .dot.amber {
      width: 6px; height: 6px; border-radius: 50%;
      background: #f59e0b; box-shadow: 0 0 8px #f59e0b;
    }

    .hero-cta-row { display: flex; gap: 0.7rem; flex-wrap: wrap; }
    .btn-primary {
      display: inline-flex; align-items: center; gap: 0.5rem;
      padding: 0.9rem 1.4rem; border-radius: 10px;
      background: var(--red); color: #fff;
      font-weight: 500; font-size: 0.95rem;
      border: 1px solid rgba(255, 255, 255, 0.12);
      box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.25),
        0 0 30px rgba(255, 99, 99, 0.3);
      transition: transform 0.15s, background 0.2s;
    }
    .btn-primary:hover { background: var(--red-hot); transform: translateY(-1px); }
    .btn-secondary {
      display: inline-flex; align-items: center; gap: 0.5rem;
      padding: 0.9rem 1.3rem; border-radius: 10px;
      background: var(--surface); color: var(--text);
      border: 1px solid var(--hairline);
      font-weight: 500; font-size: 0.95rem;
      transition: background 0.2s, border-color 0.2s;
    }
    .btn-secondary:hover { background: var(--surface-2); border-color: var(--hairline-strong); }

    /* PROBLEM */
    .problem { background: var(--bg); border-top: 1px solid var(--hairline); }
    .problem-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 1.25rem;
    }
    .problem-card {
      background: var(--surface);
      border: 1px solid var(--hairline);
      border-left: 3px solid var(--src-accent, var(--hairline-strong));
      border-radius: var(--r-lg);
      padding: 1.75rem;
      transition: transform 0.2s, border-color 0.2s;
    }
    .problem-card:hover {
      transform: translateY(-2px);
    }
    .problem-tag {
      display: inline-block;
      font-family: var(--mono);
      font-size: 0.66rem;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--src-accent, var(--text-muted));
      background: var(--src-bg, rgba(255, 255, 255, 0.04));
      padding: 0.25rem 0.55rem;
      border-radius: 4px;
      margin-bottom: 1rem;
    }
    .problem-card h3 {
      font-family: var(--sans);
      font-weight: 700;
      font-size: 1.2rem;
      letter-spacing: -0.018em;
      color: var(--text);
      margin-bottom: 0.55rem;
    }
    .problem-card p {
      color: var(--text-muted);
      font-size: 0.95rem;
      line-height: 1.6;
    }

    /* RITUAL */
    .ritual { background: var(--bg-elev); border-top: 1px solid var(--hairline); }
    .ritual-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.25rem;
      margin-top: 2.5rem;
    }
    .ritual-step {
      background: var(--surface);
      border: 1px solid var(--hairline);
      border-radius: var(--r-lg);
      padding: 1.75rem;
    }
    .ritual-num {
      font-family: var(--mono);
      font-size: 0.7rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--red);
      display: block;
      margin-bottom: 0.85rem;
    }
    .ritual-step h3 {
      font-family: var(--sans);
      font-weight: 700;
      font-size: 1.18rem;
      letter-spacing: -0.018em;
      color: var(--text);
      margin-bottom: 0.5rem;
    }
    .ritual-step p {
      color: var(--text-muted);
      font-size: 0.95rem;
      line-height: 1.6;
    }

    /* FOUR SOURCES */
    .sources { background: var(--bg); border-top: 1px solid var(--hairline); }
    .source-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 1.25rem;
      margin-top: 2.5rem;
    }
    .source-card {
      background: var(--surface);
      border: 1px solid var(--hairline);
      border-left: 3px solid var(--src-accent, var(--hairline-strong));
      border-radius: var(--r-lg);
      padding: 1.75rem;
      transition: transform 0.2s, box-shadow 0.2s;
    }
    .source-card:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
    }
    .source-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 1rem;
    }
    .source-version {
      font-family: var(--mono);
      font-size: 0.65rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--text-dim);
    }
    .source-label {
      font-family: var(--mono);
      font-size: 0.66rem;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--src-accent);
      background: var(--src-bg);
      padding: 0.25rem 0.55rem;
      border-radius: 4px;
    }
    .source-card h3 {
      font-family: var(--sans);
      font-weight: 700;
      font-size: 1.2rem;
      letter-spacing: -0.018em;
      color: var(--text);
      margin-bottom: 0.55rem;
    }
    .source-card p {
      color: var(--text-muted);
      font-size: 0.95rem;
      line-height: 1.6;
    }

    /* BUILT */
    .built {
      background: var(--bg-elev);
      border-top: 1px solid var(--hairline);
      padding-top: 4rem;
      padding-bottom: 4rem;
    }
    .built .section-sub { max-width: 780px; margin-bottom: 0; }

    /* LOCAL MODELS BET */
    .local-bet {
      background: var(--bg);
      border-top: 1px solid var(--hairline);
      position: relative;
      overflow: hidden;
    }
    .local-bg {
      position: absolute; inset: 0; pointer-events: none;
      background: radial-gradient(ellipse 70% 50% at 80% 20%, rgba(245, 158, 11, 0.10), transparent 65%);
    }

    .shifts {
      display: flex;
      flex-direction: column;
      gap: 1rem;
      margin: 0 0 4rem;
    }
    .shift {
      background: var(--surface);
      border: 1px solid var(--hairline);
      border-left: 3px solid #f59e0b;
      border-radius: var(--r-md);
      padding: 1.5rem 1.75rem;
    }
    .shift-num {
      display: inline-block;
      font-family: var(--mono);
      font-size: 0.7rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: #f59e0b;
      margin-bottom: 0.7rem;
    }
    .shift h3 {
      font-family: var(--sans);
      font-weight: 700;
      font-size: 1.2rem;
      letter-spacing: -0.018em;
      color: var(--text);
      margin-bottom: 0.65rem;
    }
    .shift p {
      color: var(--text-muted);
      font-size: 1rem;
      line-height: 1.65;
    }
    .shift p em {
      color: var(--peach);
      font-style: italic;
    }

    .cloud-vs-local-title {
      font-family: var(--sans);
      font-weight: 700;
      font-size: 1.3rem;
      letter-spacing: -0.02em;
      color: var(--text);
      margin-bottom: 1.25rem;
    }
    .vs-table {
      background: var(--surface);
      border: 1px solid var(--hairline);
      border-radius: var(--r-md);
      overflow: hidden;
    }
    .vs-row {
      display: grid;
      grid-template-columns: 1.2fr 1fr 1fr;
      border-bottom: 1px solid var(--hairline);
      font-size: 0.95rem;
    }
    .vs-row:last-child { border-bottom: 0; }
    .vs-row > div {
      padding: 1rem 1.25rem;
      color: var(--text);
    }
    .vs-row > div:nth-child(2) {
      color: var(--text-muted);
      border-left: 1px solid var(--hairline);
    }
    .vs-row > div:nth-child(3) {
      color: var(--text);
      border-left: 1px solid var(--hairline);
    }
    .vs-row.vs-head > div {
      font-family: var(--mono);
      font-size: 0.7rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--text-dim);
      background: rgba(255, 255, 255, 0.02);
      padding: 0.8rem 1.25rem;
    }
    .vs-feature {
      font-family: var(--mono);
      font-size: 0.78rem;
      letter-spacing: 0.06em;
      color: var(--text);
    }
    .vs-good {
      color: #f59e0b !important;
      font-weight: 500;
    }

    /* ROADMAP */
    .roadmap { background: var(--bg-elev); border-top: 1px solid var(--hairline); }
    .roadmap-list {
      list-style: none;
      margin-top: 2.5rem;
      padding: 0;
    }
    .roadmap-item {
      display: grid;
      grid-template-columns: 180px 1fr;
      gap: 1.5rem;
