---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteNav from '../components/SiteNav.astro';

const title = 'Tether · Keep your Mac reachable';
const description = 'A macOS menu bar app that keeps your Mac awake and reachable while you control AI agents remotely.';
const downloadPath = '/downloads/Tether.zip';
---

<BaseLayout title={title} description={description} path="/tether">
  <style is:global>
    /* Hallmark · genre: modern-minimal · macrostructure: Workbench · theme: Pillexis · enrichment: system map · nav: N1b · footer: Ft2
     * audience: AI agent users who need remote control · use: understand then download · tone: technical, utilitarian
     * pre-emit critique: P5 H5 E5 S5 R5 V4
     */

    .tether-page {
      background: var(--bg);
      color: var(--text);
    }

    .tether-shell {
      width: min(var(--layout-max), calc(100% - 3rem));
      margin: 0 auto;
    }

    .tether-hero {
      min-height: 720px;
      padding: 8rem 0 5rem;
      display: grid;
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
      gap: clamp(3rem, 7vw, 6.5rem);
      align-items: center;
    }

    .tether-kicker {
      display: inline-flex;
      align-items: center;
      gap: 0.55rem;
      margin-bottom: 1.5rem;
      color: var(--text-muted);
      font-size: 0.84rem;
      font-weight: 500;
    }

    .tether-kicker img {
      width: 28px;
      height: 28px;
      border-radius: 7px;
    }

    .tether-hero h1 {
      max-width: 720px;
      margin: 0;
      font-size: clamp(3.25rem, 6.4vw, 6rem);
      line-height: 0.97;
      letter-spacing: -0.058em;
      overflow-wrap: anywhere;
    }

    .tether-hero h1 span {
      color: var(--red);
    }

    .tether-lede {
      max-width: 640px;
      margin: 1.75rem 0 0;
      color: var(--text-muted);
      font-size: clamp(1.08rem, 1.5vw, 1.24rem);
      line-height: 1.65;
    }

    .tether-meta {
      margin-top: 1.4rem;
      color: var(--text-dim);
      font-size: 0.82rem;
    }

    .tether-download {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 50px;
      margin-top: 2rem;
      padding: 0.78rem 1.15rem;
      border: 1px solid var(--red);
      border-radius: 8px;
      background: var(--red);
      color: var(--button-text);
      font-size: 0.94rem;
      font-weight: 600;
      white-space: nowrap;
      box-shadow: inset 0 1px 0 rgba(255,255,255,0.2), var(--glow-red-soft);
      transition: background 0.18s, transform 0.18s;
    }

    .tether-download:hover {
      background: var(--red-hot);
      transform: translateY(-1px);
    }
    .tether-download:active { transform: translateY(1px); }

    .tether-download:focus-visible,
    .tether-footer a:focus-visible {
      outline: 2px solid var(--red);
      outline-offset: 4px;
    }

    .tether-icon-hero {
      position: relative;
      min-height: 470px;
      display: grid;
      place-items: center;
    }

    .tether-icon-hero::before {
      content: '';
      position: absolute;
      width: 78%;
      aspect-ratio: 1;
      border-radius: 50%;
      background: var(--red-faint);
      filter: blur(36px);
    }

    .tether-icon-hero img {
      position: relative;
      z-index: 1;
      width: min(390px, 78%);
      height: auto;
      border-radius: 22.5%;
      box-shadow: 0 28px 75px rgba(27, 18, 21, 0.22);
    }

    .tether-section {
      padding: 5.5rem 0;
      border-top: 1px solid var(--hairline);
    }

    .section-intro {
      display: grid;
      grid-template-columns: minmax(0, 0.42fr) minmax(0, 0.58fr);
      gap: 3rem;
      margin-bottom: 3rem;
    }

    .section-label {
      color: var(--red);
      font-size: 0.78rem;
      font-weight: 600;
    }

    .section-intro h2 {
      max-width: 720px;
      margin: 0;
      font-size: clamp(2rem, 4.2vw, 3.65rem);
      line-height: 1.04;
      letter-spacing: -0.045em;
      overflow-wrap: anywhere;
    }

    .section-intro p {
      max-width: 650px;
      margin: 1.2rem 0 0;
      color: var(--text-muted);
      font-size: 1.02rem;
      line-height: 1.7;
    }

    .workflow {
      list-style: none;
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      border-top: 1px solid var(--hairline-strong);
      border-bottom: 1px solid var(--hairline-strong);
    }

    .workflow li {
      min-width: 0;
      padding: 2rem;
      border-right: 1px solid var(--hairline-strong);
    }

    .workflow li:last-child { border-right: 0; }

    .workflow-index {
      display: block;
      margin-bottom: 3rem;
      color: var(--text-dim);
      font-size: 0.75rem;
    }

    .workflow h3 {
      margin: 0;
      font-size: 1.18rem;
    }

    .workflow p {
      margin: 0.75rem 0 0;
      color: var(--text-muted);
      font-size: 0.92rem;
      line-height: 1.65;
    }

    .session-board {
      display: grid;
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      gap: 1px;
      overflow: hidden;
      border: 1px solid var(--hairline-strong);
      border-radius: 12px;
      background: var(--hairline-strong);
      box-shadow: var(--shadow-card);
    }

    .session-panel {
      min-width: 0;
      padding: clamp(1.5rem, 4vw, 3rem);
      background: var(--surface);
    }

    .session-panel h3 {
      margin: 0;
      font-size: clamp(1.55rem, 2.7vw, 2.25rem);
      letter-spacing: -0.03em;
    }

    .session-panel > p {
      margin: 0.9rem 0 0;
      color: var(--text-muted);
      line-height: 1.7;
    }

    .duration-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0.5rem;
      margin-top: 2rem;
    }

    .duration-grid span {
      padding: 0.7rem 0.45rem;
      border: 1px solid var(--hairline);
      border-radius: 7px;
      background: var(--surface-2);
      color: var(--text-muted);
      font-size: 0.76rem;
      text-align: center;
    }

    .duration-grid span:first-child {
      border-color: var(--red);
      color: var(--text);
    }

    .session-status {
      display: grid;
      align-content: space-between;
      min-height: 350px;
      background: var(--bg-elev);
    }

    .status-line {
      display: flex;
      align-items: center;
      gap: 0.55rem;
      color: var(--text-muted);
      font-size: 0.84rem;
    }

    .status-line::before {
      content: '';
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--red);
      box-shadow: 0 0 12px var(--red);
    }

    .status-time {
      margin: 2.5rem 0;
      font-size: clamp(3.2rem, 7vw, 6rem);
      font-variant-numeric: tabular-nums;
      line-height: 1;
      letter-spacing: -0.06em;
    }

    .status-foot {
      color: var(--text-dim);
      font-size: 0.78rem;
    }

    .spec-list {
      margin: 0;
      border-top: 1px solid var(--hairline-strong);
    }

    .spec-row {
      display: grid;
      grid-template-columns: minmax(150px, 0.35fr) minmax(0, 0.65fr);
      gap: 2rem;
      padding: 1.4rem 0;
      border-bottom: 1px solid var(--hairline-strong);
    }

    .spec-row dt {
      font-weight: 600;
    }

    .spec-row dd {
      margin: 0;
      color: var(--text-muted);
      line-height: 1.65;
    }

    .safety-note {
      margin-top: 2.5rem;
      padding: 1.4rem 1.5rem;
      border: 1px solid var(--hairline-strong);
      border-radius: 10px;
      background: var(--surface);
      color: var(--text-muted);
      line-height: 1.65;
    }

    .safety-note strong { color: var(--text); }

    .download-section {
      padding: 6rem 0;
      border-top: 1px solid var(--hairline);
      text-align: center;
    }

    .download-section h2 {
      max-width: 760px;
      margin: 0 auto;
      font-size: clamp(2.4rem, 5vw, 4.4rem);
      line-height: 1.02;
      letter-spacing: -0.05em;
    }

    .download-section p {
      max-width: 590px;
      margin: 1.25rem auto 0;
      color: var(--text-muted);
      line-height: 1.7;
    }

    .download-section .tether-download { margin-top: 2rem; }

    .tether-footer {
      padding: 2rem 0;
      border-top: 1px solid var(--hairline);
    }

    .tether-footer-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1.5rem;
      color: var(--text-muted);
      font-size: 0.78rem;
    }

    .tether-footer-links {
      display: flex;
      align-items: center;
      gap: 1.25rem;
    }

    .tether-footer a:hover { color: var(--text); }

    @media (max-width: 900px) {
      .tether-hero {
        min-height: 0;
        grid-template-columns: 1fr;
        padding-top: 7rem;
      }

      .tether-icon-hero { min-height: 390px; }
      .section-intro { grid-template-columns: 1fr; gap: 0.75rem; }
      .workflow { grid-template-columns: 1fr; }
      .workflow li {
        border-right: 0;
        border-bottom: 1px solid var(--hairline-strong);
      }
      .workflow li:last-child { border-bottom: 0; }
      .workflow-index { margin-bottom: 1.5rem; }
      .session-board { grid-template-columns: 1fr; }
      .session-status { min-height: 300px; }
    }

    @media (max-width: 640px) {
      .tether-shell { width: min(100% - 2.5rem, var(--layout-max)); }
      .tether-hero { padding: 6.25rem 0 3.5rem; gap: 2.5rem; }
      .tether-hero h1 { font-size: clamp(2.7rem, 13.5vw, 3.75rem); }
      .tether-download { width: 100%; }
      .tether-icon-hero { min-height: 290px; }
      .tether-icon-hero img { width: min(250px, 72%); }
      .tether-section { padding: 4rem 0; }
      .workflow li { padding: 1.5rem 0.25rem; }
      .session-panel { padding: 1.4rem; }
      .duration-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .spec-row { grid-template-columns: 1fr; gap: 0.4rem; }
      .download-section { padding: 4.5rem 0; }
      .tether-footer-inner {
        align-items: flex-start;
        flex-direction: column;
      }
      .tether-footer-links {
        align-items: flex-start;
        flex-direction: column;
        gap: 0.65rem;
      }
    }
  </style>

  <style is:global>
    /* Hallmark · genre: modern-minimal · macrostructure: Product story · theme: Pillexis light
     * enrichment: supplied product media · nav: shared N1b · footer: Ft2
     * pre-emit critique: P5 H5 E5 S5 R5 V5
     */
    .tether-page { background: var(--bg); color: var(--text); }
    .tether-page img { display: block; max-width: 100%; }
    .tether-page h1,
    .tether-page h2,
    .tether-page h3 { overflow-wrap: anywhere; min-width: 0; }
    .tether-shell { width: min(var(--layout-max), calc(100% - 3rem)); margin-inline: auto; }

    .tether-story-hero { padding-block: 8.5rem 4.5rem; }
    .tether-story-hero__head {
      display: grid;
      grid-template-columns: minmax(0, 1.2fr) minmax(300px, 0.55fr);
      gap: clamp(2rem, 6vw, 6rem);
      align-items: end;
      margin-block-end: 3rem;
    }
    .tether-product-label {
      display: inline-flex;
      align-items: center;
      gap: 0.65rem;
      margin-block-end: 1.5rem;
      color: var(--text-muted);
      font-size: 0.86rem;
      font-weight: 600;
    }
    .tether-product-label img { width: 30px; height: 30px; border-radius: 8px; }
    .tether-story-hero h1 {
      max-width: 850px;
      margin: 0;
      font-size: clamp(3.2rem, 7vw, 6.5rem);
      line-height: 0.95;
      letter-spacing: -0.06em;
    }
    .tether-story-hero h1 span { color: var(--red); }

    .tether-page .heading-primary,
    .tether-page .heading-secondary {
      display: block;
    }

    .tether-page .heading-primary {
      color: var(--text);
      font-size: 1em;
      line-height: 0.98;
    }

    .tether-page .heading-secondary {
      max-width: 18ch;
      margin-top: 0.22em;
      color: var(--text-muted);
      font-size: 0.58em;
      line-height: 1.08;
      letter-spacing: -0.035em;
    }

    .tether-page .heading-secondary--accent {
      color: var(--red);
    }

    .tether-capabilities .heading-secondary {
      font-size: 0.54em;
    }

    .tether-final .heading-secondary {
      max-width: none;
      margin-inline: auto;
      font-size: 0.6em;
    }
    .tether-story-hero__copy { padding-block-end: 0.4rem; }
    .tether-story-hero__copy p {
      max-width: 58ch;
      margin: 0;
      color: var(--text-muted);
      font-size: 1.08rem;
      line-height: 1.65;
    }
    .tether-story-hero__actions {
      display: flex;
      align-items: flex-start;
      gap: 1.5rem;
      margin-block-start: 1.75rem;
      flex-wrap: wrap;
    }
    .tether-story-hero__download {
      display: flex;
      align-items: flex-start;
      flex-direction: column;
      gap: 0.65rem;
    }
    .tether-story-hero__download .tether-meta {
      margin: 0;
    }
    .tether-story-hero__download .tether-download {
      margin-block-start: 0;
    }
    .tether-download,
    .tether-text-link {
      white-space: nowrap;
    }
    .tether-text-link {
      margin-block-start: 0.9rem;
      color: var(--text-muted);
      font-size: 0.9rem;
      font-weight: 600;
    }
    .tether-text-link:hover { color: var(--text); }
    .tether-text-link:focus-visible { outline: 2px solid var(--red); outline-offset: 4px; }
    .tether-text-link:active { color: var(--red-hot); }
    .tether-story-hero__media {
      overflow: clip;
      border: 1px solid var(--hairline-strong);
      border-radius: var(--r-lg);
      background: var(--surface);
      box-shadow: var(--shadow-card);
    }
    .tether-story-hero__media img { width: 100%; height: 100%; }
    .tether-proofline {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      border-block: 1px solid var(--hairline-strong);
    }
    .tether-proofline div {
      min-width: 0;
      padding: 1.3rem 1.5rem;
      border-inline-end: 1px solid var(--hairline-strong);
    }
    .tether-proofline div:last-child { border-inline-end: 0; }
    .tether-proofline strong { display: block; font-size: 0.9rem; }
    .tether-proofline span { display: block; margin-block-start: 0.25rem; color: var(--text-dim); font-size: 0.78rem; }

    .tether-story { padding-block: 7rem; border-block-start: 1px solid var(--hairline); }
    .tether-story__grid {
      display: grid;
      grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
      gap: clamp(3rem, 8vw, 7rem);
      align-items: center;
    }
    .tether-story:nth-of-type(even) .tether-story__media { order: 2; }
    .tether-story__media {
      justify-self: center;
      width: min(100%, 520px);
      overflow: clip;
      border: 1px solid var(--hairline-strong);
      border-radius: var(--r-lg);
      background: var(--surface);
      box-shadow: var(--shadow-card);
    }
    .tether-story__media img { width: 100%; height: 100%; }
    .tether-story__index {
      display: block;
      margin-block-end: 1.25rem;
      color: var(--red);
      font-size: 0.78rem;
      font-weight: 700;
    }
    .tether-story h2 {
      max-width: 720px;
      margin: 0;
      font-size: clamp(2.4rem, 5vw, 4.8rem);
      line-height: 0.98;
      letter-spacing: -0.055em;
    }
    .tether-story__lede {
      max-width: 62ch;
      margin: 1.5rem 0 0;
      color: var(--text-muted);
      font-size: 1.05rem;
      line-height: 1.7;
    }
    .tether-story__points {
      list-style: none;
      margin: 2rem 0 0;
      padding: 0;
      border-block-start: 1px solid var(--hairline-strong);
    }
    .tether-story__points li {
      display: grid;
      grid-template-columns: 28px minmax(0, 1fr);
      gap: 0.75rem;
      padding-block: 0.9rem;
      border-block-end: 1px solid var(--hairline);
      color: var(--text-muted);
      line-height: 1.5;
    }
    .tether-story__points span { color: var(--red); font-size: 0.75rem; font-weight: 700; }

    .tether-capabilities { padding-block: 7rem; border-block-start: 1px solid var(--hairline); background: var(--bg-elev); }
    .tether-capabilities__head {
      max-width: 850px;
      margin-block-end: 3.5rem;
    }
    .tether-capabilities__head h2 {
      margin: 0;
      font-size: clamp(2.6rem, 5.8vw, 5.4rem);
      line-height: 0.96;
      letter-spacing: -0.06em;
    }
    .tether-capabilities__head p {
      max-width: 62ch;
      margin: 1.4rem 0 0;
      color: var(--text-muted);
      line-height: 1.7;
    }
    .tether-capabilities__layout {
      display: grid;
      grid-template-columns: minmax(280px, 0.72fr) minmax(0, 1.28fr);
      gap: clamp(2rem, 5vw, 5rem);
      align-items: start;
    }
    .tether-capabilities__media {
      overflow: clip;
      border: 1px solid var(--hairline-strong);
      border-radius: var(--r-lg);
      background: var(--surface);
      box-shadow: var(--shadow-card);
    }
    .tether-capabilities__media img { width: 100%; height: 100%; }
    .tether-capabilities__groups { border-block-start: 1px solid var(--hairline-strong); }
    .capability-group {
      display: grid;
      grid-template-columns: 130px minmax(0, 1fr);
      gap: 1.5rem;
      padding-block: 1.5rem;
      border-block-end: 1px solid var(--hairline-strong);
    }
    .capability-group h3 { margin: 0; font-size: 0.9rem; }
    .capability-group ul {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.75rem 1.5rem;
      margin: 0;
      padding: 0;
      list-style: none;
    }
    .capability-group li { color: var(--text-muted); font-size: 0.88rem; line-height: 1.5; }

    .tether-final { padding-block: 7rem; text-align: center; border-block-start: 1px solid var(--hairline); }
    .tether-final h2 {
      max-width: 780px;
      margin-inline: auto;
      font-size: clamp(2.6rem, 5.6vw, 5rem);
      line-height: 0.98;
      letter-spacing: -0.055em;
    }
    .tether-final p { max-width: 58ch; margin: 1.25rem auto 0; color: var(--text-muted); line-height: 1.65; }
    .tether-final .tether-download { margin-block-start: 2rem; }
    .tether-footer { padding-block: 2rem; border-block-start: 1px solid var(--hairline); }
    .tether-footer-inner { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; }
    .tether-footer-links { display: flex; align-items: center; gap: 1.25rem; }

    @media (max-width: 900px) {
      .tether-story-hero__head,
      .tether-story__grid,
      .tether-capabilities__layout { grid-template-columns: minmax(0, 1fr); }
      .tether-story:nth-of-type(even) .tether-story__media { order: 0; }
      .tether-story__media { justify-self: start; width: min(100%, 560px); }
      .tether-proofline { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .tether-proofline div:nth-child(2) { border-inline-end: 0; }
      .tether-proofline div:nth-child(-n+2) { border-block-end: 1px solid var(--hairline-strong); }
      .tether-capabilities__media { width: min(100%, 520px); }
    }
    @media (max-width: 640px) {
      .tether-shell { width: min(var(--layout-max), calc(100% - 2.5rem)); }
      .tether-story-hero { padding-block: 6.5rem 3.5rem; }
      .tether-story-hero__head { margin-block-end: 2rem; }
      .tether-story-hero h1 { font-size: clamp(2.8rem, 14vw, 4rem); }
      .tether-story-hero__actions { align-items: stretch; flex-direction: column; }
      .tether-story-hero__download { width: 100%; }
      .tether-download { width: 100%; }
      .tether-text-link { align-self: flex-start; margin-block-start: 0; }
      .tether-proofline { grid-template-columns: minmax(0, 1fr); }
      .tether-proofline div,
      .tether-proofline div:nth-child(2) { border-inline-end: 0; border-block-end: 1px solid var(--hairline-strong); }
      .tether-proofline div:last-child { border-block-end: 0; }
      .tether-story,
      .tether-capabilities,
      .tether-final { padding-block: 4.5rem; }
      .capability-group { grid-template-columns: minmax(0, 1fr); gap: 0.85rem; }
      .capability-group ul { grid-template-columns: minmax(0, 1fr); }
      .tether-footer-inner,
      .tether-footer-links { align-items: flex-start; flex-direction: column; }
    }
    @media (prefers-reduced-motion: reduce) {
      .tether-download { transition: none; }
      .tether-download:hover,
      .tether-download:active { transform: none; }
    }
  </style>

  <style is:global>
    /* Tether correction · definite hero + cropped product UI + varied feature rhythm */
    .tether-story-hero {
      min-height: 720px;
      padding-block: 7.5rem 5.5rem;
      display: grid;
      grid-template-columns: minmax(0, 1.02fr) minmax(420px, 0.98fr);
      gap: clamp(3rem, 7vw, 6.5rem);
      align-items: center;
    }
    .tether-story-hero__copy { padding: 0; }
    .tether-story-hero__copy > p:first-of-type {
      max-width: 58ch;
      margin-block-start: 1.5rem;
    }
    .tether-story-hero h1 {
      max-width: 700px;
      font-size: clamp(3.35rem, 5.8vw, 5.7rem);
    }
    .tether-story-hero__media {
      position: relative;
      height: 560px;
      margin: 0;
    }
    .tether-story-hero__media img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: right center;
      transform: scale(1.22);
      transform-origin: right center;
    }
    .tether-proofline { margin-block-end: 0; }

    .tether-story { padding-block: 6.5rem; }
    .tether-story__grid {
      gap: clamp(2.5rem, 6vw, 6rem);
    }
    .tether-story__media {
      width: 100%;
      max-width: none;
      aspect-ratio: 4 / 3;
      margin: 0;
    }
    .tether-story__media img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center 82%;
      transform: scale(1.28);
      transform-origin: center 78%;
    }
    .tether-story--session .tether-story__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .tether-story--session .tether-story__media { order: 2; }
    .tether-story--trigger {
      background: var(--bg-elev);
    }
    .tether-story--trigger .tether-story__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .tether-story--trigger .tether-story__media {
      aspect-ratio: 5 / 4;
    }
    .tether-story--closed .tether-story__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .tether-story--closed .tether-story__media {
      order: 2;
      aspect-ratio: 4 / 3;
    }
    .tether-story--closed .tether-story__media img {
      object-position: center bottom;
      transform: scale(1.2);
      transform-origin: center bottom;
    }
    .tether-story h2 {
      max-width: 680px;
      font-size: clamp(2.25rem, 3.6vw, 3.8rem);
    }
    .tether-story .heading-primary {
      white-space: nowrap;
    }

    .tether-capabilities {
      background: var(--surface);
    }
    .tether-capabilities__layout {
      grid-template-columns: minmax(320px, 0.85fr) minmax(0, 1.15fr);
    }
    .tether-capabilities__media {
      aspect-ratio: 4 / 5;
    }
    .tether-capabilities__media img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center 57%;
      transform: scale(1.18);
      transform-origin: center 57%;
    }
    .capability-group {
      grid-template-columns: minmax(0, 1fr);
      gap: 1rem;
      padding-block: 1.75rem;
    }
    .capability-group h3 {
      color: var(--red);
      font-size: 0.78rem;
    }
    .capability-group ul {
      gap: 0.65rem 2rem;
    }

    @media (max-width: 900px) {
      .tether-story-hero {
        min-height: 0;
        grid-template-columns: minmax(0, 1fr);
        padding-block: 7rem 4rem;
      }
      .tether-story-hero__media {
        width: min(100%, 620px);
        height: auto;
        aspect-ratio: 5 / 4;
      }
      .tether-story--session .tether-story__grid,
      .tether-story--trigger .tether-story__grid,
      .tether-story--closed .tether-story__grid,
      .tether-capabilities__layout {
        grid-template-columns: minmax(0, 1fr);
      }
      .tether-story--session .tether-story__media,
      .tether-story--closed .tether-story__media {
        order: 0;
      }
      .tether-story .heading-primary {
        white-space: normal;
      }
    }
    @media (max-width: 640px) {
      .tether-story-hero {
        padding-block: 6.25rem 3.5rem;
        gap: 2.5rem;
      }
      .tether-story-hero h1 {
        font-size: clamp(2.75rem, 13vw, 3.8rem);
      }
      .tether-story-hero__media {
        aspect-ratio: 4 / 3;
      }
      .tether-story-hero__media img {
        transform: scale(1.75);
        transform-origin: right center;
      }
      .tether-story {
        padding-block: 4.25rem;
      }
      .tether-story__media,
      .tether-story--trigger .tether-story__media,
      .tether-story--closed .tether-story__media {
        aspect-ratio: 1 / 1;
      }
      .tether-capabilities__media {
        aspect-ratio: 4 / 5;
      }
    }
  </style>

  <div class="tether-page">
    <script is:inline>
      document.documentElement.dataset.theme = 'light';
      document.documentElement.style.colorScheme = 'light';
      document.querySelector('[data-theme-color]')?.setAttribute('content', '#f5f1ee');
    </script>
    <SiteNav links={[
      { href: '/ai-labs#about', label: 'About' },
      { href: '/#services', label: 'Services' },
      { href: '/ai-labs', label: 'AI labs' }
    ]} />

    <main>
      <section class="tether-story-hero tether-shell">
        <div class="tether-story-hero__copy">
          <div class="tether-product-label">
            <img src="/products/tether-icon.png" alt="" width="30" height="30" />
            <span>Tether for macOS</span>
          </div>
          <h1>
            <span class="heading-primary">Keep your Mac awake.</span>
            <span class="heading-secondary heading-secondary--accent">Stay reachable.</span>
          </h1>
          <p>A lightweight menu bar utility for remote work, long running tasks, and the moments when macOS sleep would interrupt both.</p>
          <div class="tether-story-hero__actions">
            <div class="tether-story-hero__download">
              <a class="tether-download" href={downloadPath} download>Download for macOS</a>
              <p class="tether-meta">Version 1.0 · macOS 13 or later · Apple silicon and Intel</p>
            </div>
            <a class="tether-text-link" href="#features">See every feature</a>
          </div>
        </div>

        <figure class="tether-story-hero__media">
          <img src="/products/tether/hero.webp" alt="Tether menu bar controls beside the Tether app icon" width="2752" height="1536" fetchpriority="high" />
        </figure>
      </section>

      <div class="tether-shell tether-proofline" aria-label="Tether highlights">
        <div><strong>Menu bar utility</strong><span>Ready without another window</span></div>
        <div><strong>Timed or indefinite</strong><span>Choose when the session ends</span></div>
        <div><strong>Battery protection</strong><span>Stop at a chosen threshold</span></div>
        <div><strong>Closed display</strong><span>Explicit and reversible</span></div>
      </div>

      <section class="tether-story tether-story--session">
        <div class="tether-shell tether-story__grid">
          <figure class="tether-story__media">
            <img src="/products/tether/active-session.webp" alt="Tether showing an active indefinite keep awake session" width="1856" height="2304" />
          </figure>
          <div>
            <span class="tether-story__index">01 · Sessions</span>
            <h2>
              <span class="heading-primary">Start a session.</span>
              <span class="heading-secondary">See it. End it immediately.</span>
            </h2>
            <p class="tether-story__lede">Tether uses a native macOS power assertion and keeps the current session state visible in the menu bar.</p>
            <ul class="tether-story__points">
              <li><span>01</span>Run indefinitely, for 30 minutes, 1 hour, 2 hours, or 4 hours.</li>
              <li><span>02</span>Choose an exact end time with Start until.</li>
              <li><span>03</span>See the remaining time live and end any session immediately.</li>
            </ul>
          </div>
        </div>
      </section>

      <section class="tether-story tether-story--trigger">
        <div class="tether-shell tether-story__grid">
          <figure class="tether-story__media">
            <img src="/products/tether/app-triggers.webp" alt="Tether app trigger menu listing running macOS applications" width="1856" height="2304" />
          </figure>
          <div>
            <span class="tether-story__index">02 · App triggers</span>
            <h2>
              <span class="heading-primary">Let the work decide.</span>
              <span class="heading-secondary">The Mac stays awake.</span>
            </h2>
            <p class="tether-story__lede">Choose a running app and Tether follows it. The keep awake session begins while that app runs, then stops when it closes.</p>
            <ul class="tether-story__points">
              <li><span>01</span>Select from the apps currently running on your Mac.</li>
              <li><span>02</span>Refresh the available app list on demand.</li>
              <li><span>03</span>Launch Tether automatically when you sign in.</li>
            </ul>
          </div>
        </div>
      </section>

      <section class="tether-story tether-story--closed">
        <div class="tether-shell tether-story__grid">
          <figure class="tether-story__media">
            <img src="/products/tether/closed-display.webp" alt="Tether Closed Display Mode safety confirmation" width="1856" height="2304" />
          </figure>
          <div>
            <span class="tether-story__index">03 · Closed Display Mode</span>
            <h2>
              <span class="heading-primary">Remote access.</span>
              <span class="heading-secondary">With an explicit safety boundary.</span>
            </h2>
            <p class="tether-story__lede">Closed Display Mode is available only during an active session. Tether confirms the change, uses a signed privileged helper, and restores the previous lid sleep setting when the session ends.</p>
            <ul class="tether-story__points">
              <li><span>01</span>See a safety confirmation before anything changes.</li>
              <li><span>02</span>Renew the safety lease while the session remains active.</li>
              <li><span>03</span>Return macOS to its previous lid sleep behavior automatically.</li>
            </ul>
          </div>
        </div>
      </section>

      <section class="tether-capabilities" id="features">
        <div class="tether-shell">
          <div class="tether-capabilities__head">
            <span class="tether-story__index">Complete feature set</span>
            <h2>
              <span class="heading-primary">Everything Tether</span>
              <span class="heading-secondary heading-secondary--accent">controls.</span>
            </h2>
            <p>One menu bar utility, organized around sessions, safeguards, automation, and closed display behavior.</p>
          </div>
          <div class="tether-capabilities__layout">
            <figure class="tether-capabilities__media">
              <img src="/products/tether/feature-overview.webp" alt="Overview of the Tether menu bar utility and its core controls" width="1856" height="2304" />
            </figure>
            <div class="tether-capabilities__groups">
              <section class="capability-group">
                <h3>Sessions</h3>
                <ul>
                  <li>Lightweight macOS menu bar utility</li>
                  <li>Native macOS power assertion</li>
                  <li>Five preset session durations</li>
                  <li>Custom end time with Start until</li>
                  <li>Live remaining time</li>
                  <li>Immediate End session control</li>
                </ul>
              </section>
              <section class="capability-group">
                <h3>Safeguards</h3>
                <ul>
                  <li>Optional display keep awake</li>
                  <li>Automatic low battery stop</li>
                  <li>Battery limits from 5 to 50 percent</li>
                  <li>Ready, active, finished, battery, and error states</li>
                </ul>
              </section>
              <section class="capability-group">
                <h3>Automation</h3>
                <ul>
                  <li>Launch automatically at sign in</li>
                  <li>Start while a selected app runs</li>
                  <li>Stop when the selected app closes</li>
                  <li>Refresh the running app list on demand</li>
                </ul>
              </section>
              <section class="capability-group">
                <h3>Closed display</h3>
                <ul>
                  <li>Available during an active session</li>
                  <li>Safety confirmation before enabling</li>
                  <li>Signed privileged helper</li>
                  <li>Previous lid sleep setting restored</li>
                  <li>Safety lease renewed while active</li>
                  <li>Unavailable until a session starts</li>
                </ul>
              </section>
            </div>
          </div>
        </div>
      </section>

      <section class="tether-final">
        <div class="tether-shell">
          <h2>
            <span class="heading-primary">Keep the Mac available.</span>
            <span class="heading-secondary">When the work cannot pause.</span>
          </h2>
          <p>Tether is a signed and Apple notarized universal macOS app for Apple silicon and Intel Macs.</p>
          <a class="tether-download" href={downloadPath} download>Download for macOS</a>
          <p class="tether-meta">Free · Version 1.0 · Requires macOS 13 or later</p>
        </div>
      </section>
    </main>

    <footer class="tether-footer">
      <div class="tether-shell tether-footer-inner">
        <div>
          <strong>Pillexis Labs</strong>
          <span> · &copy; 2026 Pillexis Labs Pvt Ltd</span>
        </div>
        <div class="tether-footer-links">
          <a href="/ai-labs">AI labs</a>
          <a href="mailto:contact@pillexislabs.com">Contact</a>
        </div>
      </div>
    </footer>
  </div>
</BaseLayout>
