---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "Lost the trail · Pillexis Labs";
const description = "Page not found. The thing you're looking for moved, broke, or never shipped. Here's how to get back on track.";
---

<BaseLayout title={title} description={description} path="/404" noindex={true}>
  <main class="lost">
    <div class="lost-bg" aria-hidden="true"></div>
    <div class="lost-grid" aria-hidden="true"></div>

    <div class="lost-inner">
      <a href="/" class="back-link">
        <svg width="12" height="12" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 12H5M12 19l-7-7 7-7" />
        </svg>
        Pillexis Labs
      </a>

      <span class="lost-eyebrow">
        <span class="lost-dot"></span>
        404 · Lost the trail
      </span>

      <h1 class="lost-title">
        That page <em>doesn't ship.</em>
      </h1>

      <p class="lost-sub">
        Either the URL moved, the experiment got pulled, or it never made it out
        of research. Either way, here's where the actually-live stuff lives.
      </p>

      <div class="lost-cta-row">
        <a href="/" class="btn-primary">
          Back to home
          <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
        <a href="/tools" class="btn-ghost">
          Take the free assessment instead →
        </a>
      </div>

      <ul class="lost-routes">
        <li>
          <a href="/" class="route-card">
            <span class="route-label">/</span>
            <span class="route-name">Studio &amp; products</span>
          </a>
        </li>
        <li>
          <a href="/tools" class="route-card">
            <span class="route-label">/tools</span>
            <span class="route-name">Free assessments</span>
          </a>
        </li>
        <li>
          <a href="/tools/ai-build-readiness" class="route-card">
            <span class="route-label">/tools/ai-build-readiness</span>
            <span class="route-name">AI Build Readiness Score</span>
          </a>
        </li>
        <li>
          <a href="/" class="route-card">
            <span class="route-label">/</span>
            <span class="route-name">Fixed scope engagements</span>
          </a>
        </li>
      </ul>
    </div>
  </main>

  <style>
    .lost {
      position: relative;
      padding: 6.5rem 1.5rem 4.5rem;
      overflow: hidden;
    }
    .lost-bg {
      position: absolute;
      inset: 0;
      pointer-events: none;
      background:
        radial-gradient(ellipse 65% 60% at 20% 10%, rgba(255, 99, 99, 0.2), transparent 60%),
        radial-gradient(ellipse 90% 60% at 90% 100%, rgba(255, 140, 80, 0.10), transparent 70%);
    }
    .lost-grid {
      position: absolute;
      inset: 0;
      pointer-events: none;
      opacity: 0.5;
      background-image: radial-gradient(rgba(255, 255, 255, 0.05) 1px, transparent 1px);
      background-size: 24px 24px;
      -webkit-mask-image: radial-gradient(ellipse at center, #000 30%, transparent 80%);
              mask-image: radial-gradient(ellipse at center, #000 30%, transparent 80%);
    }
    .lost-inner {
      position: relative;
      max-width: 720px;
      margin: 0 auto;
    }
    .back-link {
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      font-family: var(--mono);
      font-size: 0.72rem;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--text-muted);
      margin-bottom: 3rem;
      transition: color 0.2s, gap 0.2s;
    }
    .back-link:hover { color: var(--red); gap: 0.6rem; }

    .lost-eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 0.55rem;
      font-family: var(--mono);
      font-size: 0.72rem;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--red);
      padding: 0.45rem 0.9rem;
      background: rgba(255, 99, 99, 0.08);
      border: 1px solid rgba(255, 99, 99, 0.22);
      border-radius: 7px;
      margin-bottom: 2rem;
    }
    .lost-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--red);
      box-shadow: 0 0 10px var(--red);
    }

    .lost-title {
      font-family: var(--sans);
      font-weight: 800;
      font-size: clamp(2.6rem, 7vw, 5rem);
      letter-spacing: -0.05em;
      line-height: 1.02;
      color: var(--text);
      margin-bottom: 1.5rem;
    }
    .lost-title em {
      font-style: italic;
      background: linear-gradient(180deg, var(--peach) 0%, var(--red) 100%);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
      filter: drop-shadow(0 0 30px rgba(255, 99, 99, 0.35));
    }

    .lost-sub {
      font-size: 1.1rem;
      color: var(--text-muted);
      line-height: 1.6;
      max-width: 580px;
      margin-bottom: 2.5rem;
    }

    .lost-cta-row {
      display: flex;
      gap: 0.75rem;
      align-items: center;
      flex-wrap: wrap;
      margin-bottom: 4rem;
      padding-bottom: 3rem;
      border-bottom: 1px solid var(--hairline);
    }

    .btn-primary {
      display: inline-flex;
      align-items: center;
      gap: 0.55rem;
      padding: 0.9rem 1.5rem;
      border-radius: 10px;
      background: var(--red);
      color: #fff;
      font-family: var(--sans);
      font-weight: 500;
      font-size: 0.95rem;
      border: 1px solid rgba(255, 255, 255, 0.12);
      box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.25),
        0 1px 2px rgba(0, 0, 0, 0.4),
        0 0 30px rgba(255, 99, 99, 0.35);
      transition: transform 0.15s, background 0.2s, box-shadow 0.2s;
    }
    .btn-primary:hover {
      background: var(--red-hot);
      color: #fff;
      transform: translateY(-1px);
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.3), 0 0 50px rgba(255, 99, 99, 0.5);
    }
    .btn-ghost {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      color: var(--text-muted);
      font-family: var(--sans);
      font-size: 0.9rem;
      font-weight: 500;
      padding: 0.9rem 0.4rem;
      transition: color 0.2s, gap 0.2s;
    }
    .btn-ghost:hover { color: var(--text); gap: 0.6rem; }

    .lost-routes {
      list-style: none;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.75rem;
    }
    .route-card {
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
      padding: 1rem 1.2rem;
      background: var(--surface);
      border: 1px solid var(--hairline);
      border-radius: var(--r-lg);
      transition: border-color 0.18s, transform 0.18s, box-shadow 0.18s;
    }
    .route-card:hover {
      border-color: var(--red);
      transform: translateY(-2px);
      box-shadow: var(--glow-red-soft);
    }
    .route-label {
      font-family: var(--mono);
      font-size: 0.72rem;
      letter-spacing: 0.08em;
      color: var(--red);
    }
    .route-name {
      font-family: var(--sans);
      font-size: 0.95rem;
      color: var(--text);
      font-weight: 500;
    }

    @media (max-width: 600px) {
      .lost { padding: 5.5rem 1.25rem 3.5rem; }
      .lost-routes { grid-template-columns: 1fr; }
      .lost-cta-row { flex-direction: column; align-items: stretch; }
      .lost-cta-row .btn-primary { justify-content: center; }
      .lost-cta-row .btn-ghost {
        justify-content: center;
        padding: 0.85rem;
        border: 1px solid var(--hairline);
        border-radius: 10px;
      }
    }
  </style>
</BaseLayout>
