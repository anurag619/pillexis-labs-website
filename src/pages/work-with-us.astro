---
import BaseLayout from '../layouts/BaseLayout.astro';
import BookingScripts from '../components/BookingScripts.astro';
import SiteNav from '../components/SiteNav.astro';
import ThemeToggle from '../components/ThemeToggle.astro';

const title = "Work with us · Pillexis Labs";
const description = "Two sprints. One operator. We sort the AI mess and the ops mess for Indian D2C teams who've outgrown their stack.";

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Pillexis Labs · Sprint engagements',
  description,
  url: 'https://pillexislabs.com/',
  provider: {
    '@type': 'Organization',
    name: 'Pillexis Labs',
    url: 'https://pillexislabs.com',
  },
  serviceType: 'AI & Operations consulting sprints',
  areaServed: { '@type': 'Country', name: 'India' },
  potentialAction: {
    '@type': 'ReserveAction',
    target: 'https://cal.com/pillexislabs/pillexis-labs-intro-call',
    result: { '@type': 'Reservation', name: '20-minute intro call' },
  },
};
---

<BaseLayout title={title} description={description} path="/" jsonLd={jsonLd}>
  <style is:global>

    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

    html { scroll-behavior: smooth; background: var(--bg); }
    body {
      font-family: var(--sans);
      background: var(--bg);
      color: var(--text);
      line-height: 1.6;
      letter-spacing: -0.011em;
      -webkit-font-smoothing: antialiased;
      overflow-x: hidden;
    }
    ::selection { background: var(--red-dim); color: #fff; }

    a { color: var(--text); text-decoration: none; }

    /* ── NAV ── */
    nav {
      position: fixed; top: 0; left: 0; right: 0; z-index: 100;
      padding: 0.7rem 1.5rem;
      background: rgba(10, 10, 10, 0.6);
      backdrop-filter: blur(18px) saturate(180%);
      -webkit-backdrop-filter: blur(18px) saturate(180%);
      border-bottom: 1px solid var(--hairline);
    }
    .nav-inner {
      max-width: 1200px; margin: 0 auto;
      display: flex; align-items: center; justify-content: space-between;
    }
    .logo {
      display: inline-flex; align-items: center; gap: 0.55rem;
      font-size: 0.98rem; font-weight: 600; color: var(--text);
      letter-spacing: -0.01em;
    }
    .logo-dot {
      width: 10px; height: 10px; border-radius: 2px;
      background: var(--red);
      box-shadow: 0 0 12px rgba(255, 99, 99, 0.4);
    }
    .nav-links { display: flex; gap: 1.75rem; list-style: none; }
    .nav-links a {
      color: var(--text-muted); font-size: 0.85rem; font-weight: 500;
      transition: color 0.2s;
    }
    .nav-links a:hover { color: var(--text); }
    .nav-cta {
      background: var(--red);
      color: #fff !important;
      padding: 0.45rem 0.9rem;
      border-radius: 8px;
      font-size: 0.82rem; font-weight: 500;
      border: 1px solid rgba(255, 255, 255, 0.12);
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.2), var(--glow-red-soft);
      transition: background 0.2s;
    }
    .nav-cta:hover { background: var(--red-hot); }

    /* ── BUTTONS ── */
    .btn-primary {
      display: inline-flex; align-items: center; gap: 0.5rem;
      padding: 0.95rem 1.6rem;
      border-radius: 10px;
      background: var(--red);
      color: #fff;
      font-weight: 500; font-size: 0.98rem;
      border: 1px solid rgba(255, 255, 255, 0.12);
      box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.25),
        0 1px 2px rgba(0, 0, 0, 0.4),
        0 0 30px rgba(255, 99, 99, 0.35);
      transition: transform 0.15s, box-shadow 0.2s, background 0.2s;
    }
    .btn-primary:hover {
      background: var(--red-hot); color: #fff;
      transform: translateY(-1px);
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.3), 0 0 50px rgba(255, 99, 99, 0.5);
    }
    .btn-secondary {
      display: inline-flex; align-items: center; gap: 0.5rem;
      padding: 0.95rem 1.6rem;
      border-radius: 10px;
      background: var(--surface);
      color: var(--text);
      border: 1px solid var(--hairline);
      font-weight: 500; font-size: 0.98rem;
      transition: background 0.2s, border-color 0.2s;
    }
    .btn-secondary:hover { background: var(--surface-2); border-color: var(--hairline-strong); }

    /* ── SECTION ── */
    section { padding: 5rem 2rem; }
    .container { max-width: 1100px; margin: 0 auto; }
    .eyebrow {
      font-family: var(--mono);
      font-size: 0.72rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--text-dim);
      font-weight: 500;
      margin-bottom: 1.2rem;
    }
    .section-title {
      font-weight: 800;
      font-size: clamp(2.2rem, 4.5vw, 3.6rem);
      letter-spacing: -0.04em;
      line-height: 1.05;
      margin-bottom: 1.2rem;
    }
    .section-title em {
      font-style: normal;
      background: linear-gradient(180deg, var(--peach) 0%, var(--red) 100%);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }
    .section-sub {
      font-size: 1.1rem;
      color: var(--text-muted);
      max-width: 640px;
      line-height: 1.6;
      margin-bottom: 2rem;
    }

    /* ── HERO ── */
    .hero {
      padding: 8rem 2rem 4.5rem;
      position: relative;
      overflow: hidden;
    }
    .hero::before {
      content: '';
      position: absolute;
      inset: 0;
      pointer-events: none;
      background:
        radial-gradient(circle at top right, rgba(255, 99, 99, 0.35), transparent 60%),
        radial-gradient(circle at 30% 80%, rgba(255, 140, 80, 0.12), transparent 55%);
    }
    .grid-bg {
      position: absolute; inset: 0; pointer-events: none; opacity: 0.4;
      background-image: radial-gradient(var(--hairline) 1px, transparent 1px);
      background-size: 24px 24px;
      mask-image: linear-gradient(180deg, #000 0%, transparent 70%);
    }
    .hero-inner { position: relative; max-width: 1100px; margin: 0 auto; }

    .hero h1 {
      font-weight: 900;
      font-size: clamp(2.6rem, 6vw, 4.8rem);
      letter-spacing: -0.04em;
      line-height: 1.02;
      margin-bottom: 1.8rem;
      max-width: 760px;
    }
    .hero h1 em {
      font-style: italic;
      background: linear-gradient(180deg, var(--peach) 0%, var(--red) 100%);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
      filter: drop-shadow(0 0 40px rgba(255, 99, 99, 0.45));
    }
    .hero-sub {
      font-size: 1.2rem;
      color: var(--text-muted);
      max-width: 540px;
      line-height: 1.55;
      margin-bottom: 2.5rem;
    }
    .hero-cta-row { display: flex; gap: 0.85rem; flex-wrap: wrap; }

    .hero-receipts {
      margin-top: 4.5rem;
      display: flex;
      gap: 1.5rem;
      flex-wrap: wrap;
      padding-top: 2rem;
      border-top: 1px solid var(--hairline);
    }
    .hero-receipt {
      flex: 1; min-width: 200px;
    }
    .hero-receipt .num {
      font-weight: 800;
      font-size: 2.4rem;
      letter-spacing: -0.03em;
      line-height: 1;
      background: linear-gradient(180deg, var(--text) 0%, var(--red) 130%);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }
    .hero-receipt .label {
      font-family: var(--mono);
      font-size: 0.72rem;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--text-dim);
      margin-top: 0.6rem;
    }

    /* ── RECEIPTS / CASE STUDY ── */
    .receipts { background: var(--bg); }
    .receipts-card {
      background: var(--surface);
      border: 1px solid var(--hairline);
      border-radius: var(--r-xl);
      padding: 3rem;
      position: relative;
      overflow: hidden;
      box-shadow: var(--shadow-card);
    }
    /* Subtle brand-mark divider between case studies */
    .case-divider {
      display: flex;
      align-items: center;
      gap: 0.9rem;
      max-width: 220px;
      margin: 3rem auto;
    }
    .case-divider-line {
      flex: 1;
      height: 1px;
      background: linear-gradient(90deg, transparent, var(--hairline-strong), transparent);
    }
    .case-divider-mark {
      width: 8px;
      height: 8px;
      border-radius: 2px;
      background: var(--red);
      box-shadow: 0 0 10px rgba(255, 99, 99, 0.55);
      flex-shrink: 0;
    }
    .case-meta .case-link {
      color: var(--peach);
      text-decoration: underline;
      text-decoration-color: rgba(255, 164, 138, 0.4);
      text-underline-offset: 2px;
      transition: color 0.2s, text-decoration-color 0.2s;
    }
    .case-meta .case-link:hover {
      color: var(--red);
      text-decoration-color: var(--red);
    }
    .receipts-card::before {
      content: '';
      position: absolute;
      inset: 0;
      pointer-events: none;
      background: radial-gradient(circle at top right, rgba(255, 99, 99, 0.10), transparent 55%);
    }
    .receipts-card-inner { position: relative; z-index: 1; }
    .case-meta {
      display: flex; gap: 0.6rem; align-items: center;
      font-family: var(--mono);
      font-size: 0.7rem;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--text-muted);
      margin-bottom: 1.5rem;
    }
    .case-meta .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--red); box-shadow: 0 0 10px var(--red); }
    .case-meta-brand {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      gap: 0.75rem;
      align-items: center;
    }
    .case-meta-brand .case-label {
      padding-left: 0.75rem;
      border-left: 1px solid var(--hairline-strong);
    }
    .case-title {
      font-weight: 800;
      font-size: clamp(1.8rem, 3.5vw, 2.8rem);
      letter-spacing: -0.035em;
      line-height: 1.1;
      margin-bottom: 1.5rem;
    }
    .case-title em {
      font-style: normal;
      background: linear-gradient(180deg, var(--peach) 0%, var(--red) 100%);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }
    .case-body {
      color: var(--text-muted);
      font-size: 1.05rem;
      line-height: 1.7;
      max-width: 680px;
      margin-bottom: 1.5rem;
    }
    .case-read-more { display: none; }

    /* Bulleted breakdown of work shipped per case. Hairline-separated rows
       with a red arrow bullet. The "grouped" variant adds a mono-uppercase
       label above each bullet's body for multi-surface case studies. */
    .case-bullets {
      list-style: none;
      max-width: 720px;
      margin: 0 0 2.5rem;
      padding: 0;
    }
    .case-bullets li {
      position: relative;
      padding: 0.75rem 0 0.75rem 1.6rem;
      color: var(--text);
      font-size: 1rem;
      line-height: 1.55;
      border-bottom: 1px solid var(--hairline);
    }
    .case-bullets li:last-child { border-bottom: 0; }
    .case-bullets li::before {
      content: '→';
      position: absolute;
      left: 0;
      top: 0.75rem;
      color: var(--red);
      font-weight: 700;
    }
    .case-bullets.case-bullets-grouped li {
      padding: 1rem 0 1rem 1.6rem;
    }
    .case-bullets.case-bullets-grouped li::before {
      top: 1rem;
      line-height: 1;
      transform: translateY(-0.18rem);
    }
    .case-bullets.case-bullets-grouped li strong {
      display: block;
      font-family: var(--mono);
      font-weight: 500;
      font-size: 0.72rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--peach);
      margin-bottom: 0.45rem;
    }

    .case-stats {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 2rem;
      padding-top: 2rem;
      border-top: 1px solid var(--hairline);
    }
    .case-stat .num {
      font-weight: 800;
      font-size: 2.6rem;
      letter-spacing: -0.04em;
      line-height: 1;
      background: linear-gradient(180deg, var(--peach) 0%, var(--red) 100%);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
      margin-bottom: 0.5rem;
    }
    .case-stat .label {
      font-size: 0.92rem;
      color: var(--text-muted);
      line-height: 1.4;
    }
    .case-work {
      margin-top: 2.5rem;
      display: flex;
      flex-wrap: wrap;
      gap: 0.6rem;
    }
    .work-chip {
      font-family: var(--mono);
      font-size: 0.72rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--text-muted);
      padding: 0.4rem 0.8rem;
      background: var(--surface-2);
      border: 1px solid var(--hairline);
      border-radius: 6px;
    }

    /* ── OUR OWN PRODUCTS ── */
    .own-products { background: var(--bg); }
    .own-products-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 1.25rem;
      margin-top: 3rem;
    }
    .own-product-card {
      background: var(--surface);
      border: 1px solid var(--hairline);
      border-radius: var(--r-lg);
      padding: 1.75rem;
      display: flex;
      flex-direction: column;
      gap: 1rem;
      color: var(--text);
      text-decoration: none;
      transition: border-color 0.2s, transform 0.2s, box-shadow 0.2s;
    }
    .own-product-card:not(.own-product-card-static):hover {
      border-color: var(--red);
      transform: translateY(-2px);
      box-shadow: var(--glow-red-soft);
    }
    .own-product-card-static { cursor: default; }
    .own-product-card-featured { grid-column: 1 / -1; }

    .own-product-meta {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
      flex-wrap: wrap;
    }
    .own-product-status {
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      font-family: var(--mono);
      font-size: 0.66rem;
      font-weight: 500;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      padding: 0.35rem 0.7rem;
      border-radius: 7px;
      border: 1px solid var(--hairline);
      color: var(--text-muted);
      background: var(--surface-2);
    }
    .own-product-status .dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--text-muted);
    }
    .own-product-status.live {
      color: var(--red);
      background: rgba(255, 99, 99, 0.1);
      border-color: rgba(255, 99, 99, 0.28);
    }
    .own-product-status.live .dot {
      background: var(--red);
      box-shadow: 0 0 8px var(--red);
    }
    .own-product-status.muted {
      color: var(--text-muted);
    }
    .own-product-status.experimental {
      color: #f59e0b;
      background: rgba(245, 158, 11, 0.10);
      border-color: rgba(245, 158, 11, 0.28);
    }
    .own-product-status.experimental .dot {
      background: #f59e0b;
      box-shadow: 0 0 8px #f59e0b;
    }
    .own-product-host {
      font-family: var(--mono);
      font-size: 0.7rem;
      letter-spacing: 0.06em;
      color: var(--text-dim);
    }
    .own-product-card:not(.own-product-card-static):hover .own-product-host {
      color: var(--red);
    }

    .own-product-name {
      font-family: var(--sans);
      font-weight: 700;
      font-size: 1.35rem;
      letter-spacing: -0.02em;
      color: var(--text);
    }
    .own-product-outcome {
      color: var(--text-muted);
      font-size: 0.98rem;
      line-height: 1.55;
    }
    .own-product-features {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
      margin-top: auto;
      padding-top: 0.5rem;
    }
    .own-product-features span {
      font-family: var(--mono);
      font-size: 0.66rem;
      letter-spacing: 0.06em;
      color: var(--text-muted);
      padding: 0.3rem 0.6rem;
      background: var(--surface-2);
      border: 1px solid var(--hairline);
      border-radius: 6px;
    }

    /* ── SPRINTS ── */
    .sprints {
      background: linear-gradient(180deg, var(--bg) 0%, var(--bg-elev) 100%);
    }
    .sprints-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1.5rem;
      margin-top: 3rem;
    }
    .sprint-card {
      background: var(--surface);
      border: 1px solid var(--hairline);
      border-radius: var(--r-xl);
      padding: 2.5rem;
      position: relative;
      display: flex;
      flex-direction: column;
      transition: border-color 0.2s, transform 0.15s;
    }
    .sprint-card:hover {
      border-color: var(--hairline-strong);
      transform: translateY(-2px);
    }
    .sprint-card.featured {
      border: 1px solid rgba(255, 99, 99, 0.3);
      box-shadow: 0 0 60px rgba(255, 99, 99, 0.15);
    }
    .sprint-tag {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      font-family: var(--mono);
      font-size: 0.66rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--red);
      font-weight: 600;
      padding: 0.4rem 0.75rem;
      background: rgba(255, 99, 99, 0.08);
      border: 1px solid rgba(255, 99, 99, 0.2);
      border-radius: 7px;
      margin-bottom: 1.5rem;
      width: fit-content;
    }
    .sprint-name {
      font-weight: 800;
      font-size: 1.7rem;
      letter-spacing: -0.025em;
      margin-bottom: 0.4rem;
    }
    .sprint-name em {
      font-style: normal;
      background: linear-gradient(180deg, var(--peach) 0%, var(--red) 100%);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }
    .sprint-pitch {
      color: var(--text-muted);
      font-size: 0.98rem;
      line-height: 1.55;
      margin-bottom: 1.5rem;
    }
    .sprint-price-row {
      display: flex;
      align-items: baseline;
      gap: 0.7rem;
      padding: 1rem 0;
      border-top: 1px solid var(--hairline);
      border-bottom: 1px solid var(--hairline);
      margin-bottom: 1.5rem;
    }
    .sprint-price {
      font-weight: 800;
      font-size: 1.8rem;
      letter-spacing: -0.025em;
      color: var(--text);
    }
    .sprint-duration {
      font-family: var(--mono);
      font-size: 0.78rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--text-dim);
    }
    .sprint-includes {
      list-style: none;
      margin-bottom: 1.5rem;
    }
    .sprint-includes li {
      font-size: 0.95rem;
      color: var(--text-muted);
      padding: 0.45rem 0;
      padding-left: 1.6rem;
      position: relative;
      line-height: 1.5;
    }
    .sprint-includes li::before {
      content: '→';
      position: absolute;
      left: 0;
      color: var(--red);
      font-weight: 700;
    }
    .sprint-card .btn-primary { margin-top: auto; width: fit-content; }

    /* ── HOW IT WORKS ── */
    .how { background: var(--bg); }
    .how-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
      margin-top: 3rem;
    }
    .how-step {
      background: var(--surface);
      border: 1px solid var(--hairline);
      border-radius: var(--r-lg);
      padding: 2rem;
      position: relative;
    }
    .how-step .num {
      font-family: var(--mono);
      font-size: 0.72rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--red);
      margin-bottom: 1rem;
      display: block;
    }
    .how-step h3 {
      font-weight: 700;
      font-size: 1.25rem;
      letter-spacing: -0.02em;
      margin-bottom: 0.6rem;
    }
    .how-step p {
      color: var(--text-muted);
      font-size: 0.95rem;
      line-height: 1.55;
    }

    /* ── FAQ ── */
    .faq { background: var(--bg); }
    .faq-list { margin-top: 2.5rem; }
    .faq-item {
      border-top: 1px solid var(--hairline);
      padding: 1.6rem 0;
    }
    .faq-item:last-child { border-bottom: 1px solid var(--hairline); }
    .faq-question {
      width: 100%;
      background: none;
      border: none;
      color: var(--text);
      font-family: var(--sans);
      font-weight: 600;
      font-size: 1.1rem;
      letter-spacing: -0.015em;
      text-align: left;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
    }
    .faq-question::after {
      content: '+';
      font-weight: 400;
      font-size: 1.5rem;
      color: var(--red);
      transition: transform 0.2s;
    }
    .faq-item.active .faq-question::after { content: '−'; }
    .faq-answer {
      max-height: 0;
      overflow: hidden;
      color: var(--text-muted);
      font-size: 1rem;
      line-height: 1.65;
      transition: max-height 0.3s, padding-top 0.3s;
    }
    .faq-item.active .faq-answer {
      max-height: 400px;
      padding-top: 1rem;
    }

    /* ── FINAL CTA ── */
    .cta-final {
      padding: 6rem 2rem;
      background: var(--bg);
      position: relative;
      overflow: hidden;
    }
    .cta-final::before {
      content: '';
      position: absolute;
      inset: 0;
      pointer-events: none;
      background:
        radial-gradient(ellipse 50% 50% at 50% 50%, rgba(255, 99, 99, 0.26), transparent 65%),
        radial-gradient(ellipse 70% 40% at 50% 50%, rgba(255, 140, 80, 0.10), transparent 75%);
    }
    .cta-final-inner {
      position: relative; z-index: 1;
