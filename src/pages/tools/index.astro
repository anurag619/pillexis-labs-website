---
import BaseLayout from '../../layouts/BaseLayout.astro';
import aiReadiness from '../../data/tools/ai-build-readiness.json';

/**
 * Featured tool — the centerpiece of the hub.
 * Currently only one live tool, so it gets the hero treatment.
 */
const featured = {
  slug: aiReadiness.slug,
  title: aiReadiness.title,
  tagline: aiReadiness.tagline,
  description: aiReadiness.description,
  status: 'Live',
  duration: '3 min',
  questionCount: aiReadiness.questions.length,
  tiers: aiReadiness.tiers.map((t) => t.name),
  sampleTier: aiReadiness.tiers[2], // the "Builder" tier as the preview
  href: `/tools/${aiReadiness.slug}`,
};

/**
 * Pipeline — tools we're working on but haven't shipped.
 * Stays alive without an unfinished tool. Each entry teases.
 */
const pipeline = [
  {
    name: 'Your AI Distribution Gap',
    tagline: 'Where AI stops helping you reach people',
    description:
      "Maps where AI-built products stall out: distribution, positioning, trust, or channels. The companion to the Build Readiness Score.",
    eta: 'Shipping next',
  },
  {
    name: 'AI vs Human Workflow Audit',
    tagline: 'Which parts of your job has AI eaten?',
    description:
      "Walk 12 workflow tasks, score how much AI handles vs human still owns, get the biggest unautomated bottleneck flagged.",
    eta: 'Researching',
  },
];

const title = 'Free tools · Pillexis Labs';
const description =
  "Short, opinionated assessments for founders building with AI. No email gate, no fluff. Find your gaps and the next move in under 5 minutes.";
const path = '/tools';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Free tools by Pillexis Labs',
  description,
  url: `https://pillexislabs.com${path}`,
  hasPart: [
    {
      '@type': 'WebApplication',
      name: featured.title,
      url: `https://pillexislabs.com${featured.href}`,
    },
  ],
};
---

<BaseLayout title={title} description={description} path={path} jsonLd={jsonLd}>
  <!-- ============================================================ -->
  <!-- HERO                                                          -->
  <!-- ============================================================ -->
  <section class="hero">
    <div class="hero-bg" aria-hidden="true"></div>
    <div class="hero-grid" aria-hidden="true"></div>

    <div class="hero-inner">
      <a href="/" class="back-link">
        <svg width="12" height="12" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 12H5M12 19l-7-7 7-7" />
        </svg>
        Pillexis Labs
      </a>

      <span class="pill-eyebrow">
        <span class="pill-dot"></span>
        Free tools by Pillexis Labs
      </span>

      <h1 class="hero-title">
        Tools for people who <em>actually</em> ship.
      </h1>

      <p class="hero-sub">
        Short, opinionated assessments built from our own research. They tell you
        where you sit on the AI build curve, what's blocking your next ship, and
        the one move worth making this week.
      </p>

      <div class="receipts">
        <div class="receipt">
          <div class="receipt-num">3 min</div>
          <div class="receipt-label">Average</div>
        </div>
        <div class="receipt">
          <div class="receipt-num">$0</div>
          <div class="receipt-label">No email · No signup</div>
        </div>
        <div class="receipt">
          <div class="receipt-num">URL</div>
          <div class="receipt-label">Result you can share</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- FEATURED TOOL                                                 -->
  <!-- ============================================================ -->
  <section class="featured">
    <div class="featured-inner">
      <header class="section-head">
        <span class="section-eyebrow">Live now</span>
        <h2 class="section-title">Start here.</h2>
      </header>

      <article class="featured-card">
        <div class="featured-card-glow" aria-hidden="true"></div>
        <div class="featured-card-grid">
          <!-- LEFT: copy + CTA -->
          <div class="featured-copy">
            <div class="featured-meta">
              <span class="status-badge">
                <span class="status-dot"></span>
                {featured.status}
              </span>
              <span class="meta-sep">·</span>
              <span class="meta-text">{featured.duration} read</span>
              <span class="meta-sep">·</span>
              <span class="meta-text">{featured.questionCount} questions</span>
            </div>

            <h3 class="featured-title">{featured.title}</h3>
            <p class="featured-tagline">{featured.tagline}</p>
            <p class="featured-desc">{featured.description}</p>

            <div class="featured-tiers" aria-label="The four tiers you can land on">
              {featured.tiers.map((name, i) => (
                <span class={`tier-chip tier-chip-${i}`}>
                  <span class="tier-step">{`0${i + 1}`}</span>
                  {name}
                </span>
              ))}
            </div>

            <div class="featured-cta-row">
              <a href={featured.href} class="btn-primary">
                Take the assessment
                <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                </svg>
              </a>
              <a href={featured.href} class="btn-ghost">
                Preview a sample result →
              </a>
            </div>
          </div>

          <!-- RIGHT: result preview mock -->
          <aside class="featured-preview" aria-hidden="true">
            <div class="preview-glow"></div>
            <div class="preview-card">
              <div class="preview-window">
                <span></span><span></span><span></span>
                <div class="preview-url">/tools/ai-build-readiness?r=…#builder</div>
              </div>
              <div class="preview-body">
                <div class="preview-pill">
                  <span class="preview-pill-dot"></span>
                  Your tier
                </div>
                <div class="preview-tier">{featured.sampleTier.name}</div>
                <div class="preview-headline">{featured.sampleTier.headline}</div>
                <div class="preview-divider"></div>
                <div class="preview-next-label">The one move this week</div>
                <div class="preview-next-body">
                  {featured.sampleTier.nextStep.body.slice(0, 130)}…
                </div>
              </div>
              <div class="preview-corner-tag">SAMPLE</div>
            </div>
          </aside>
        </div>
      </article>
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- PIPELINE — what's coming                                      -->
  <!-- ============================================================ -->
  <section class="pipeline">
    <div class="pipeline-inner">
      <header class="section-head">
        <span class="section-eyebrow">Shipping next</span>
        <h2 class="section-title">In the workshop.</h2>
        <p class="section-sub">
          What's currently being built. Each tool gets shipped when we've found
          something real to say about it. Not before.
        </p>
      </header>

      <ul class="pipeline-list">
        {pipeline.map((tool, i) => (
          <li class="pipeline-card">
            <div class="pipeline-card-meta">
              <span class="pipeline-num">{`0${i + 1}`}</span>
              <span class="pipeline-eta">{tool.eta}</span>
            </div>
            <h3 class="pipeline-title">{tool.name}</h3>
            <p class="pipeline-tagline">{tool.tagline}</p>
            <p class="pipeline-desc">{tool.description}</p>
          </li>
        ))}
      </ul>

      <a href="/#book" class="pipeline-cta">
        <span class="pipeline-cta-icon">+</span>
        <span>
          <strong>Something else worth building?</strong>
          Tell us what to make.
        </span>
        <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- WHY — studio tie-back                                         -->
  <!-- ============================================================ -->
  <section class="why">
    <div class="why-inner">
      <span class="section-eyebrow">Why we ship these</span>
      <h2 class="why-title">
        Every tool is a slice of our <em>research</em>.
      </h2>
      <p class="why-body">
        Pillexis Labs is a product studio. We ship AI-built apps end-to-end and
        watch where they break. The gaps we find become two things: our next
        product, and a free tool that helps other builders see the same gap
        before they hit it.
      </p>
      <div class="why-cta-row">
        <a href="/" class="btn-ghost-lg">
          See what we're building
          <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
        <a href="/" class="text-link">
          Work with us →
        </a>
      </div>
    </div>
  </section>

  <style>
    /* ============================================================
       SHARED — section helpers
    ============================================================ */
    .section-head { max-width: 760px; margin-bottom: 2.5rem; }
    .section-eyebrow {
      display: inline-flex;
      align-items: center;
      font-family: var(--mono);
      font-size: 0.72rem;
      font-weight: 500;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--red);
      margin-bottom: 1.2rem;
    }
    .section-title {
      font-family: var(--sans);
      font-weight: 800;
      font-size: clamp(2rem, 4.4vw, 3.2rem);
      letter-spacing: -0.035em;
      line-height: 1.08;
      color: var(--text);
      margin-bottom: 0.8rem;
    }
    .section-sub {
      color: var(--text-muted);
      font-size: 1.06rem;
      line-height: 1.6;
      max-width: 580px;
    }

    /* ============================================================
       HERO
    ============================================================ */
    .hero {
      position: relative;
      padding: 7.5rem 1.5rem 5rem;
      overflow: hidden;
    }
    .hero-bg {
      position: absolute;
      inset: 0;
      pointer-events: none;
      background:
        radial-gradient(ellipse 70% 60% at 15% 0%, rgba(255, 99, 99, 0.22), transparent 60%),
        radial-gradient(ellipse 90% 60% at 90% 30%, rgba(255, 140, 80, 0.14), transparent 70%),
        radial-gradient(ellipse 50% 30% at 50% 90%, rgba(255, 99, 99, 0.10), transparent 75%);
    }
    .hero-grid {
      position: absolute;
      inset: 0;
      pointer-events: none;
      opacity: 0.6;
      background-image: radial-gradient(rgba(255, 255, 255, 0.045) 1px, transparent 1px);
      background-size: 22px 22px;
      -webkit-mask-image: linear-gradient(180deg, #000 5%, transparent 90%);
              mask-image: linear-gradient(180deg, #000 5%, transparent 90%);
    }
    .hero-inner {
      position: relative;
      max-width: 1100px;
      margin: 0 auto;
    }
    .back-link {
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      font-family: var(--mono);
      font-size: 0.72rem;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--text-muted);
      margin-bottom: 3rem;
      transition: color 0.2s, gap 0.2s;
    }
    .back-link:hover { color: var(--red); gap: 0.6rem; }

    .pill-eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 0.55rem;
      font-family: var(--mono);
      font-size: 0.72rem;
      font-weight: 500;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--red);
      padding: 0.45rem 0.9rem;
      background: rgba(255, 99, 99, 0.08);
      border: 1px solid rgba(255, 99, 99, 0.22);
      border-radius: 7px;
      margin-bottom: 2rem;
    }
    .pill-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--red);
      box-shadow: 0 0 10px var(--red);
    }

    .hero-title {
      font-family: var(--sans);
      font-weight: 800;
      font-size: clamp(2.6rem, 7vw, 5rem);
      letter-spacing: -0.05em;
      line-height: 1.02;
      color: var(--text);
      margin-bottom: 1.5rem;
      max-width: 920px;
    }
    .hero-title em {
      font-style: italic;
      background: linear-gradient(180deg, var(--peach) 0%, var(--red) 100%);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
      filter: drop-shadow(0 0 30px rgba(255, 99, 99, 0.35));
    }

    .hero-sub {
      font-size: 1.15rem;
      color: var(--text-muted);
      line-height: 1.6;
      max-width: 640px;
      margin-bottom: 3rem;
    }

    /* Receipts: small mono numerals + label */
    .receipts {
      display: grid;
      grid-template-columns: repeat(3, max-content);
      gap: 2.5rem;
      padding-top: 2rem;
      border-top: 1px solid var(--hairline);
      max-width: 720px;
    }
    .receipt-num {
      font-family: var(--sans);
      font-weight: 800;
      font-size: 1.6rem;
      letter-spacing: -0.03em;
      line-height: 1;
      background: linear-gradient(180deg, #fff 0%, var(--red) 130%);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
      margin-bottom: 0.4rem;
    }
    .receipt-label {
      font-family: var(--mono);
      font-size: 0.68rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--text-dim);
    }

    /* ============================================================
       FEATURED TOOL
    ============================================================ */
    .featured {
      padding: 5rem 1.5rem;
      background: var(--bg);
      position: relative;
    }
    .featured-inner {
      max-width: 1100px;
      margin: 0 auto;
    }

    .featured-card {
      position: relative;
      background: linear-gradient(180deg, var(--surface) 0%, #101013 100%);
      border: 1px solid var(--hairline);
      border-radius: var(--r-xl);
      padding: 3rem;
      overflow: hidden;
      isolation: isolate;
    }
    .featured-card-glow {
      position: absolute;
      inset: 0;
      pointer-events: none;
      background: radial-gradient(ellipse 60% 50% at 100% 0%, rgba(255, 99, 99, 0.22), transparent 60%);
      z-index: 0;
    }
    .featured-card-grid {
      position: relative;
      z-index: 1;
      display: grid;
      grid-template-columns: 1.1fr 1fr;
      gap: 3rem;
      align-items: center;
    }

    .featured-meta {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      margin-bottom: 1.6rem;
      flex-wrap: wrap;
    }
    .status-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      font-family: var(--mono);
      font-size: 0.68rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--red);
      padding: 0.35rem 0.7rem;
      background: rgba(255, 99, 99, 0.1);
      border: 1px solid rgba(255, 99, 99, 0.28);
      border-radius: 7px;
    }
    .status-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--red);
      box-shadow: 0 0 8px var(--red);
    }
    .meta-text {
      font-family: var(--mono);
      font-size: 0.72rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--text-dim);
    }
    .meta-sep {
      color: var(--hairline-strong);
      font-size: 0.7rem;
    }

    .featured-title {
      font-family: var(--sans);
      font-weight: 800;
      font-size: clamp(1.8rem, 3.5vw, 2.5rem);
      letter-spacing: -0.035em;
      line-height: 1.1;
      color: var(--text);
      margin-bottom: 0.65rem;
    }
    .featured-tagline {
      font-family: var(--mono);
      font-size: 0.78rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--red);
      margin-bottom: 1.2rem;
    }
    .featured-desc {
      color: var(--text-muted);
      font-size: 1.04rem;
      line-height: 1.6;
      margin-bottom: 1.75rem;
      max-width: 520px;
    }

    .featured-tiers {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin-bottom: 2rem;
    }
    .tier-chip {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      font-family: var(--sans);
      font-size: 0.84rem;
      font-weight: 500;
      color: var(--text);
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid var(--hairline);
      border-radius: 7px;
      padding: 0.4rem 0.9rem 0.4rem 0.55rem;
    }
    .tier-step {
      font-family: var(--mono);
      font-size: 0.7rem;
      letter-spacing: 0.1em;
      color: var(--text-dim);
    }
    .tier-chip-3 {
      border-color: rgba(255, 99, 99, 0.4);
      background: rgba(255, 99, 99, 0.08);
    }
    .tier-chip-3 .tier-step { color: var(--red); }

    .featured-cta-row {
      display: flex;
      gap: 0.85rem;
      align-items: center;
      flex-wrap: wrap;
    }

    .btn-primary {
      display: inline-flex;
      align-items: center;
      gap: 0.55rem;
      padding: 0.95rem 1.6rem;
      border-radius: 10px;
      background: var(--red);
      color: #fff;
      font-family: var(--sans);
      font-weight: 500;
      font-size: 0.98rem;
      border: 1px solid rgba(255, 255, 255, 0.12);
      box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.25),
        0 1px 2px rgba(0, 0, 0, 0.4),
        0 0 30px rgba(255, 99, 99, 0.35);
      transition: transform 0.15s, box-shadow 0.2s, background 0.2s;
    }
    .btn-primary:hover {
      background: var(--red-hot);
      color: #fff;
      transform: translateY(-1px);
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.3), 0 0 50px rgba(255, 99, 99, 0.5);
    }
    .btn-ghost {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      color: var(--text-muted);
      font-family: var(--sans);
      font-size: 0.92rem;
      font-weight: 500;
      padding: 0.95rem 0.4rem;
      transition: color 0.2s, gap 0.2s;
    }
    .btn-ghost:hover { color: var(--text); gap: 0.6rem; }

    /* Preview mock */
    .featured-preview {
      position: relative;
      perspective: 1500px;
    }
    .preview-glow {
      position: absolute;
      inset: -20% -10%;
      background: radial-gradient(ellipse 60% 50% at 50% 50%, rgba(255, 99, 99, 0.25), transparent 70%);
      pointer-events: none;
      z-index: 0;
    }
    .preview-card {
      position: relative;
      z-index: 1;
      background: var(--bg-elev);
      border: 1px solid var(--hairline-strong);
      border-radius: var(--r-lg);
      overflow: hidden;
      box-shadow:
        0 30px 60px -20px rgba(0, 0, 0, 0.7),
        0 0 0 1px rgba(255, 255, 255, 0.03) inset;
      transform: rotateY(-3deg) rotateX(2deg) translateZ(0);
      transition: transform 0.4s ease;
    }
    .featured-preview:hover .preview-card {
      transform: rotateY(0deg) rotateX(0deg) translateZ(8px);
    }

    .preview-window {
      display: flex;
      align-items: center;
      gap: 0.4rem;
      padding: 0.7rem 0.9rem;
      background: rgba(255, 255, 255, 0.02);
      border-bottom: 1px solid var(--hairline);
    }
    .preview-window > span:not(.preview-url) {
      width: 9px;
      height: 9px;
      border-radius: 50%;
      background: #2a2a30;
      display: inline-block;
    }
    .preview-url {
      margin-left: 0.6rem;
      font-family: var(--mono);
      font-size: 0.66rem;
      color: var(--text-dim);
      letter-spacing: 0.04em;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .preview-body {
      padding: 1.6rem 1.4rem 1.4rem;
    }
    .preview-pill {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      font-family: var(--mono);
      font-size: 0.6rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--red);
      padding: 0.3rem 0.55rem;
      background: rgba(255, 99, 99, 0.1);
      border: 1px solid rgba(255, 99, 99, 0.28);
      border-radius: 6px;
      margin-bottom: 1rem;
    }
    .preview-pill-dot {
      width: 5px;
      height: 5px;
      border-radius: 50%;
      background: var(--red);
      box-shadow: 0 0 6px var(--red);
    }
    .preview-tier {
      font-family: var(--sans);
      font-weight: 900;
      font-size: 2.6rem;
      letter-spacing: -0.045em;
      line-height: 1;
      background: linear-gradient(180deg, var(--peach) 0%, var(--red) 100%);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
      margin-bottom: 0.75rem;
    }
    .preview-headline {
      font-weight: 600;
      font-size: 0.92rem;
      letter-spacing: -0.015em;
      color: var(--text);
      line-height: 1.3;
      margin-bottom: 1.1rem;
    }
    .preview-divider {
      height: 1px;
      background: var(--hairline);
      margin-bottom: 1.1rem;
    }
    .preview-next-label {
      font-family: var(--mono);
      font-size: 0.6rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--red);
      margin-bottom: 0.45rem;
    }
    .preview-next-body {
      color: var(--text-muted);
      font-size: 0.85rem;
      line-height: 1.5;
    }
    .preview-corner-tag {
      position: absolute;
      top: 0.7rem;
      right: 0.7rem;
      font-family: var(--mono);
      font-size: 0.58rem;
      letter-spacing: 0.18em;
      color: var(--text-dim);
      padding: 0.2rem 0.45rem;
      border: 1px solid var(--hairline);
      border-radius: 4px;
      background: rgba(0, 0, 0, 0.4);
      z-index: 2;
    }

    /* ============================================================
       PIPELINE
    ============================================================ */
    .pipeline {
      padding: 5rem 1.5rem;
      background: linear-gradient(180deg, var(--bg) 0%, #080809 100%);
      border-top: 1px solid var(--hairline);
    }
    .pipeline-inner {
      max-width: 1100px;
      margin: 0 auto;
    }

    .pipeline-list {
      list-style: none;
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 1.25rem;
      margin-bottom: 2.5rem;
    }
    .pipeline-card {
      background: var(--surface);
      border: 1px solid var(--hairline);
