---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);

  // Collect every unique tag + pillar slug (pillars double as filterable hub pages)
  const tagSet = new Set<string>();
  posts.forEach(p => {
    p.data.tags.forEach(t => tagSet.add(t));
    tagSet.add(p.data.pillar);
  });

  return Array.from(tagSet).map(tag => ({
    params: { tag },
    props: {
      tag,
      posts: posts
        .filter(p => p.data.tags.includes(tag) || p.data.pillar === tag)
        .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()),
    },
  }));
}

type Props = { tag: string; posts: CollectionEntry<'blog'>[] };
const { tag, posts } = Astro.props;

const PILLAR_LABEL: Record<string, string> = {
  'build-logs': 'Build logs',
  'studio-notes': 'Studio notes',
  'distribution-diaries': 'Distribution diaries',
};

const isPillar = tag in PILLAR_LABEL;
const displayLabel = isPillar ? PILLAR_LABEL[tag] : `#${tag}`;
const heading = isPillar ? PILLAR_LABEL[tag] : `Posts tagged #${tag}`;
const description = isPillar
  ? `Every ${PILLAR_LABEL[tag].toLowerCase()} post from Pillexis Labs.`
  : `Every Pillexis Labs blog post tagged #${tag}.`;

const path = `/blog/tags/${tag}`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: heading,
  description,
  url: `https://pillexislabs.com${path}`,
  hasPart: posts.map(p => ({
    '@type': 'BlogPosting',
    headline: p.data.title,
    url: `https://pillexislabs.com/blog/${p.slug}`,
    datePublished: p.data.publishDate.toISOString(),
  })),
};
---

<BaseLayout title={`${heading} · Pillexis Labs`} description={description} path={path} jsonLd={jsonLd}>
  <main class="tag-page">
    <div class="tag-bg" aria-hidden="true"></div>
    <div class="tag-inner">
      <a href="/blog" class="back-link">
        <svg width="12" height="12" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 12H5M12 19l-7-7 7-7" />
        </svg>
        All posts
      </a>

      <span class="pill-eyebrow">
        <span class="pill-dot"></span>
        {isPillar ? 'Pillar' : 'Tag'}
      </span>

      <h1 class="tag-title">{displayLabel}</h1>
      <p class="tag-sub">{description}</p>

      <ul class="post-list">
        {posts.map(post => (
          <li class="post-row">
            <a href={`/blog/${post.slug}`} class="post-link">
              <div class="post-meta">
                <time>{post.data.publishDate.toLocaleDateString('en-US', { day: 'numeric', month: 'short', year: 'numeric' })}</time>
                {!isPillar && (
                  <>
                    <span class="sep">·</span>
                    <span class="post-pillar">{PILLAR_LABEL[post.data.pillar]}</span>
                  </>
                )}
              </div>
              <h2 class="post-title">{post.data.title}</h2>
              <p class="post-desc">{post.data.description}</p>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </main>

  <style>
    .tag-page {
      position: relative;
      padding: 7.5rem 1.5rem 6rem;
      min-height: 100vh;
      overflow: hidden;
    }
    .tag-bg {
      position: absolute; inset: 0; pointer-events: none;
      background: radial-gradient(ellipse 70% 50% at 30% 0%, rgba(255, 99, 99, 0.14), transparent 65%);
    }
    .tag-inner { position: relative; max-width: 760px; margin: 0 auto; }

    .back-link {
      display: inline-flex; align-items: center; gap: 0.4rem;
      font-family: var(--mono); font-size: 0.72rem;
      letter-spacing: 0.16em; text-transform: uppercase;
      color: var(--text-muted); margin-bottom: 2.5rem;
      transition: color 0.2s, gap 0.2s;
    }
    .back-link:hover { color: var(--red); gap: 0.55rem; }

    .pill-eyebrow {
      display: inline-flex; align-items: center; gap: 0.55rem;
      font-family: var(--mono); font-size: 0.72rem;
      letter-spacing: 0.16em; text-transform: uppercase; color: var(--red);
      padding: 0.45rem 0.9rem;
      background: rgba(255, 99, 99, 0.08);
      border: 1px solid rgba(255, 99, 99, 0.22);
      border-radius: 100px;
      margin-bottom: 1.75rem;
    }
    .pill-dot {
      width: 6px; height: 6px; border-radius: 50%;
      background: var(--red); box-shadow: 0 0 10px var(--red);
    }

    .tag-title {
      font-family: var(--sans); font-weight: 800;
      font-size: clamp(2.2rem, 5vw, 3.6rem);
      letter-spacing: -0.04em; line-height: 1.05;
      margin-bottom: 1rem;
    }
    .tag-sub { font-size: 1.1rem; color: var(--text-muted); line-height: 1.55; margin-bottom: 3rem; }

    .post-list { list-style: none; }
    .post-row { border-top: 1px solid var(--hairline); }
    .post-row:last-child { border-bottom: 1px solid var(--hairline); }
    .post-link {
      display: block; padding: 1.6rem 0; color: var(--text);
      transition: padding-left 0.18s;
    }
    .post-link:hover { padding-left: 0.5rem; }

    .post-meta {
      display: flex; gap: 0.5rem; align-items: center;
      font-family: var(--mono); font-size: 0.7rem;
      letter-spacing: 0.1em; text-transform: uppercase;
      color: var(--text-dim); margin-bottom: 0.6rem;
    }
    .post-meta .sep { color: var(--hairline-strong); }
    .post-pillar { color: var(--red); }

    .post-title {
      font-family: var(--sans); font-weight: 700;
      font-size: 1.45rem; letter-spacing: -0.02em;
      line-height: 1.2; color: var(--text); margin-bottom: 0.4rem;
    }
    .post-desc { color: var(--text-muted); font-size: 0.95rem; line-height: 1.55; }

    @media (max-width: 700px) {
      .tag-page { padding: 6rem 1.25rem 4rem; }
    }
  </style>
</BaseLayout>
