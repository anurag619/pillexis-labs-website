---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());

const PILLARS = {
  'build-logs': { label: 'Build logs', blurb: 'How we shipped what we shipped.' },
  'studio-notes': { label: 'Studio notes', blurb: 'Patterns across products.' },
  'distribution-diaries': { label: 'Distribution diaries', blurb: 'The launches, the numbers, the honest parts.' },
};

const title = 'Blog · Pillexis Labs';
const description = 'Build logs, studio notes, and distribution diaries from a research-driven AI product studio. The work, the patterns, and the honest parts.';
const path = '/blog';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'Pillexis Labs Blog',
  url: `https://pillexislabs.com${path}`,
  description,
  publisher: {
    '@type': 'Organization',
    name: 'Pillexis Labs',
    url: 'https://pillexislabs.com',
  },
};
---

<BaseLayout title={title} description={description} path={path} jsonLd={jsonLd}>
  <main class="blog-index">
    <div class="blog-bg" aria-hidden="true"></div>

    <div class="blog-inner">
      <a href="/" class="back-link">
        <svg width="12" height="12" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 12H5M12 19l-7-7 7-7" />
        </svg>
        Pillexis Labs
      </a>

      <span class="pill-eyebrow">
        The studio blog
      </span>

      <h1 class="blog-title">
        Notes from the lab.
      </h1>
      <p class="blog-sub">
        We ship AI-built products and write down what we find. Build logs from each
        product, studio notes on the patterns we see across all of them, and honest
        diaries of how we tried to get people to use any of it.
      </p>

      {posts.length === 0 ? (
        <p class="empty">No posts published yet. The first one is in draft.</p>
      ) : (
        <ul class="post-list">
          {posts.map(post => (
            <li class="post-row">
              <a href={`/blog/${post.slug}`} class="post-link">
                <div class="post-meta">
                  <span class="post-date">
                    {post.data.publishDate.toLocaleDateString('en-US', { day: 'numeric', month: 'short', year: 'numeric' })}
                  </span>
                  <span class="post-sep">·</span>
                  <span class="post-pillar">{PILLARS[post.data.pillar].label}</span>
                  {post.data.readingTime && (
                    <>
                      <span class="post-sep">·</span>
                      <span class="post-rt">{post.data.readingTime} min read</span>
                    </>
                  )}
                </div>
                <h2 class="post-title">{post.data.title}</h2>
                <p class="post-desc">{post.data.description}</p>
                <span class="post-cta">
                  Read the post
                  <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                  </svg>
                </span>
              </a>
            </li>
          ))}
        </ul>
      )}

      <div class="blog-foot">
        <a href="/rss.xml" class="rss-link">
          <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 11a9 9 0 0 1 9 9M4 4a16 16 0 0 1 16 16M6 19a1 1 0 1 1-2 0 1 1 0 0 1 2 0z" />
          </svg>
          Subscribe via RSS
        </a>
      </div>
    </div>
  </main>

  <style>
    .blog-index {
      position: relative;
      padding: 7.5rem 1.5rem 6rem;
      min-height: 100vh;
      overflow: hidden;
    }
    .blog-bg {
      position: absolute;
      inset: 0;
      pointer-events: none;
      background:
        radial-gradient(ellipse 70% 60% at 18% 8%, rgba(255, 99, 99, 0.18), transparent 60%),
        radial-gradient(ellipse 90% 60% at 95% 35%, rgba(255, 140, 80, 0.10), transparent 70%);
    }
    .blog-inner {
      position: relative;
      max-width: 900px;
      margin: 0 auto;
    }

    .back-link {
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      font-family: var(--mono);
      font-size: 0.72rem;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--text-muted);
      margin-bottom: 2.5rem;
      transition: color 0.2s, gap 0.2s;
    }
    .back-link:hover { color: var(--red); gap: 0.6rem; }

    .pill-eyebrow {
      display: inline-flex;
      align-items: center;
      font-family: var(--mono);
      font-size: 0.72rem;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--red);
      padding: 0.45rem 0.9rem;
      background: rgba(255, 99, 99, 0.08);
      border: 1px solid rgba(255, 99, 99, 0.22);
      border-radius: 7px;
      margin-bottom: 1.75rem;
    }
    .blog-title {
      font-family: var(--sans);
      font-weight: 800;
      font-size: clamp(2.5rem, 6vw, 4.4rem);
      letter-spacing: -0.045em;
      line-height: 1.05;
      margin-bottom: 1.2rem;
    }
    .blog-sub {
      font-size: 1.1rem;
      color: var(--text-muted);
      line-height: 1.6;
      max-width: 640px;
      margin-bottom: 3rem;
    }

    /* Post list */
    .post-list { list-style: none; }
    .post-row {
      border-top: 1px solid var(--hairline);
    }
    .post-row:last-child { border-bottom: 1px solid var(--hairline); }
    .post-link {
      display: block;
      padding: 2rem 0;
      color: var(--text);
      transition: padding-left 0.2s;
    }
    .post-link:hover { padding-left: 0.5rem; }
    .post-link:hover .post-cta { gap: 0.65rem; color: var(--red); }

    .post-meta {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-family: var(--mono);
      font-size: 0.7rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--text-dim);
      margin-bottom: 0.85rem;
    }
    .post-sep { color: var(--hairline-strong); }
    .post-pillar { color: var(--red); }

    .post-title {
      font-family: var(--sans);
      font-weight: 700;
      font-size: clamp(1.4rem, 3vw, 1.95rem);
      letter-spacing: -0.025em;
      line-height: 1.15;
      color: var(--text);
      margin-bottom: 0.6rem;
    }
    .post-desc {
      font-size: 1rem;
      color: var(--text-muted);
      line-height: 1.55;
      max-width: 640px;
      margin-bottom: 1rem;
    }
    .post-cta {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      font-family: var(--sans);
      font-size: 0.92rem;
      font-weight: 500;
      color: var(--text-muted);
      transition: gap 0.18s, color 0.18s;
    }

    .empty {
      padding: 3rem 0;
      color: var(--text-muted);
      font-style: italic;
      border-top: 1px solid var(--hairline);
      border-bottom: 1px solid var(--hairline);
    }

    .blog-foot {
      margin-top: 3rem;
      padding-top: 2.5rem;
      border-top: 1px solid var(--hairline);
    }
    .rss-link {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      font-family: var(--mono);
      font-size: 0.74rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--text-muted);
      padding: 0.6rem 1rem;
      background: var(--surface);
      border: 1px solid var(--hairline);
      border-radius: 7px;
      transition: color 0.2s, border-color 0.2s;
    }
    .rss-link:hover { color: var(--red); border-color: var(--red); }

    @media (max-width: 700px) {
      .blog-index { padding: 6rem 1.25rem 4rem; }
      .post-link { padding: 1.5rem 0; }
    }
  </style>
</BaseLayout>
