---
import BaseLayout from '../layouts/BaseLayout.astro';
import BookingScripts from '../components/BookingScripts.astro';
import SiteNav from '../components/SiteNav.astro';
import ThemeToggle from '../components/ThemeToggle.astro';

const title = "Work with us · Pillexis Labs";
const description = "Three focused engagements. One operator. We sort the AI mess, the ops mess, and legacy code for Indian D2C teams who've outgrown their stack.";

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Pillexis Labs · Sprint engagements',
  description,
  url: 'https://pillexislabs.com/',
  provider: {
    '@type': 'Organization',
    name: 'Pillexis Labs',
    url: 'https://pillexislabs.com',
  },
  serviceType: 'AI, operations, and legacy application modernization engagements',
  areaServed: { '@type': 'Country', name: 'India' },
  potentialAction: {
    '@type': 'ReserveAction',
    target: 'https://cal.com/pillexislabs/pillexis-labs-intro-call',
    result: { '@type': 'Reservation', name: '20-minute intro call' },
  },
};
---

<BaseLayout title={title} description={description} path="/" jsonLd={jsonLd}>
  <style is:global>

    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

    html { scroll-behavior: smooth; background: var(--bg); }
    body {
      font-family: var(--sans);
      background: var(--bg);
      color: var(--text);
      line-height: 1.6;
      letter-spacing: -0.011em;
      -webkit-font-smoothing: antialiased;
      overflow-x: hidden;
    }
    ::selection { background: var(--red-dim); color: #fff; }

    a { color: var(--text); text-decoration: none; }

    /* ── NAV ── */
    nav {
      position: fixed; top: 0; left: 0; right: 0; z-index: 100;
      padding: 0.7rem 1.5rem;
      background: rgba(10, 10, 10, 0.6);
      backdrop-filter: blur(18px) saturate(180%);
      -webkit-backdrop-filter: blur(18px) saturate(180%);
      border-bottom: 1px solid var(--hairline);
    }
    .nav-inner {
      max-width: 1200px; margin: 0 auto;
      display: flex; align-items: center; justify-content: space-between;
    }
    .logo {
      display: inline-flex; align-items: center; gap: 0.55rem;
      font-size: 0.98rem; font-weight: 600; color: var(--text);
      letter-spacing: -0.01em;
    }
    .logo-dot {
      width: 10px; height: 10px; border-radius: 2px;
      background: var(--red);
      box-shadow: 0 0 12px rgba(255, 99, 99, 0.4);
    }
    .nav-links { display: flex; gap: 1.75rem; list-style: none; }
    .nav-links a {
      color: var(--text-muted); font-size: 0.85rem; font-weight: 500;
      transition: color 0.2s;
    }
    .nav-links a:hover { color: var(--text); }
    .nav-cta {
      background: var(--red);
      color: #fff !important;
      padding: 0.45rem 0.9rem;
      border-radius: 8px;
      font-size: 0.82rem; font-weight: 500;
      border: 1px solid rgba(255, 255, 255, 0.12);
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.2), var(--glow-red-soft);
      transition: background 0.2s;
    }
    .nav-cta:hover { background: var(--red-hot); }

    /* ── BUTTONS ── */
    .btn-primary {
      display: inline-flex; align-items: center; gap: 0.5rem;
      padding: 0.95rem 1.6rem;
      border-radius: 10px;
      background: var(--red);
      color: #fff;
      font-weight: 500; font-size: 0.98rem;
      border: 1px solid rgba(255, 255, 255, 0.12);
      box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.25),
        0 1px 2px rgba(0, 0, 0, 0.4),
        0 0 30px rgba(255, 99, 99, 0.35);
      transition: transform 0.15s, box-shadow 0.2s, background 0.2s;
    }
    .btn-primary:hover {
      background: var(--red-hot); color: #fff;
      transform: translateY(-1px);
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.3), 0 0 50px rgba(255, 99, 99, 0.5);
    }
    .btn-secondary {
      display: inline-flex; align-items: center; gap: 0.5rem;
      padding: 0.95rem 1.6rem;
      border-radius: 10px;
      background: var(--surface);
      color: var(--text);
      border: 1px solid var(--hairline);
      font-weight: 500; font-size: 0.98rem;
      transition: background 0.2s, border-color 0.2s;
    }
    .btn-secondary:hover { background: var(--surface-2); border-color: var(--hairline-strong); }

    /* ── SECTION ── */
    section { padding: 5rem 2rem; }
    .container { max-width: 1100px; margin: 0 auto; }
    .eyebrow {
      font-family: var(--mono);
      font-size: 0.72rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--text-dim);
      font-weight: 500;
      margin-bottom: 1.2rem;
    }
    .section-title {
      font-weight: 800;
      font-size: clamp(2.2rem, 4.5vw, 3.6rem);
      letter-spacing: -0.04em;
      line-height: 1.05;
      margin-bottom: 1.2rem;
    }
    .section-title em {
      font-style: normal;
      color: var(--peach);
      text-decoration: underline;
      text-decoration-color: var(--red);
      text-decoration-thickness: 2px;
      text-underline-offset: 0.12em;
    }
    .section-sub {
      font-size: 1.1rem;
      color: var(--text-muted);
      max-width: 640px;
      line-height: 1.6;
      margin-bottom: 2rem;
    }

    /* ── HERO ── */
    .hero {
      padding: 8rem 2rem 4.5rem;
      position: relative;
      overflow: hidden;
    }
    .hero::before {
      content: '';
      position: absolute;
      inset: 0;
      pointer-events: none;
      background:
        radial-gradient(circle at 72% 18%, rgba(255, 99, 99, 0.14), transparent 42%),
        radial-gradient(circle at 30% 80%, rgba(255, 140, 80, 0.08), transparent 55%);
    }
    .grid-bg {
      position: absolute; inset: 0; pointer-events: none; opacity: 0.4;
      background-image: radial-gradient(var(--hairline) 1px, transparent 1px);
      background-size: 24px 24px;
      mask-image: linear-gradient(180deg, #000 0%, transparent 70%);
    }
    .hero-inner {
      position: relative;
      max-width: 1200px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: minmax(0, 1.05fr) minmax(360px, 0.95fr);
      gap: clamp(3rem, 7vw, 6rem);
      align-items: center;
    }
    .hero-copy { min-width: 0; }

    .hero h1 {
      font-weight: 900;
      font-size: clamp(2.6rem, 6vw, 4.8rem);
      letter-spacing: -0.04em;
      line-height: 1.02;
      margin-bottom: 1.8rem;
      max-width: 700px;
      overflow-wrap: anywhere;
    }
    .hero h1 em {
      font-style: normal;
      color: var(--peach);
      text-decoration: underline;
      text-decoration-color: var(--red);
      text-decoration-thickness: 3px;
      text-underline-offset: 0.12em;
    }
    .hero-sub {
      font-size: 1.2rem;
      color: var(--text-muted);
      max-width: 540px;
      line-height: 1.55;
      margin-bottom: 2.5rem;
    }
    .hero-cta-row { display: flex; gap: 0.85rem; flex-wrap: wrap; }

    .hero-receipts {
      margin-top: 3rem;
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      padding-top: 1.5rem;
      border-top: 1px solid var(--hairline);
    }
    .hero-receipt {
      min-width: 0;
      padding-right: 1rem;
    }
    .hero-receipt + .hero-receipt {
      padding-left: 1rem;
      border-left: 1px solid var(--hairline);
    }
    .hero-receipt .num {
      font-weight: 800;
      font-size: clamp(1.35rem, 2.2vw, 2rem);
      letter-spacing: -0.03em;
      line-height: 1;
      color: var(--text);
      font-variant-numeric: tabular-nums;
    }
    .hero-receipt .label {
      font-family: var(--mono);
      font-size: 0.64rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--text-dim);
      margin-top: 0.6rem;
    }
    .hero-visual {
      position: relative;
      min-width: 0;
      width: 100%;
      max-width: 520px;
      justify-self: end;
    }
    .hero-visual::before {
      content: '';
      position: absolute;
      inset: -18px 12px 18px -12px;
      border: 1px solid var(--hairline);
      border-radius: var(--r-md);
      pointer-events: none;
    }
    .hero-visual figure {
      position: relative;
      margin: 0;
      overflow: hidden;
      background: var(--surface);
      border: 1px solid var(--hairline-strong);
      border-radius: var(--r-md);
      width: 100%;
    }
    .hero-visual img {
      display: block;
      width: 100%;
      max-width: 100%;
      height: 650px;
      aspect-ratio: 4 / 5;
      object-fit: cover;
    }
    .hero-visual figcaption {
      position: absolute;
      inset: auto 0 0;
      display: flex;
      justify-content: space-between;
      gap: 1rem;
      padding: 0.85rem 1rem;
      background: rgba(10, 10, 10, 0.86);
      border-top: 1px solid var(--hairline);
      color: var(--text-muted);
      font-family: var(--mono);
      font-size: 0.64rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }

    /* ── RECEIPTS / CASE STUDY ── */
    .receipts { background: var(--bg); }
    .receipts-card {
      background: var(--surface);
      border: 1px solid var(--hairline);
      border-radius: var(--r-xl);
      padding: 3rem;
      position: relative;
      overflow: hidden;
      box-shadow: var(--shadow-card);
    }
    /* Subtle brand-mark divider between case studies */
    .case-divider {
      display: flex;
      align-items: center;
      gap: 0.9rem;
      max-width: 220px;
      margin: 3rem auto;
    }
    .case-divider-line {
      flex: 1;
      height: 1px;
      background: linear-gradient(90deg, transparent, var(--hairline-strong), transparent);
    }
    .case-divider-mark {
      width: 8px;
      height: 8px;
      border-radius: 2px;
      background: var(--red);
      flex-shrink: 0;
    }
    .case-meta .case-link {
      color: var(--peach);
      text-decoration: underline;
      text-decoration-color: rgba(255, 164, 138, 0.4);
      text-underline-offset: 2px;
      transition: color 0.2s, text-decoration-color 0.2s;
    }
    .case-meta .case-link:hover {
      color: var(--red);
      text-decoration-color: var(--red);
    }
    .receipts-card::before {
      content: '';
      position: absolute;
      inset: 0;
      pointer-events: none;
      background: radial-gradient(circle at top right, rgba(255, 99, 99, 0.10), transparent 55%);
    }
    .receipts-card-inner { position: relative; z-index: 1; }
    .case-meta {
      display: flex; gap: 0.6rem; align-items: center;
      font-family: var(--mono);
      font-size: 0.7rem;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--text-muted);
      margin-bottom: 1.5rem;
    }
    .case-meta .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--red); }
    .case-meta-brand {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      gap: 0.75rem;
      align-items: center;
    }
    .case-meta-brand .case-label {
      padding-left: 0.75rem;
      border-left: 1px solid var(--hairline-strong);
    }
    .case-title {
      font-weight: 800;
      font-size: clamp(1.8rem, 3.5vw, 2.8rem);
      letter-spacing: -0.035em;
      line-height: 1.1;
      margin-bottom: 1.5rem;
    }
    .case-title em {
      font-style: normal;
      color: var(--peach);
      text-decoration: underline;
      text-decoration-color: var(--red);
      text-decoration-thickness: 2px;
      text-underline-offset: 0.1em;
    }
    .case-body {
      color: var(--text-muted);
      font-size: 1.05rem;
      line-height: 1.7;
      max-width: 680px;
      margin-bottom: 1.5rem;
    }
    .case-read-more { display: none; }

    /* Bulleted breakdown of work shipped per case. Hairline-separated rows
       with a red arrow bullet. The "grouped" variant adds a mono-uppercase
       label above each bullet's body for multi-surface case studies. */
    .case-bullets {
      list-style: none;
      max-width: 720px;
      margin: 0 0 2.5rem;
      padding: 0;
    }
    .case-bullets li {
      position: relative;
      padding: 0.75rem 0 0.75rem 1.6rem;
      color: var(--text);
      font-size: 1rem;
      line-height: 1.55;
      border-bottom: 1px solid var(--hairline);
    }
    .case-bullets li:last-child { border-bottom: 0; }
    .case-bullets li::before {
      content: '→';
      position: absolute;
      left: 0;
      top: 0.75rem;
      color: var(--red);
      font-weight: 700;
    }
    .case-bullets.case-bullets-grouped li {
      padding: 1rem 0 1rem 1.6rem;
    }
    .case-bullets.case-bullets-grouped li::before {
      top: 1rem;
      line-height: 1;
      transform: translateY(-0.18rem);
    }
    .case-bullets.case-bullets-grouped li strong {
      display: block;
      font-family: var(--mono);
      font-weight: 500;
      font-size: 0.72rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--peach);
      margin-bottom: 0.45rem;
    }

    .case-stats {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 2rem;
      padding-top: 2rem;
      border-top: 1px solid var(--hairline);
    }
    .case-stat .num {
      font-weight: 800;
      font-size: 2.6rem;
      letter-spacing: -0.04em;
      line-height: 1;
      color: var(--text);
      font-variant-numeric: tabular-nums;
      margin-bottom: 0.5rem;
    }
    .case-stat {
      padding-right: 2rem;
      border-right: 1px solid var(--hairline);
    }
    .case-stat:last-child { padding-right: 0; border-right: 0; }
    .case-stat .label {
      font-size: 0.92rem;
      color: var(--text-muted);
      line-height: 1.4;
    }
    /* ── OUR OWN PRODUCTS ── */
    .own-products { background: var(--bg); }
    .own-products-grid {
      display: flex;
      flex-direction: column;
      margin-top: 3rem;
      border-top: 1px solid var(--hairline);
    }
    .own-product-card {
      background: transparent;
      border: 0;
      border-bottom: 1px solid var(--hairline);
      border-radius: 0;
      padding: 2rem 1.25rem;
      display: grid;
      grid-template-columns: minmax(150px, 0.55fr) 168px minmax(0, 1.25fr) minmax(175px, 0.65fr);
      grid-template-areas:
        "name preview outcome meta"
        "features preview outcome meta";
      align-items: start;
      gap: 0.75rem 2.5rem;
      color: var(--text);
      text-decoration: none;
      position: relative;
      isolation: isolate;
      transition: background 0.25s, transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .own-product-card:hover,
    .own-product-card:focus-visible {
      background: var(--surface);
      transform: translateX(4px);
    }
    .own-product-card:focus-visible { outline: 2px solid var(--red); outline-offset: 3px; }
    .own-product-card-static { cursor: default; }

    .own-product-preview {
      grid-area: preview;
      align-self: stretch;
      min-height: 112px;
      overflow: hidden;
      border: 1px solid var(--hairline);
      border-radius: var(--r-md);
      background: var(--surface-2);
      opacity: 0.34;
      transform: translateX(14px) scale(0.97);
      transition: opacity 0.35s, transform 0.55s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.25s;
    }
    .own-product-preview img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      filter: grayscale(0.55) saturate(0.72);
      transition: transform 0.65s cubic-bezier(0.16, 1, 0.3, 1), filter 0.35s;
    }
    .own-product-preview--migraine img { object-fit: contain; padding: 0.4rem; }
    .own-product-preview--tether img { object-fit: cover; object-position: center; }
    .own-product-preview--forge {
      display: grid;
      place-items: center;
      color: var(--red);
      background: var(--bg-elev);
    }
    .own-product-preview--forge svg { width: 80%; height: 80%; }
    .own-product-preview--forge path { fill: none; stroke: var(--hairline-strong); stroke-width: 1; }
    .own-product-preview--forge circle { fill: var(--surface-2); stroke: currentColor; stroke-width: 1.5; }
    .own-product-card:is(:hover, :focus-visible) .own-product-preview {
      opacity: 1;
      transform: translateX(0) scale(1);
      border-color: var(--hairline-strong);
    }
    .own-product-card:is(:hover, :focus-visible) .own-product-preview img {
      filter: grayscale(0) saturate(1);
      transform: scale(1.035);
    }
    .own-product-card:is(:hover, :focus-visible) .own-product-preview--migraine img { transform: scale(1); }
    .own-product-card:is(:hover, :focus-visible) .own-product-name { color: var(--peach); }

    .own-product-meta {
      grid-area: meta;
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      gap: 0.75rem;
    }
    .own-product-status {
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      font-family: var(--mono);
      font-size: 0.66rem;
      font-weight: 500;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      padding: 0.35rem 0.7rem;
      border-radius: 7px;
      border: 1px solid var(--hairline);
      color: var(--text-muted);
      background: var(--surface-2);
    }
    .own-product-status .dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--text-muted);
    }
    .own-product-status.live {
      color: var(--red);
      background: rgba(255, 99, 99, 0.1);
      border-color: rgba(255, 99, 99, 0.28);
    }
    .own-product-status.live .dot {
      background: var(--red);
    }
    .own-product-status.muted {
      color: var(--text-muted);
    }
    .own-product-status.experimental {
      color: #f59e0b;
      background: rgba(245, 158, 11, 0.10);
      border-color: rgba(245, 158, 11, 0.28);
    }
    .own-product-status.experimental .dot {
      background: #f59e0b;
    }
    .own-product-host {
      font-family: var(--mono);
      font-size: 0.7rem;
      letter-spacing: 0.06em;
      color: var(--text-dim);
    }
    .own-product-card:not(.own-product-card-static):hover .own-product-host {
      color: var(--red);
    }

    .own-product-name {
      grid-area: name;
      font-family: var(--sans);
      font-weight: 700;
      font-size: 1.35rem;
      letter-spacing: -0.02em;
      color: var(--text);
      transition: color 0.25s;
    }
    .own-product-outcome {
      grid-area: outcome;
      color: var(--text-muted);
      font-size: 0.98rem;
      line-height: 1.55;
    }
    .own-product-features {
      grid-area: features;
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
      margin-top: 0;
      padding-top: 0;
    }
    .own-product-features span {
      font-family: var(--mono);
      font-size: 0.66rem;
      letter-spacing: 0.06em;
      color: var(--text-muted);
      padding: 0.3rem 0;
      border-bottom: 1px solid var(--hairline);
    }

    /* Hallmark · pre-emit critique: P5 H5 E4 S5 R5 V5 */
    /* ── SERVICE REGISTER ── */
    .sprints {
      background: var(--bg-elev);
    }
    .services-heading {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(260px, 0.55fr);
      gap: 3rem;
      align-items: end;
      margin-bottom: 3.5rem;
    }
    .services-heading .section-title,
    .services-heading .section-sub { margin-bottom: 0; }
    .services-kicker {
      display: block;
      margin-bottom: 1rem;
      font-family: var(--mono);
      font-size: 0.68rem;
      font-weight: 600;
      letter-spacing: 0.17em;
      text-transform: uppercase;
      color: var(--red);
    }
    .services-register {
      overflow: clip;
      background: var(--surface);
      border: 1px solid var(--hairline);
      border-radius: var(--r-lg);
    }
    .service-row {
      display: grid;
      grid-template-columns: 72px minmax(0, 0.9fr) minmax(0, 1.1fr);
      gap: 2.5rem;
      padding: 2.5rem;
      border-bottom: 1px solid var(--hairline);
      transition: background 0.2s;
    }
    .service-row:last-child { border-bottom: 0; }
    .service-row:hover { background: var(--surface-2); }
    .service-index {
      font-family: var(--mono);
      font-size: 0.78rem;
      letter-spacing: 0.12em;
      color: var(--red);
      font-weight: 600;
      padding-top: 0.3rem;
    }
    .service-label {
      display: block;
      margin-bottom: 0.8rem;
      font-family: var(--mono);
      font-size: 0.66rem;
      font-weight: 600;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--text-dim);
    }
    .service-name {
      font-weight: 800;
      font-size: clamp(1.45rem, 2.3vw, 2rem);
      letter-spacing: -0.035em;
      line-height: 1.12;
      margin-bottom: 0.9rem;
    }
    .service-name em {
      font-style: normal;
      color: var(--peach);
    }
    .service-pitch {
      color: var(--text-muted);
      font-size: 0.96rem;
      line-height: 1.6;
    }
    .service-includes {
      list-style: none;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.75rem 1.5rem;
      align-content: start;
    }
    .service-includes li {
      font-size: 0.9rem;
      color: var(--text-muted);
      padding-left: 1.25rem;
      position: relative;
      line-height: 1.45;
    }
    .service-includes li::before {
      content: '→';
      position: absolute;
      left: 0;
      color: var(--red);
      font-weight: 700;
    }
    .services-cta {
