---
import BaseLayout from '../layouts/BaseLayout.astro';
import BookingScripts from '../components/BookingScripts.astro';

const title = "Pillexis Labs · Finding what AI can't build";
const description = "A research-driven product studio. We ship AI-built apps end-to-end, watch where they break, and turn the gaps into our next product. Right now, we're studying distribution.";

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Pillexis Labs',
  url: 'https://pillexislabs.com',
  description,
  sameAs: ['https://productlogz.com'],
};
---

<BaseLayout title={title} description={description} path="/" jsonLd={jsonLd}>
  <style is:global>

    *,
    *::before,
    *::after {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    :root {
      --bg: #0a0a0a;
      --bg-elev: #111114;
      --surface: #141417;
      --surface-2: #18181c;
      --hairline: rgba(255, 255, 255, 0.08);
      --hairline-strong: rgba(255, 255, 255, 0.14);

      --red: #FF6363;
      --red-hot: #FF4D4D;
      --red-dim: rgba(255, 99, 99, 0.18);
      --red-faint: rgba(255, 99, 99, 0.08);

      --text: #F5F5F7;
      --text-muted: #A1A1A6;
      --text-dim: #6E6E73;

      --sans: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      --mono: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace;

      --r-sm: 6px;
      --r-md: 10px;
      --r-lg: 14px;
      --r-xl: 20px;

      --shadow-card: 0 1px 0 rgba(255, 255, 255, 0.04) inset, 0 8px 24px rgba(0, 0, 0, 0.4);
      --glow-red: 0 0 80px 0 rgba(255, 99, 99, 0.35);
      --glow-red-soft: 0 0 40px 0 rgba(255, 99, 99, 0.18);
    }

    html {
      scroll-behavior: smooth;
      background: var(--bg);
    }

    body {
      font-family: var(--sans);
      background: var(--bg);
      color: var(--text);
      line-height: 1.6;
      letter-spacing: -0.011em;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
      overflow-x: hidden;
    }

    ::selection {
      background: var(--red-dim);
      color: #fff;
    }

    ::-webkit-scrollbar {
      width: 10px;
    }

    ::-webkit-scrollbar-track {
      background: var(--bg);
    }

    ::-webkit-scrollbar-thumb {
      background: #2a2a30;
      border-radius: 8px;
    }

    ::-webkit-scrollbar-thumb:hover {
      background: #3a3a42;
    }

    a {
      color: var(--text);
      text-decoration: none;
    }

    /* ── NAV ── */
    nav {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      z-index: 100;
      padding: 0.7rem 1.5rem;
      background: rgba(10, 10, 10, 0.6);
      backdrop-filter: blur(18px) saturate(180%);
      -webkit-backdrop-filter: blur(18px) saturate(180%);
      border-bottom: 1px solid var(--hairline);
    }

    .nav-inner {
      max-width: 1200px;
      margin: 0 auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .logo {
      display: inline-flex;
      align-items: center;
      gap: 0.55rem;
      font-family: var(--sans);
      font-size: 0.98rem;
      font-weight: 600;
      color: var(--text);
      text-decoration: none;
      letter-spacing: -0.01em;
    }

    .logo-dot {
      width: 10px;
      height: 10px;
      border-radius: 2px;
      background: var(--red);
      box-shadow: 0 0 12px rgba(255, 99, 99, 0.4);
      display: inline-block;
    }

    .nav-links {
      display: flex;
      gap: 1.75rem;
      list-style: none;
    }

    .nav-links a {
      color: var(--text-muted);
      font-size: 0.85rem;
      font-weight: 500;
      transition: color 0.2s;
    }

    .nav-links a:hover {
      color: var(--text);
    }

    .nav-cta {
      background: var(--red);
      color: #fff !important;
      padding: 0.45rem 0.9rem;
      border-radius: 8px;
      font-size: 0.82rem;
      font-weight: 500;
      border: 1px solid rgba(255, 255, 255, 0.12);
      box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.2),
        var(--glow-red-soft);
      transition: background 0.2s;
    }

    .nav-cta:hover {
      background: var(--red-hot);
      color: #fff !important;
    }

    /* ── BUTTONS ── */
    .btn-primary {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.8rem 1.3rem;
      border-radius: 10px;
      background: var(--red);
      color: #fff;
      font-weight: 500;
      font-size: 0.92rem;
      border: 1px solid rgba(255, 255, 255, 0.12);
      box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.25),
        0 1px 2px rgba(0, 0, 0, 0.4),
        0 0 30px rgba(255, 99, 99, 0.35);
      transition: transform 0.15s, box-shadow 0.2s, background 0.2s;
    }

    .btn-primary:hover {
      background: var(--red-hot);
      color: #fff;
      transform: translateY(-1px);
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.3), 0 0 50px rgba(255, 99, 99, 0.5);
    }

    .btn-secondary {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.8rem 1.3rem;
      border-radius: 10px;
      background: var(--surface);
      color: var(--text);
      border: 1px solid var(--hairline);
      font-weight: 500;
      font-size: 0.92rem;
      transition: background 0.2s, border-color 0.2s;
    }

    .btn-secondary:hover {
      background: var(--surface-2);
      border-color: var(--hairline-strong);
    }

    /* ── SECTION HELPERS ── */
    section {
      padding: 7rem 2rem;
      position: relative;
    }

    .container {
      max-width: 1200px;
      margin: 0 auto;
      position: relative;
    }

    .badge,
    .step-number {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      font-family: var(--mono);
      font-size: 0.7rem;
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--red);
      background: var(--red-dim);
      padding: 0.3rem 0.6rem;
      border-radius: 6px;
      margin-bottom: 1rem;
    }

    .section-title {
      font-family: var(--sans);
      font-weight: 700;
      font-size: clamp(2rem, 4.4vw, 3.2rem);
      color: var(--text);
      margin-bottom: 1rem;
      letter-spacing: -0.028em;
      line-height: 1.05;
    }

    .section-title em,
    .hero h1 em,
    .cta-section h2 em {
      font-style: normal;
      background: linear-gradient(180deg, #FFA48A 0%, #FF6363 100%);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }

    .hairline {
      height: 1px;
      background: var(--hairline);
      border: 0;
    }

    /* dotted grid overlay helper */
    .grid-bg {
      position: absolute;
      inset: 0;
      pointer-events: none;
      background-image: radial-gradient(rgba(255, 255, 255, 0.05) 1px, transparent 1px);
      background-size: 24px 24px;
      -webkit-mask-image: radial-gradient(ellipse at center, #000 30%, transparent 75%);
      mask-image: radial-gradient(ellipse at center, #000 30%, transparent 75%);
    }

    /* aurora bloom (applied via .aurora on sections) */
    .aurora::before {
      content: '';
      position: absolute;
      inset: 0;
      pointer-events: none;
      background:
        radial-gradient(ellipse 60% 50% at 50% 0%, rgba(255, 99, 99, 0.35), transparent 60%),
        radial-gradient(ellipse 80% 50% at 50% 30%, rgba(255, 140, 80, 0.22), transparent 70%),
        radial-gradient(ellipse 50% 30% at 20% 60%, rgba(255, 99, 99, 0.12), transparent 70%);
    }

    .aurora::after {
      content: '';
      position: absolute;
      left: 0;
      right: 0;
      bottom: 0;
      height: 200px;
      pointer-events: none;
      background: linear-gradient(to top, var(--bg), transparent);
    }

    /* ── HERO ── */
    .hero {
      min-height: 100vh;
      padding: 9rem 2rem 6rem;
      display: flex;
      align-items: center;
      overflow: hidden;
    }

    .hero-grid {
      max-width: 1200px;
      margin: 0 auto;
      position: relative;
      z-index: 2;
    }

    .hero h1 {
      font-family: var(--sans);
      font-weight: 800;
      font-size: clamp(3rem, 9vw, 6.5rem);
      color: var(--text);
      line-height: 1;
      letter-spacing: -0.05em;
      margin-bottom: 2.5rem;
    }

    .hero p {
      font-size: 1.2rem;
      color: var(--text-muted);
      max-width: 640px;
      margin: 0 0 3rem;
      line-height: 1.6;
    }

    .hero-actions {
      display: flex;
      gap: 0.75rem;
      flex-wrap: wrap;
    }

    /* showcase (mock dashboard) */
    .showcase {
      padding: 4rem 2rem 8rem;
      background: var(--bg);
      position: relative;
      overflow: hidden;
    }

    .showcase-header {
      max-width: 940px;
      margin: 0 0 4rem;
    }

    .showcase-header p {
      color: var(--text-muted);
      font-size: 1.02rem;
      margin-top: 0.75rem;
    }

    .showcase-cards {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1.1rem;
    }

    .showcase-card {
      background: var(--surface);
      border: 1px solid var(--hairline);
      border-radius: var(--r-lg);
      padding: 1.5rem;
      display: flex;
      flex-direction: column;
      gap: 0.85rem;
      text-decoration: none;
      transition: border-color .2s, transform .2s, box-shadow .2s;
    }

    .showcase-card:hover {
      border-color: var(--hairline-strong);
      transform: translateY(-2px);
      box-shadow: var(--glow-red-soft);
    }

    .showcase-card h3 {
      font: 600 1.05rem/1.2 var(--sans);
      letter-spacing: -0.015em;
      color: var(--text);
      margin: 0;
    }

    .showcase-card .tagline {
      font: 500 .72rem/1 var(--mono);
      text-transform: uppercase;
      letter-spacing: .08em;
      color: var(--text-muted);
    }

    /* Footnote at the bottom of each showcase card: small dot + label.
       Replaces the old status pill, which broke layout on narrow widths. */
    .showcase-foot {
      margin-top: auto;
      padding-top: 0.85rem;
      border-top: 1px solid var(--hairline);
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      font-family: var(--mono);
      font-size: 0.65rem;
      font-weight: 500;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--text-dim);
    }
    .showcase-foot .dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      flex-shrink: 0;
      background: var(--text-dim);
    }
    .showcase-foot.live { color: var(--red); }
    .showcase-foot.live .dot {
      background: var(--red);
      box-shadow: 0 0 8px var(--red);
    }
    .showcase-foot.muted { color: var(--text-muted); }
    .showcase-foot.muted .dot { background: var(--text-muted); }
    .showcase-foot.experimental { color: #f59e0b; }
    .showcase-foot.experimental .dot {
      background: #f59e0b;
      box-shadow: 0 0 8px #f59e0b;
    }

    .status-badge {
      display: inline-flex;
      align-items: center;
      gap: .4rem;
      font: 500 .68rem/1 var(--mono);
      letter-spacing: .08em;
      text-transform: uppercase;
      padding: .35rem .6rem;
      border-radius: 6px;
      border: 1px solid var(--hairline);
      color: var(--text-muted);
      width: fit-content;
    }

    .status-badge.live {
      color: var(--red);
      background: var(--red-dim);
      border-color: transparent;
    }

    .status-badge.live::before {
      content: '';
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--red);
      box-shadow: 0 0 8px var(--red);
    }

    .showcase-cta {
      margin-top: 2.5rem;
      display: inline-flex;
      align-items: center;
      gap: .4rem;
      color: var(--text-muted);
      font-weight: 500;
      font-size: .92rem;
      transition: color .2s, gap .2s;
    }

    .showcase-cta:hover {
      color: var(--red);
      gap: .65rem;
    }

    /* ── STATS ── */
    .stats-bar {
      padding: 4rem 2rem;
      background: var(--bg);
      border-top: 1px solid var(--hairline);
      position: relative;
    }

    .stats-inner {
      max-width: 1000px;
      margin: 0 auto;
      text-align: center;
    }

    .stats-quote {
      font-family: var(--sans);
      font-weight: 500;
      font-style: italic;
      font-size: 1.3rem;
      color: var(--text);
      max-width: 720px;
      margin: 0 auto 2.5rem;
      line-height: 1.5;
      letter-spacing: -0.015em;
    }

    .stats-row {
      display: flex;
      justify-content: center;
      gap: 4.5rem;
      flex-wrap: wrap;
    }

    .stat-item {
      text-align: center;
    }

    .stat-item h3 {
      font-family: var(--mono);
      font-size: 2.6rem;
      font-weight: 500;
      background: linear-gradient(180deg, #fff 0%, #FF6363 130%);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
      letter-spacing: -0.02em;
      line-height: 1.1;
    }

    .stat-item p {
      font-family: var(--mono);
      font-size: 0.7rem;
      color: var(--text-dim);
      margin-top: 0.55rem;
      text-transform: uppercase;
      letter-spacing: 0.12em;
    }

    /* ── ABOUT ── */
    .about {
      background: var(--bg-elev);
    }

    .about-grid {
      margin: 0;
    }

    .about-text {
      max-width: 720px;
      margin: 0 0 5rem;
    }

    .about-text p {
      color: var(--text-muted);
      margin-bottom: 1.1rem;
      font-size: 1.02rem;
      line-height: 1.7;
    }

    .about-cards {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1rem;
    }

    .about-card {
      background: var(--surface);
      border: 1px solid var(--hairline);
      border-radius: var(--r-lg);
      padding: 1.4rem;
      transition: border-color 0.2s, transform 0.2s, box-shadow 0.2s;
    }

    .about-card:hover {
      border-color: var(--hairline-strong);
      transform: translateY(-2px);
      box-shadow: var(--glow-red-soft);
    }

    .about-card .card-icon {
      width: 36px;
      height: 36px;
      border-radius: var(--r-sm);
      background: var(--surface-2);
      border: 1px solid var(--hairline);
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 0.85rem;
      color: var(--red);
    }

    .about-card .card-icon .icon-svg {
      width: 18px;
      height: 18px;
    }

    .about-card h4 {
      font-size: 0.96rem;
      font-weight: 600;
      margin-bottom: 0.3rem;
      color: var(--text);
      letter-spacing: -0.01em;
    }

    .about-card p {
      font-size: 0.84rem;
      color: var(--text-muted);
      line-height: 1.55;
    }

    /* ── HOW IT WORKS ── */
    .how-it-works {
      background: var(--bg);
    }

    .how-header {
      margin-bottom: 4rem;
      max-width: 720px;
    }

    .how-header p {
      color: var(--text-muted);
      margin: 0.75rem 0 0;
    }

    .steps-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.25rem;
      max-width: 1000px;
      margin: 0;
    }

    .step {
      background: var(--surface);
      border: 1px solid var(--hairline);
      border-radius: var(--r-lg);
      padding: 1.5rem;
      transition: border-color 0.2s, transform 0.2s, box-shadow 0.2s;
    }

    .step:hover {
      border-color: var(--hairline-strong);
      transform: translateY(-2px);
      box-shadow: var(--glow-red-soft);
    }

    .step h3 {
      font-family: var(--sans);
      font-weight: 600;
      font-size: 1.1rem;
      color: var(--text);
      margin-bottom: 0.4rem;
      letter-spacing: -0.015em;
    }

    .step p {
      font-size: 0.9rem;
      color: var(--text-muted);
      line-height: 1.6;
    }

    /* ── BENTO ── */
    .bento-section {
      background: var(--bg-elev);
    }

    .bento-header {
      margin-bottom: 4rem;
      max-width: 720px;
    }

    .bento-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 1.25rem;
      max-width: 900px;
      margin: 0;
    }

    .bento-card {
      background: var(--surface);
      border: 1px solid var(--hairline);
      border-radius: var(--r-lg);
      padding: 1.6rem;
      position: relative;
      overflow: hidden;
      transition: border-color 0.2s, transform 0.2s, box-shadow 0.2s;
    }

    .bento-card:hover {
      border-color: var(--hairline-strong);
      transform: translateY(-2px);
      box-shadow: var(--glow-red-soft);
    }

    .bento-card>*:not(.grid-bg) {
      position: relative;
      z-index: 1;
    }

    .bento-card .bento-icon {
      width: 32px;
      height: 32px;
      border-radius: var(--r-sm);
      background: var(--surface-2);
      border: 1px solid var(--hairline);
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 0.9rem;
      color: var(--red);
    }

    .bento-card .bento-icon .icon-svg {
      width: 16px;
      height: 16px;
    }

    .bento-card h3 {
      font-family: var(--sans);
      font-weight: 600;
      font-size: 1.05rem;
      color: var(--text);
      margin-bottom: 0.4rem;
      letter-spacing: -0.015em;
    }

    .bento-card p {
      font-size: 0.88rem;
      color: var(--text-muted);
      line-height: 1.6;
    }

    .bento-card .big-stat {
      font-family: var(--mono);
      font-weight: 500;
      font-size: 3.2rem;
      line-height: 1.1;
      letter-spacing: -0.03em;
      background: linear-gradient(180deg, #fff 0%, #FF6363 130%);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
      margin-bottom: 0.6rem;
    }

    .bento-card.bento-feature::before {
      content: '';
      position: absolute;
      top: -40%;
      right: -25%;
      width: 80%;
      height: 130%;
      background: radial-gradient(circle at top right, rgba(255, 99, 99, 0.4), transparent 65%);
      pointer-events: none;
      z-index: 0;
    }

    /* ── PRODUCTS ── */
    .products-section {
      background: var(--bg);
    }

    .products-header {
      margin-bottom: 4rem;
      max-width: 720px;
    }

    .products-header p {
      color: var(--text-muted);
      margin: 0.75rem 0 0;
    }

    .products-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 1.25rem;
    }

    .product-card {
      background: var(--surface);
      border: 1px solid var(--hairline);
      border-radius: var(--r-lg);
      overflow: hidden;
      transition: border-color 0.2s, transform 0.2s, box-shadow 0.2s;
    }

    .product-card:hover {
      border-color: var(--hairline-strong);
      transform: translateY(-3px);
      box-shadow: var(--glow-red-soft);
    }

    .product-card-img {
      width: 100%;
      aspect-ratio: 4/3;
      background: var(--surface-2);
      border-bottom: 1px solid var(--hairline);
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      overflow: hidden;
    }

    .product-card-img::before {
      content: '';
      position: absolute;
      inset: 0;
      background: radial-gradient(circle at center, rgba(255, 99, 99, 0.18), transparent 60%);
      pointer-events: none;
    }

    .product-card-img>.icon-svg {
      position: relative;
      z-index: 1;
      color: var(--red);
      filter: drop-shadow(0 0 18px rgba(255, 99, 99, 0.35));
    }

    /* Real product screenshots / mockups. Sits on the dark surface-2
       backdrop with a subtle inset so each image breathes. Different
       source aspect ratios (square dashboard, portrait quote card,
       angled phone mockup) all read consistently via object-fit:contain. */
    .product-card-img>img {
      position: relative;
      z-index: 1;
      width: 100%;
      height: 100%;
      object-fit: contain;
      padding: 1.5rem;
      filter: drop-shadow(0 12px 30px rgba(0, 0, 0, 0.45));
    }

    /* Browser-frame treatment for SaaS / web products. Wraps a light
       screenshot inside a dark macOS-style window so the white UI feels
       intentional on the dark page instead of fighting the theme. */
    .product-card-img.has-browser {
      padding: 1.25rem;
    }
    .product-card-img.has-browser>.browser {
      position: relative;
      z-index: 1;
      width: 100%;
      height: 100%;
      background: #ffffff;
      border-radius: 8px;
      overflow: hidden;
      border: 1px solid var(--hairline-strong);
      box-shadow: 0 14px 32px rgba(0, 0, 0, 0.5);
      display: flex;
      flex-direction: column;
    }
    .browser-bar {
      background: var(--bg-elev);
      padding: 0.45rem 0.7rem;
      display: flex;
      align-items: center;
      gap: 0.35rem;
      border-bottom: 1px solid var(--hairline);
      flex-shrink: 0;
    }
    .browser-bar>span {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      flex-shrink: 0;
    }
    .browser-bar>span:nth-child(1) { background: #ff5f57; }
