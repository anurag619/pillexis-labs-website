---
import BaseLayout from '../layouts/BaseLayout.astro';
import BookingScripts from '../components/BookingScripts.astro';
import SiteNav from '../components/SiteNav.astro';

const title = "Work with us · Pillexis Labs";
const description = "Three focused engagements. One operator. We sort the AI mess, the ops mess, and legacy code for Indian D2C teams who've outgrown their stack.";

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Pillexis Labs · Sprint engagements',
  description,
  url: 'https://pillexislabs.com/',
  provider: {
    '@type': 'Organization',
    name: 'Pillexis Labs',
    url: 'https://pillexislabs.com',
  },
  serviceType: 'AI, operations, and legacy application modernization engagements',
  areaServed: { '@type': 'Country', name: 'India' },
  potentialAction: {
    '@type': 'ReserveAction',
    target: 'https://cal.com/pillexislabs/pillexis-labs-intro-call',
    result: { '@type': 'Reservation', name: '20-minute intro call' },
  },
};
---

<BaseLayout title={title} description={description} path="/" jsonLd={jsonLd}>
  <style is:global>

    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

    html { scroll-behavior: smooth; background: var(--bg); }
    body {
      font-family: var(--sans);
      background: var(--bg);
      color: var(--text);
      line-height: 1.6;
      letter-spacing: -0.011em;
      -webkit-font-smoothing: antialiased;
      overflow-x: clip;
    }
    ::selection { background: var(--red-dim); color: #fff; }

    a { color: var(--text); text-decoration: none; }

    /* ── NAV ── */
    nav {
      position: fixed; top: 0; left: 0; right: 0; z-index: 100;
      padding: 0.7rem 1.5rem;
      background: rgba(10, 10, 10, 0.6);
      backdrop-filter: blur(18px) saturate(180%);
      -webkit-backdrop-filter: blur(18px) saturate(180%);
      border-bottom: 1px solid var(--hairline);
    }
    .nav-inner {
      max-width: var(--layout-max); margin: 0 auto;
      display: flex; align-items: center; justify-content: space-between;
    }
    .logo {
      display: inline-flex; align-items: center; gap: 0.55rem;
      font-size: 0.98rem; font-weight: 600; color: var(--text);
      letter-spacing: -0.01em;
    }
    .logo-dot {
      width: 10px; height: 10px; border-radius: 2px;
      background: var(--red);
      box-shadow: 0 0 12px rgba(255, 99, 99, 0.4);
    }
    .nav-links { display: flex; gap: 1.75rem; list-style: none; }
    .nav-links a {
      color: var(--text-muted); font-size: 0.85rem; font-weight: 500;
      transition: color 0.2s;
    }
    .nav-links a:hover { color: var(--text); }
    .nav-cta {
      background: var(--red);
      color: #fff !important;
      padding: 0.45rem 0.9rem;
      border-radius: 8px;
      font-size: 0.82rem; font-weight: 500;
      border: 1px solid rgba(255, 255, 255, 0.12);
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.2), var(--glow-red-soft);
      transition: background 0.2s;
    }
    .nav-cta:hover { background: var(--red-hot); }

    /* ── BUTTONS ── */
    .btn-primary {
      display: inline-flex; align-items: center; gap: 0.5rem;
      padding: 0.95rem 1.6rem;
      border-radius: 10px;
      background: var(--red);
      color: #fff;
      font-weight: 500; font-size: 0.98rem;
      border: 1px solid rgba(255, 255, 255, 0.12);
      box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.25),
        0 1px 2px rgba(0, 0, 0, 0.4),
        0 0 30px rgba(255, 99, 99, 0.35);
      transition: transform 0.15s, box-shadow 0.2s, background 0.2s;
    }
    .btn-primary:hover {
      background: var(--red-hot); color: #fff;
      transform: translateY(-1px);
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.3), 0 0 50px rgba(255, 99, 99, 0.5);
    }
    .btn-secondary {
      display: inline-flex; align-items: center; gap: 0.5rem;
      padding: 0.95rem 1.6rem;
      border-radius: 10px;
      background: var(--surface);
      color: var(--text);
      border: 1px solid var(--hairline);
      font-weight: 500; font-size: 0.98rem;
      transition: background 0.2s, border-color 0.2s;
    }
    .btn-secondary:hover { background: var(--surface-2); border-color: var(--hairline-strong); }

    /* ── SECTION ── */
    section { padding: 5rem 2rem; }
    .container { max-width: var(--layout-max); margin: 0 auto; }
    .eyebrow {
      font-family: var(--mono);
      font-size: 0.72rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--text-dim);
      font-weight: 500;
      margin-bottom: 1.2rem;
    }
    .section-title {
      font-weight: 800;
      font-size: clamp(2.2rem, 4.5vw, 3.6rem);
      letter-spacing: -0.04em;
      line-height: 1.05;
      margin-bottom: 1.2rem;
    }
    .section-title em {
      font-style: normal;
      color: var(--peach);
      text-decoration: underline;
      text-decoration-color: var(--red);
      text-decoration-thickness: 2px;
      text-underline-offset: 0.12em;
    }
    .section-sub {
      font-size: 1.1rem;
      color: var(--text-muted);
      max-width: 640px;
      line-height: 1.6;
      margin-bottom: 2rem;
    }

    /* ── HERO ── */
    .hero {
      padding: 8rem 2rem 4.5rem;
      position: relative;
      overflow: hidden;
    }
    .hero::before {
      content: '';
      position: absolute;
      inset: 0;
      pointer-events: none;
      background:
        radial-gradient(circle at 72% 18%, rgba(255, 99, 99, 0.14), transparent 42%),
        radial-gradient(circle at 30% 80%, rgba(255, 140, 80, 0.08), transparent 55%);
    }
    .grid-bg {
      position: absolute; inset: 0; pointer-events: none; opacity: 0.4;
      background-image: radial-gradient(var(--hairline) 1px, transparent 1px);
      background-size: 24px 24px;
      mask-image: linear-gradient(180deg, #000 0%, transparent 70%);
    }
    .hero-inner {
      position: relative;
      max-width: var(--layout-max);
      margin: 0 auto;
      display: grid;
      grid-template-columns: minmax(0, 1.05fr) minmax(360px, 0.95fr);
      gap: clamp(3rem, 7vw, 6rem);
      align-items: center;
    }
    .hero-copy { min-width: 0; }

    .hero h1 {
      font-weight: 900;
      font-size: clamp(2.6rem, 6vw, 4.8rem);
      letter-spacing: -0.04em;
      line-height: 1.02;
      margin-bottom: 1.8rem;
      max-width: 700px;
      overflow-wrap: anywhere;
    }
    .hero h1 em {
      font-style: normal;
      color: var(--peach);
      text-decoration: underline;
      text-decoration-color: var(--red);
      text-decoration-thickness: 3px;
      text-underline-offset: 0.12em;
    }
    .hero-sub {
      font-size: 1.2rem;
      color: var(--text-muted);
      max-width: 540px;
      line-height: 1.55;
      margin-bottom: 2.5rem;
    }
    .hero-cta-row { display: flex; gap: 0.85rem; flex-wrap: wrap; }

    .hero-receipts {
      margin-top: 3rem;
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      padding-top: 1.5rem;
      border-top: 1px solid var(--hairline);
    }
    .hero-receipt {
      min-width: 0;
      padding-right: 1rem;
    }
    .hero-receipt + .hero-receipt {
      padding-left: 1rem;
      border-left: 1px solid var(--hairline);
    }
    .hero-receipt .num {
      font-weight: 800;
      font-size: clamp(1.35rem, 2.2vw, 2rem);
      letter-spacing: -0.03em;
      line-height: 1;
      color: var(--text);
      font-variant-numeric: tabular-nums;
    }
    .hero-receipt .label {
      font-family: var(--mono);
      font-size: 0.64rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--text-dim);
      margin-top: 0.6rem;
    }
    .hero-visual {
      position: relative;
      min-width: 0;
      width: 100%;
      max-width: 520px;
      justify-self: end;
    }
    .hero-visual::before {
      content: '';
      position: absolute;
      inset: -18px 12px 18px -12px;
      border: 1px solid var(--hairline);
      border-radius: var(--r-md);
      pointer-events: none;
    }
    .hero-visual figure {
      position: relative;
      margin: 0;
      overflow: hidden;
      background: var(--surface);
      border: 1px solid var(--hairline-strong);
      border-radius: var(--r-md);
      width: 100%;
    }
    .hero-visual img {
      display: block;
      width: 100%;
      max-width: 100%;
      height: 650px;
      aspect-ratio: 4 / 5;
      object-fit: cover;
    }
    .hero-visual figcaption {
      position: absolute;
      inset: auto 0 0;
      display: flex;
      justify-content: space-between;
      gap: 1rem;
      padding: 0.85rem 1rem;
      background: rgba(10, 10, 10, 0.86);
      border-top: 1px solid var(--hairline);
      color: var(--text-muted);
      font-family: var(--mono);
      font-size: 0.64rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }

    /* Hallmark · component: ownership ledger · genre: modern-minimal · theme: Pillexis light
       states: default · hover · focus · active · disabled · loading · error · success
       contrast: pass · pre-emit critique: P5 H5 E5 S5 R5 V5 */
    .receipts { background: var(--bg); }
    .ownership-head {
      display: grid;
      grid-template-columns: minmax(0, 1.15fr) minmax(280px, 0.7fr);
      align-items: end;
      gap: 3rem;
      margin-bottom: 3rem;
    }
    .ownership-title {
      margin: 0;
      max-width: 760px;
      font-size: clamp(2.8rem, 6vw, 5.2rem);
      font-weight: 800;
      letter-spacing: -0.055em;
      line-height: 0.98;
      overflow-wrap: anywhere;
      min-width: 0;
    }
    .ownership-title span { color: var(--red); }
    .ownership-intro {
      max-width: 52ch;
      margin: 0 0 0.35rem;
      color: var(--text-muted);
      font-size: 1.1rem;
      line-height: 1.65;
    }
    .ownership-ledger {
      overflow: clip;
      background: var(--surface);
      border: 1px solid var(--hairline);
      border-radius: var(--r-lg);
      box-shadow: var(--shadow-card);
    }
    .ownership-ledger-head,
    .ownership-row {
      display: grid;
      grid-template-columns: 72px minmax(180px, 0.72fr) minmax(0, 1.3fr) 88px;
      align-items: center;
      column-gap: 1.5rem;
    }
    .ownership-ledger-head {
      min-height: 48px;
      padding: 0 2rem;
      border-bottom: 1px solid var(--hairline);
      color: var(--text-dim);
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 0.04em;
    }
    .ownership-ledger-head span:last-child { text-align: right; }
    .ownership-row {
      min-height: 126px;
      padding: 1.5rem 2rem;
      border-bottom: 1px solid var(--hairline);
    }
    .ownership-row:last-child { border-bottom: 0; }
    .ownership-index {
      color: var(--text-dim);
      font-size: 0.8rem;
      font-weight: 600;
      font-variant-numeric: tabular-nums;
    }
    .ownership-row h3 {
      margin: 0;
      font-size: clamp(1.08rem, 2vw, 1.35rem);
      font-weight: 700;
      letter-spacing: -0.025em;
      line-height: 1.2;
      overflow-wrap: anywhere;
      min-width: 0;
    }
    .ownership-row p {
      max-width: 64ch;
      margin: 0;
      color: var(--text-muted);
      font-size: 0.95rem;
      line-height: 1.55;
    }
    .ownership-owner {
      justify-self: end;
      color: var(--red);
      font-size: 0.8rem;
      font-weight: 600;
    }
    .reference-note {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1.5rem;
      margin-top: 1rem;
      padding: 1rem 1.25rem;
      background: var(--surface);
      border: 1px solid var(--hairline);
      border-radius: var(--r-md);
    }
    .reference-note p {
      max-width: 68ch;
      margin: 0;
      color: var(--text-muted);
      font-size: 0.9rem;
      line-height: 1.55;
    }
    .reference-link {
      flex-shrink: 0;
      color: var(--red);
      font-size: 0.88rem;
      font-weight: 600;
      white-space: nowrap;
      transition: color 0.2s, transform 0.15s;
    }
    .reference-link:hover { color: var(--red-hot); }
    .reference-link:focus-visible { outline: 2px solid var(--red); outline-offset: 4px; }
    .reference-link:active { transform: translateY(1px); }
    .reference-link[aria-disabled='true'] { cursor: not-allowed; opacity: 0.55; }
    .ownership-handover {
      display: grid;
      grid-template-columns: minmax(220px, 0.7fr) minmax(0, 1.3fr);
      gap: 3rem;
      align-items: start;
      margin-top: 1rem;
      padding: 2rem;
      background: var(--surface-2);
      border: 1px solid var(--hairline);
      border-radius: var(--r-md);
    }
    .ownership-handover-copy {
      margin: 0;
      color: var(--text-muted);
      font-size: 0.9rem;
      line-height: 1.55;
    }
    .ownership-handover-copy strong {
      display: block;
      margin-bottom: 0.5rem;
      color: var(--text);
      font-size: 1.02rem;
      font-weight: 700;
    }
    .ownership-steps {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      margin: 0;
      padding: 0;
      list-style: none;
    }
    .ownership-step {
      min-width: 0;
      padding: 0 1rem;
      border-left: 1px solid var(--hairline);
    }
    .ownership-step:first-child { padding-left: 0; border-left: 0; }
    .ownership-step:last-child { padding-right: 0; }
    .ownership-step span {
      display: block;
      margin-bottom: 0.5rem;
      color: var(--red);
      font-size: 0.72rem;
      font-weight: 700;
    }
    .ownership-step strong {
      display: block;
      color: var(--text);
      font-size: 0.88rem;
      font-weight: 600;
      line-height: 1.35;
    }
    /* ── OUR OWN PRODUCTS ── */
    .own-products { background: var(--bg); }
    .own-products-grid {
      display: flex;
      flex-direction: column;
      margin-top: 3rem;
      border-top: 1px solid var(--hairline);
    }
    .own-product-card {
      background: transparent;
      border: 0;
      border-bottom: 1px solid var(--hairline);
      border-radius: 0;
      padding: 2rem 1.25rem;
      display: grid;
      grid-template-columns: minmax(150px, 0.55fr) 168px minmax(0, 1.25fr) minmax(175px, 0.65fr);
      grid-template-areas:
        "name preview outcome meta"
        "features preview outcome meta";
      align-items: start;
      gap: 0.75rem 2.5rem;
      color: var(--text);
      text-decoration: none;
      position: relative;
      isolation: isolate;
      transition: background 0.25s, transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .own-product-card:hover,
    .own-product-card:focus-visible {
      background: var(--surface);
      transform: translateX(4px);
    }
    .own-product-card:focus-visible { outline: 2px solid var(--red); outline-offset: 3px; }
    .own-product-card-static { cursor: default; }

    .own-product-preview {
      grid-area: preview;
      align-self: stretch;
      min-height: 112px;
      overflow: hidden;
      border: 1px solid var(--hairline);
      border-radius: var(--r-md);
      background: var(--surface-2);
      opacity: 0.34;
      transform: translateX(14px) scale(0.97);
      transition: opacity 0.35s, transform 0.55s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.25s;
    }
    .own-product-preview img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      filter: grayscale(0.55) saturate(0.72);
      transition: transform 0.65s cubic-bezier(0.16, 1, 0.3, 1), filter 0.35s;
    }
    .own-product-preview--migraine img { object-fit: contain; padding: 0.4rem; }
    .own-product-preview--tether img { object-fit: cover; object-position: center; }
    .own-product-preview--forge {
      display: grid;
      place-items: center;
      color: var(--red);
      background: var(--bg-elev);
    }
    .own-product-preview--forge svg { width: 80%; height: 80%; }
    .own-product-preview--forge path { fill: none; stroke: var(--hairline-strong); stroke-width: 1; }
    .own-product-preview--forge circle { fill: var(--surface-2); stroke: currentColor; stroke-width: 1.5; }
    .own-product-card:is(:hover, :focus-visible) .own-product-preview {
      opacity: 1;
      transform: translateX(0) scale(1);
      border-color: var(--hairline-strong);
    }
    .own-product-card:is(:hover, :focus-visible) .own-product-preview img {
      filter: grayscale(0) saturate(1);
      transform: scale(1.035);
    }
    .own-product-card:is(:hover, :focus-visible) .own-product-preview--migraine img { transform: scale(1); }
    .own-product-card:is(:hover, :focus-visible) .own-product-name { color: var(--peach); }

    .own-product-meta {
      grid-area: meta;
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      gap: 0.75rem;
    }
    .own-product-status {
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      font-family: var(--mono);
      font-size: 0.66rem;
      font-weight: 500;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      padding: 0.35rem 0.7rem;
      border-radius: 7px;
      border: 1px solid var(--hairline);
      color: var(--text-muted);
      background: var(--surface-2);
    }
    .own-product-status .dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--text-muted);
    }
    .own-product-status.live {
      color: var(--red);
      background: rgba(255, 99, 99, 0.1);
      border-color: rgba(255, 99, 99, 0.28);
    }
    .own-product-status.live .dot {
      background: var(--red);
    }
    .own-product-status.muted {
      color: var(--text-muted);
    }
    .own-product-status.experimental {
      color: #f59e0b;
      background: rgba(245, 158, 11, 0.10);
      border-color: rgba(245, 158, 11, 0.28);
    }
    .own-product-status.experimental .dot {
      background: #f59e0b;
    }
    .own-product-host {
      font-family: var(--mono);
      font-size: 0.7rem;
      letter-spacing: 0.06em;
      color: var(--text-dim);
    }
    .own-product-card:not(.own-product-card-static):hover .own-product-host {
      color: var(--red);
    }

    .own-product-name {
      grid-area: name;
      font-family: var(--sans);
      font-weight: 700;
      font-size: 1.35rem;
      letter-spacing: -0.02em;
      color: var(--text);
      transition: color 0.25s;
    }
    .own-product-outcome {
      grid-area: outcome;
      color: var(--text-muted);
      font-size: 0.98rem;
      line-height: 1.55;
    }
    .own-product-features {
      grid-area: features;
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
      margin-top: 0;
      padding-top: 0;
    }
    .own-product-features span {
      font-family: var(--mono);
      font-size: 0.66rem;
      letter-spacing: 0.06em;
      color: var(--text-muted);
      padding: 0.3rem 0;
      border-bottom: 1px solid var(--hairline);
    }

    /* Hallmark · component: service decision canvas · genre: modern-minimal · theme: Pillexis light
       states: default · hover · focus · active · disabled · selected · loading · error · success
       contrast: pass · pre-emit critique: P5 H5 E5 S5 R5 V5 */
    .sprints {
      background: var(--bg-elev);
    }
    .service-decision {
      display: grid;
      grid-template-columns: minmax(400px, 0.86fr) minmax(0, 1.14fr);
      gap: 1px;
      overflow: clip;
      background: var(--hairline-strong);
      border: 1px solid var(--hairline-strong);
      border-radius: var(--r-lg);
      box-shadow: var(--shadow-card);
    }
    .service-question,
    .service-answer {
      min-width: 0;
      background: var(--surface);
    }
    .service-question {
      padding: 2.5rem;
    }
    .services-kicker {
      display: block;
      margin-bottom: 1rem;
      font-family: var(--mono);
      font-size: 0.68rem;
      font-weight: 600;
      letter-spacing: 0.04em;
      color: var(--red);
    }
    .service-question .section-title {
      margin-bottom: 1rem;
      font-size: clamp(2.25rem, 4.2vw, 3.6rem);
      overflow-wrap: anywhere;
      min-width: 0;
    }
    .service-question .section-sub {
      margin-bottom: 2rem;
      font-size: 1rem;
    }
    .service-choices {
      display: grid;
      gap: 0.5rem;
    }
    .service-choice {
      display: grid;
      grid-template-columns: 32px minmax(0, 1fr);
      gap: 0.75rem;
      align-items: start;
      width: 100%;
      padding: 1rem;
      border: 1px solid transparent;
      border-radius: var(--r-sm);
      background: transparent;
      color: var(--text-muted);
      text-align: left;
      cursor: pointer;
      transition: background 0.18s, border-color 0.18s, color 0.18s, transform 0.15s;
    }
    .service-choice:hover {
      background: var(--surface-2);
      color: var(--text);
    }
    .service-choice:focus-visible {
      outline: 2px solid var(--red);
      outline-offset: 2px;
    }
    .service-choice:active { transform: translateY(1px); }
    .service-choice:disabled,
    .service-choice[aria-disabled='true'] {
      cursor: not-allowed;
      opacity: 0.55;
    }
    .service-choice[aria-selected='true'],
    .service-choice[data-state='success'] {
      background: var(--red-faint);
      border-color: var(--red-dim);
      color: var(--text);
    }
    .service-choice[data-state='loading'] { cursor: wait; opacity: 0.7; }
    .service-choice[data-state='error'] { border-color: var(--red); }
