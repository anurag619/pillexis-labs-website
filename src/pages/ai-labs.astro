---
import BaseLayout from '../layouts/BaseLayout.astro';
import BookingScripts from '../components/BookingScripts.astro';
import SiteNav from '../components/SiteNav.astro';

const title = "Pillexis Labs · Finding what AI can't build";
const description = "A research-driven product studio. We ship AI-built apps end-to-end, watch where they break, and turn the gaps into our next product. Right now, we're studying distribution.";

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Pillexis Labs',
  url: 'https://pillexislabs.com',
  description,
  sameAs: ['https://productlogz.com'],
};
---

<BaseLayout title={title} description={description} path="/ai-labs" jsonLd={jsonLd} hasSiteNav>
  <style is:global>

    *,
    *::before,
    *::after {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    :root {
      --bg: #0a0a0a;
      --bg-elev: #111114;
      --surface: #141417;
      --surface-2: #18181c;
      --hairline: rgba(255, 255, 255, 0.08);
      --hairline-strong: rgba(255, 255, 255, 0.14);

      --red: #FF6363;
      --red-hot: #FF4D4D;
      --red-dim: rgba(255, 99, 99, 0.18);
      --red-faint: rgba(255, 99, 99, 0.08);

      --text: #F5F5F7;
      --text-muted: #A1A1A6;
      --text-dim: #6E6E73;

      --sans: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      --mono: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace;

      --r-sm: 6px;
      --r-md: 10px;
      --r-lg: 14px;
      --r-xl: 20px;

      --shadow-card: 0 1px 0 rgba(255, 255, 255, 0.04) inset, 0 8px 24px rgba(0, 0, 0, 0.4);
      --glow-red: 0 0 80px 0 rgba(255, 99, 99, 0.35);
      --glow-red-soft: 0 0 40px 0 rgba(255, 99, 99, 0.18);
    }

    html {
      scroll-behavior: smooth;
      background: var(--bg);
    }

    body {
      font-family: var(--sans);
      background: var(--bg);
      color: var(--text);
      line-height: 1.6;
      letter-spacing: -0.011em;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
      overflow-x: hidden;
    }

    ::selection {
      background: var(--red-dim);
      color: #fff;
    }

    ::-webkit-scrollbar {
      width: 10px;
    }

    ::-webkit-scrollbar-track {
      background: var(--bg);
    }

    ::-webkit-scrollbar-thumb {
      background: #2a2a30;
      border-radius: 8px;
    }

    ::-webkit-scrollbar-thumb:hover {
      background: #3a3a42;
    }

    a {
      color: var(--text);
      text-decoration: none;
    }

    /* ── NAV ── */
    nav {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      z-index: 100;
      padding: 0.7rem 1.5rem;
      background: rgba(10, 10, 10, 0.6);
      backdrop-filter: blur(18px) saturate(180%);
      -webkit-backdrop-filter: blur(18px) saturate(180%);
      border-bottom: 1px solid var(--hairline);
    }

    .nav-inner {
      max-width: 1200px;
      margin: 0 auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .logo {
      display: inline-flex;
      align-items: center;
      gap: 0.55rem;
      font-family: var(--sans);
      font-size: 0.98rem;
      font-weight: 600;
      color: var(--text);
      text-decoration: none;
      letter-spacing: -0.01em;
    }

    .logo-dot {
      width: 10px;
      height: 10px;
      border-radius: 2px;
      background: var(--red);
      box-shadow: 0 0 12px rgba(255, 99, 99, 0.4);
      display: inline-block;
    }

    .nav-links {
      display: flex;
      gap: 1.75rem;
      list-style: none;
    }

    .nav-links a {
      color: var(--text-muted);
      font-size: 0.85rem;
      font-weight: 500;
      transition: color 0.2s;
    }

    .nav-links a:hover {
      color: var(--text);
    }

    .nav-cta {
      background: var(--red);
      color: #fff !important;
      padding: 0.45rem 0.9rem;
      border-radius: 8px;
      font-size: 0.82rem;
      font-weight: 500;
      border: 1px solid rgba(255, 255, 255, 0.12);
      box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.2),
        var(--glow-red-soft);
      transition: background 0.2s;
    }

    .nav-cta:hover {
      background: var(--red-hot);
      color: #fff !important;
    }

    /* ── BUTTONS ── */
    .btn-primary {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.8rem 1.3rem;
      border-radius: 10px;
      background: var(--red);
      color: #fff;
      font-weight: 500;
      font-size: 0.92rem;
      border: 1px solid rgba(255, 255, 255, 0.12);
      box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.25),
        0 1px 2px rgba(0, 0, 0, 0.4),
        0 0 30px rgba(255, 99, 99, 0.35);
      transition: transform 0.15s, box-shadow 0.2s, background 0.2s;
    }

    .btn-primary:hover {
      background: var(--red-hot);
      color: #fff;
      transform: translateY(-1px);
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.3), 0 0 50px rgba(255, 99, 99, 0.5);
    }

    .btn-secondary {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.8rem 1.3rem;
      border-radius: 10px;
      background: var(--surface);
      color: var(--text);
      border: 1px solid var(--hairline);
      font-weight: 500;
      font-size: 0.92rem;
      transition: background 0.2s, border-color 0.2s;
    }

    .btn-secondary:hover {
      background: var(--surface-2);
      border-color: var(--hairline-strong);
    }

    /* ── SECTION HELPERS ── */
    section {
      padding: 7rem 2rem;
      position: relative;
    }

    .container {
      max-width: 1200px;
      margin: 0 auto;
      position: relative;
    }

    .badge,
    .step-number {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      font-family: var(--mono);
      font-size: 0.7rem;
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--red);
      background: var(--red-dim);
      padding: 0.3rem 0.6rem;
      border-radius: 6px;
      margin-bottom: 1rem;
    }

    .section-title {
      font-family: var(--sans);
      font-weight: 700;
      font-size: clamp(2rem, 4.4vw, 3.2rem);
      color: var(--text);
      margin-bottom: 1rem;
      letter-spacing: -0.028em;
      line-height: 1.05;
    }

    .section-title em,
    .hero h1 em,
    .cta-section h2 em {
      font-style: normal;
      background: linear-gradient(180deg, #FFA48A 0%, #FF6363 100%);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }

    .hairline {
      height: 1px;
      background: var(--hairline);
      border: 0;
    }

    /* dotted grid overlay helper */
    .grid-bg {
      position: absolute;
      inset: 0;
      pointer-events: none;
      background-image: radial-gradient(rgba(255, 255, 255, 0.05) 1px, transparent 1px);
      background-size: 24px 24px;
      -webkit-mask-image: radial-gradient(ellipse at center, #000 30%, transparent 75%);
      mask-image: radial-gradient(ellipse at center, #000 30%, transparent 75%);
      animation: lab-grid-drift 22s linear infinite;
    }

    /* aurora bloom (applied via .aurora on sections) */
    .aurora::before {
      content: '';
      position: absolute;
      inset: 0;
      pointer-events: none;
      background:
        radial-gradient(ellipse 60% 50% at 50% 0%, rgba(255, 99, 99, 0.35), transparent 60%),
        radial-gradient(ellipse 80% 50% at 50% 30%, rgba(255, 140, 80, 0.22), transparent 70%),
        radial-gradient(ellipse 50% 30% at 20% 60%, rgba(255, 99, 99, 0.12), transparent 70%);
      transform-origin: 50% 25%;
      animation: lab-aurora-breathe 10s ease-in-out infinite alternate;
    }

    .aurora::after {
      content: '';
      position: absolute;
      left: 0;
      right: 0;
      bottom: 0;
      height: 200px;
      pointer-events: none;
      background: linear-gradient(to top, var(--bg), transparent);
    }

    /* ── HERO ── */
    .hero {
      padding: 9rem 2rem 6rem;
      overflow: hidden;
    }

    .hero-grid {
      max-width: 1200px;
      margin: 0 auto;
      position: relative;
      z-index: 2;
      display: grid;
      grid-template-columns: minmax(0, 1.05fr) minmax(360px, 0.95fr);
      gap: clamp(3rem, 7vw, 6rem);
      align-items: center;
    }

    .hero-copy { min-width: 0; }

    .hero h1 {
      font-family: var(--sans);
      font-weight: 800;
      font-size: clamp(3rem, 5.4vw, 5.2rem);
      color: var(--text);
      line-height: 1;
      letter-spacing: -0.05em;
      margin-bottom: 2.5rem;
      overflow-wrap: anywhere;
    }

    .hero p {
      font-size: 1.2rem;
      color: var(--text-muted);
      max-width: 640px;
      margin: 0 0 3rem;
      line-height: 1.6;
    }

    .hero-actions {
      display: flex;
      gap: 0.75rem;
      flex-wrap: wrap;
    }

    .hero-visual {
      position: relative;
      min-width: 0;
      width: 100%;
      max-width: 520px;
      justify-self: end;
    }

    .hero-visual::before {
      content: '';
      position: absolute;
      inset: -18px 12px 18px -12px;
      border: 1px solid var(--hairline);
      border-radius: var(--r-md);
      pointer-events: none;
      animation: lab-frame-calibrate 5s ease-in-out infinite;
    }

    .hero-visual figure {
      position: relative;
      width: 100%;
      margin: 0;
      overflow: hidden;
      background: var(--surface);
      border: 1px solid var(--hairline-strong);
      border-radius: var(--r-md);
    }

    .hero-visual figure::after {
      content: '';
      position: absolute;
      z-index: 2;
      inset: -18% 0 auto;
      height: 18%;
      pointer-events: none;
      background: linear-gradient(to bottom, transparent, var(--red-faint) 72%, var(--red) 100%);
      opacity: 0.55;
      mix-blend-mode: screen;
      animation: lab-scan 6.5s cubic-bezier(0.45, 0, 0.55, 1) infinite;
    }

    .hero-visual img {
      display: block;
      width: 100%;
      max-width: 100%;
      height: 650px;
      object-fit: cover;
    }

    .hero-visual figcaption {
      position: absolute;
      inset: auto 0 0;
      display: flex;
      justify-content: space-between;
      gap: 1rem;
      padding: 0.85rem 1rem;
      background: rgba(10, 10, 10, 0.86);
      border-top: 1px solid var(--hairline);
      color: var(--text-muted);
      font-family: var(--mono);
      font-size: 0.64rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }

    /* showcase (mock dashboard) */
    .showcase {
      padding: 4rem 2rem 8rem;
      background: var(--bg);
      position: relative;
      overflow: hidden;
    }

    .showcase-header {
      max-width: 940px;
      margin: 0 0 4rem;
    }

    .showcase-header p {
      color: var(--text-muted);
      font-size: 1.02rem;
      margin-top: 0.75rem;
    }

    .showcase-cards {
      display: grid;
      grid-template-columns: repeat(6, 1fr);
      gap: 1.1rem;
    }

    .showcase-card {
      grid-column: span 2;
      background: var(--surface);
      border: 1px solid var(--hairline);
      border-radius: var(--r-lg);
      padding: 1.5rem;
      display: flex;
      flex-direction: column;
      gap: 0.85rem;
      text-decoration: none;
      position: relative;
      overflow: hidden;
      isolation: isolate;
      transition: border-color .28s, transform .28s cubic-bezier(0.16, 1, 0.3, 1), box-shadow .28s;
    }

    .showcase-card:nth-child(n + 4) {
      grid-column: span 3;
    }

    .showcase-card:hover,
    .showcase-card:focus-visible {
      border-color: var(--hairline-strong);
      transform: translateY(-4px);
      box-shadow: var(--glow-red-soft);
    }

    .showcase-card:focus-visible {
      outline: 2px solid var(--red);
      outline-offset: 3px;
    }

    .showcase-preview {
      position: relative;
      height: 132px;
      overflow: hidden;
      margin: -0.35rem -0.35rem 0.15rem;
      border: 1px solid var(--hairline);
      border-radius: var(--r-md);
      background: var(--surface-2);
    }
    .showcase-preview img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      filter: saturate(0.72) contrast(1.02);
      transform: scale(1.01);
      transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1), filter 0.35s;
    }
    .showcase-preview--migraine img {
      object-fit: contain;
      padding: 0.4rem;
    }
    .showcase-preview--tether img {
      object-fit: cover;
      object-position: center;
    }
    .showcase-preview--forge {
      display: grid;
      place-items: center;
      color: var(--red);
      background: var(--bg-elev);
    }
    .showcase-preview--forge svg { width: 78%; height: 78%; }
    .showcase-preview--forge path { fill: none; stroke: var(--hairline-strong); stroke-width: 1; }
    .showcase-preview--forge circle { fill: var(--surface-2); stroke: currentColor; stroke-width: 1.5; }

    @media (hover: hover) and (pointer: fine) {
      .showcase-card { min-height: 184px; }
      .showcase-preview {
        position: absolute;
        z-index: 0;
        inset: 0;
        height: auto;
        margin: 0;
        border: 0;
        border-radius: inherit;
        opacity: 0;
        transform: scale(1.025);
        transition: opacity 0.3s, transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
      }
      .showcase-preview::after {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(to bottom, var(--red-faint), var(--surface) 82%);
      }
      .showcase-card > :not(.showcase-preview) { position: relative; z-index: 1; }
      .showcase-card:is(:hover, :focus-visible) .showcase-preview {
        opacity: 0.48;
        transform: scale(1);
      }
      .showcase-card:is(:hover, :focus-visible) .showcase-preview img {
        filter: saturate(1) contrast(1.04);
        transform: scale(1.06);
      }
      .showcase-card:is(:hover, :focus-visible) .showcase-preview--migraine img { transform: scale(1); }
      .showcase-card:is(:hover, :focus-visible) h3 { color: var(--peach); }
    }

    .showcase-card h3 {
      font: 600 1.05rem/1.2 var(--sans);
      letter-spacing: -0.015em;
      color: var(--text);
      margin: 0;
      transition: color 0.28s;
    }

    .showcase-card .tagline {
      font: 500 .72rem/1 var(--mono);
      text-transform: uppercase;
      letter-spacing: .08em;
      color: var(--text-muted);
    }

    /* Footnote at the bottom of each showcase card: small dot + label.
       Replaces the old status pill, which broke layout on narrow widths. */
    .showcase-foot {
      margin-top: auto;
      padding-top: 0.85rem;
      border-top: 1px solid var(--hairline);
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      font-family: var(--mono);
      font-size: 0.65rem;
      font-weight: 500;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--text-dim);
    }
    .showcase-foot .dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      flex-shrink: 0;
      background: var(--text-dim);
    }
    .showcase-foot.live { color: var(--red); }
    .showcase-foot.live .dot {
      background: var(--red);
      box-shadow: 0 0 8px var(--red);
      animation: lab-signal-pulse 2.4s ease-out infinite;
    }
    .showcase-foot.muted { color: var(--text-muted); }
    .showcase-foot.muted .dot { background: var(--text-muted); }
    .showcase-foot.experimental { color: #f59e0b; }
    .showcase-foot.experimental .dot {
      background: #f59e0b;
      box-shadow: 0 0 8px #f59e0b;
      animation: lab-signal-pulse 3.2s ease-out infinite;
    }

    /* Motion is progressively enabled by the inline observer below. Content
       remains visible when JavaScript is unavailable. */
    .motion-ready .lab-reveal {
      opacity: 0;
      transform: translateY(22px);
      transition: opacity 0.65s ease, transform 0.65s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .motion-ready .lab-reveal.is-visible {
      opacity: 1;
      transform: translateY(0);
    }
    .hero-copy { animation: lab-enter-copy 0.8s cubic-bezier(0.16, 1, 0.3, 1) both; }
    .hero-visual { animation: lab-enter-visual 0.95s 0.12s cubic-bezier(0.16, 1, 0.3, 1) both; }

    @keyframes lab-grid-drift {
      to { background-position: 24px 24px; }
    }
    @keyframes lab-aurora-breathe {
      from { opacity: 0.72; transform: scale(0.98); }
      to { opacity: 1; transform: scale(1.04); }
    }
    @keyframes lab-frame-calibrate {
      0%, 100% { transform: translate(0, 0); opacity: 0.65; }
      50% { transform: translate(4px, -4px); opacity: 1; }
    }
    @keyframes lab-scan {
      0%, 12% { transform: translateY(0); opacity: 0; }
      18% { opacity: 0.55; }
      72% { opacity: 0.45; }
      82%, 100% { transform: translateY(660%); opacity: 0; }
    }
    @keyframes lab-signal-pulse {
      0%, 35% { box-shadow: 0 0 0 0 currentColor; }
      70%, 100% { box-shadow: 0 0 0 7px transparent; }
    }
    @keyframes lab-enter-copy {
      from { opacity: 0; transform: translateY(18px); }
      to { opacity: 1; transform: translateY(0); }
    }
    @keyframes lab-enter-visual {
      from { opacity: 0; transform: translateY(22px) scale(0.985); }
      to { opacity: 1; transform: translateY(0) scale(1); }
    }

    @media (prefers-reduced-motion: reduce) {
      .grid-bg,
      .aurora::before,
      .hero-copy,
      .hero-visual,
      .hero-visual::before,
      .hero-visual figure::after,
      .showcase-foot .dot { animation: none !important; }
      .showcase-card,
      .showcase-preview,
      .showcase-preview img { transition: none !important; }
      .motion-ready .lab-reveal {
        opacity: 1;
        transform: none;
        transition: none;
      }
    }

    .status-badge {
      display: inline-flex;
      align-items: center;
      gap: .4rem;
      font: 500 .68rem/1 var(--mono);
      letter-spacing: .08em;
      text-transform: uppercase;
      padding: .35rem .6rem;
      border-radius: 6px;
      border: 1px solid var(--hairline);
      color: var(--text-muted);
      width: fit-content;
    }

    .status-badge.live {
      color: var(--red);
      background: var(--red-dim);
      border-color: transparent;
    }

    .status-badge.live::before {
      content: '';
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--red);
      box-shadow: 0 0 8px var(--red);
    }

    .showcase-cta {
      margin-top: 2.5rem;
      display: inline-flex;
      align-items: center;
      gap: .4rem;
      color: var(--text-muted);
      font-weight: 500;
      font-size: .92rem;
      transition: color .2s, gap .2s;
    }

    .showcase-cta:hover {
      color: var(--red);
      gap: .65rem;
    }

    /* ── STATS ── */
    .stats-bar {
      padding: 4rem 2rem;
      background: var(--bg);
      border-top: 1px solid var(--hairline);
      position: relative;
    }

    .stats-inner {
      max-width: 1000px;
      margin: 0 auto;
      text-align: center;
    }

    .stats-quote {
      font-family: var(--sans);
      font-weight: 500;
      font-style: italic;
      font-size: 1.3rem;
      color: var(--text);
      max-width: 720px;
      margin: 0 auto 2.5rem;
      line-height: 1.5;
      letter-spacing: -0.015em;
    }

    .stats-row {
      display: flex;
      justify-content: center;
      gap: 4.5rem;
      flex-wrap: wrap;
    }

    .stat-item {
      text-align: center;
    }

    .stat-item h3 {
      font-family: var(--mono);
      font-size: 2.6rem;
      font-weight: 500;
      background: linear-gradient(180deg, #fff 0%, #FF6363 130%);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
      letter-spacing: -0.02em;
      line-height: 1.1;
    }

    .stat-item p {
      font-family: var(--mono);
      font-size: 0.7rem;
      color: var(--text-dim);
      margin-top: 0.55rem;
      text-transform: uppercase;
      letter-spacing: 0.12em;
    }

    /* ── ABOUT ── */
    .about {
      background: var(--bg-elev);
    }

    .about-grid {
      margin: 0;
    }

    .about-text {
      max-width: 720px;
      margin: 0 0 5rem;
    }

    .about-text p {
      color: var(--text-muted);
      margin-bottom: 1.1rem;
      font-size: 1.02rem;
      line-height: 1.7;
    }

    .about-cards {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1rem;
    }

    .about-card {
      background: var(--surface);
      border: 1px solid var(--hairline);
      border-radius: var(--r-lg);
      padding: 1.4rem;
      transition: border-color 0.2s, transform 0.2s, box-shadow 0.2s;
    }

    .about-card:hover {
      border-color: var(--hairline-strong);
      transform: translateY(-2px);
      box-shadow: var(--glow-red-soft);
    }

    .about-card .card-icon {
      width: 36px;
      height: 36px;
      border-radius: var(--r-sm);
      background: var(--surface-2);
      border: 1px solid var(--hairline);
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 0.85rem;
      color: var(--red);
    }

    .about-card .card-icon .icon-svg {
      width: 18px;
      height: 18px;
    }

    .about-card h4 {
      font-size: 0.96rem;
      font-weight: 600;
      margin-bottom: 0.3rem;
      color: var(--text);
      letter-spacing: -0.01em;
    }

    .about-card p {
      font-size: 0.84rem;
      color: var(--text-muted);
      line-height: 1.55;
    }

    /* ── HOW IT WORKS ── */
    .how-it-works {
      background: var(--bg);
    }

    .how-header {
      margin-bottom: 4rem;
      max-width: 720px;
    }

    .how-header p {
      color: var(--text-muted);
      margin: 0.75rem 0 0;
    }

    .steps-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.25rem;
      max-width: 1000px;
      margin: 0;
    }

    .step {
      background: var(--surface);
      border: 1px solid var(--hairline);
      border-radius: var(--r-lg);
      padding: 1.5rem;
      transition: border-color 0.2s, transform 0.2s, box-shadow 0.2s;
    }

    .step:hover {
      border-color: var(--hairline-strong);
      transform: translateY(-2px);
      box-shadow: var(--glow-red-soft);
    }

    .step h3 {
      font-family: var(--sans);
      font-weight: 600;
      font-size: 1.1rem;
      color: var(--text);
      margin-bottom: 0.4rem;
      letter-spacing: -0.015em;
    }

    .step p {
      font-size: 0.9rem;
      color: var(--text-muted);
      line-height: 1.6;
    }

    /* ── BENTO ── */
    .bento-section {
      background: var(--bg-elev);
    }

    .bento-header {
      margin-bottom: 4rem;
      max-width: 720px;
    }

    .bento-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 1.25rem;
      max-width: 900px;
      margin: 0;
    }

    .bento-card {
      background: var(--surface);
      border: 1px solid var(--hairline);
      border-radius: var(--r-lg);
      padding: 1.6rem;
      position: relative;
      overflow: hidden;
      transition: border-color 0.2s, transform 0.2s, box-shadow 0.2s;
    }

    .bento-card:hover {
      border-color: var(--hairline-strong);
      transform: translateY(-2px);
      box-shadow: var(--glow-red-soft);
    }

    .bento-card>*:not(.grid-bg) {
      position: relative;
      z-index: 1;
    }

    .bento-card .bento-icon {
      width: 32px;
      height: 32px;
      border-radius: var(--r-sm);
      background: var(--surface-2);
      border: 1px solid var(--hairline);
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 0.9rem;
      color: var(--red);
    }

    .bento-card .bento-icon .icon-svg {
      width: 16px;
      height: 16px;
    }

    .bento-card h3 {
      font-family: var(--sans);
      font-weight: 600;
      font-size: 1.05rem;
      color: var(--text);
      margin-bottom: 0.4rem;
      letter-spacing: -0.015em;
    }

    .bento-card p {
      font-size: 0.88rem;
      color: var(--text-muted);
      line-height: 1.6;
    }

    .bento-card .big-stat {
      font-family: var(--mono);
      font-weight: 500;
      font-size: 3.2rem;
      line-height: 1.1;
      letter-spacing: -0.03em;
      background: linear-gradient(180deg, #fff 0%, #FF6363 130%);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
      margin-bottom: 0.6rem;
    }

    .bento-card.bento-feature::before {
      content: '';
      position: absolute;
      top: -40%;
      right: -25%;
      width: 80%;
      height: 130%;
      background: radial-gradient(circle at top right, rgba(255, 99, 99, 0.4), transparent 65%);
      pointer-events: none;
      z-index: 0;
    }

    /* ── PRODUCTS ── */
    .products-section {
      background: var(--bg);
    }

    .products-header {
      margin-bottom: 4rem;
      max-width: 720px;
    }

    .products-header p {
      color: var(--text-muted);
      margin: 0.75rem 0 0;
    }

    .products-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 1.25rem;
    }

    .product-card {
      background: var(--surface);
      border: 1px solid var(--hairline);
      border-radius: var(--r-lg);
      overflow: hidden;
      transition: border-color 0.2s, transform 0.2s, box-shadow 0.2s;
    }

    .product-card:hover {
      border-color: var(--hairline-strong);
      transform: translateY(-3px);
      box-shadow: var(--glow-red-soft);
    }

    .product-card-featured {
      grid-column: 1 / -1;
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }

    .product-card-featured .product-card-img {
      aspect-ratio: auto;
      min-height: 100%;
      border-bottom: 0;
      border-right: 1px solid var(--hairline);
    }

    .product-card-img {
      width: 100%;
      aspect-ratio: 4/3;
      background: var(--surface-2);
      border-bottom: 1px solid var(--hairline);
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      overflow: hidden;
    }

    .product-card-img::before {
      content: '';
      position: absolute;
      inset: 0;
      background: radial-gradient(circle at center, rgba(255, 99, 99, 0.18), transparent 60%);
      pointer-events: none;
    }

    .product-card-img>.icon-svg {
      position: relative;
      z-index: 1;
      color: var(--red);
      filter: drop-shadow(0 0 18px rgba(255, 99, 99, 0.35));
    }

    /* Real product screenshots / mockups. Sits on the dark surface-2
       backdrop with a subtle inset so each image breathes. Different
       source aspect ratios (square dashboard, portrait quote card,
       angled phone mockup) all read consistently via object-fit:contain. */
    .product-card-img>img {
      position: relative;
      z-index: 1;
      width: 100%;
      height: 100%;
      object-fit: contain;
      padding: 1.5rem;
      filter: drop-shadow(0 12px 30px rgba(0, 0, 0, 0.45));
    }

    .product-card-img.has-tether {
      padding: 1.5rem;
      background:
        radial-gradient(circle at 50% 35%, rgba(255, 164, 138, 0.16), transparent 58%),
        var(--surface-2);
    }

    .product-card-img.has-tether > img {
      max-width: 78%;
      max-height: 430px;
      border-radius: 16px;
      box-shadow: 0 22px 50px rgba(0, 0, 0, 0.55);
    }

    /* Browser-frame treatment for SaaS / web products. Wraps a light
       screenshot inside a dark macOS-style window so the white UI feels
       intentional on the dark page instead of fighting the theme. */
    .product-card-img.has-browser {
      padding: 1.25rem;
    }
    .product-card-img.has-browser>.browser {
      position: relative;
      z-index: 1;
      width: 100%;
      height: 100%;
      background: #ffffff;
      border-radius: 8px;
      overflow: hidden;
      border: 1px solid var(--hairline-strong);
      box-shadow: 0 14px 32px rgba(0, 0, 0, 0.5);
      display: flex;
      flex-direction: column;
    }
    .browser-bar {
      background: var(--bg-elev);
      padding: 0.45rem 0.7rem;
      display: flex;
      align-items: center;
      gap: 0.35rem;
      border-bottom: 1px solid var(--hairline);
      flex-shrink: 0;
    }
    .browser-bar>span {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      flex-shrink: 0;
    }
    .browser-bar>span:nth-child(1) { background: #ff5f57; }
    .browser-bar>span:nth-child(2) { background: #ffbd2e; }
    .browser-bar>span:nth-child(3) { background: #28c941; }
    .browser-url {
      margin-left: 0.5rem;
      font-family: var(--mono);
      font-size: 0.6rem;
      color: var(--text-muted);
      background: rgba(255, 255, 255, 0.04);
      padding: 0.2rem 0.6rem;
      border-radius: 4px;
      border: 1px solid var(--hairline);
      letter-spacing: 0.04em;
    }
    .browser-view {
      flex: 1;
      overflow: hidden;
      background: #fafafa;
      min-height: 0;
    }
    .browser-view>img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: top center;
    }

    /* Brief-frame treatment for Forge (Forge Brief, macOS morning PR
       summary). Dark window styled as the live app — PR rows with title,
       meta, and an outcome tag (quality score / pushback / unreviewed). */
    .product-card-img.has-brief { padding: 1.25rem; }
    .product-card-img.has-brief > .brief {
      position: relative;
      z-index: 1;
      width: 100%;
      height: 100%;
      background: #0d1419;
      border-radius: 8px;
      overflow: hidden;
      border: 1px solid rgba(148, 184, 220, 0.18);
      box-shadow: 0 14px 32px rgba(0, 0, 0, 0.6);
      display: flex;
      flex-direction: column;
      font-family: var(--sans);
    }
    .brief-bar {
      background: #141c24;
      padding: 0.45rem 0.7rem;
      display: flex;
      align-items: center;
      gap: 0.35rem;
      border-bottom: 1px solid rgba(148, 184, 220, 0.09);
      flex-shrink: 0;
    }
    .brief-bar > span {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      flex-shrink: 0;
    }
    .brief-bar > span:nth-child(1) { background: #ff5f57; }
    .brief-bar > span:nth-child(2) { background: #ffbd2e; }
    .brief-bar > span:nth-child(3) { background: #28c941; }
    .brief-title {
      margin-left: 0.5rem;
      font-family: var(--mono);
      font-size: 0.6rem;
      color: #94a4b3;
      letter-spacing: 0.04em;
    }
    .brief-body {
      flex: 1;
      padding: 0.85rem 0.95rem;
      overflow: hidden;
      min-height: 0;
      display: flex;
      flex-direction: column;
      gap: 0.45rem;
      font-size: 0.72rem;
      line-height: 1.4;
    }
    .brief-summary {
      font-family: var(--mono);
      font-size: 0.62rem;
      letter-spacing: 0.06em;
      color: var(--red);
      text-transform: uppercase;
      padding-bottom: 0.4rem;
      border-bottom: 1px solid rgba(148, 184, 220, 0.09);
      margin-bottom: 0.2rem;
    }
    .brief-pr {
      display: grid;
      grid-template-columns: auto 1fr auto;
      gap: 0.2rem 0.5rem;
      align-items: center;
      padding: 0.35rem 0;
    }
    .brief-pr-src {
      grid-column: 1;
      grid-row: 1 / span 2;
      font-family: var(--mono);
      font-size: 0.5rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      font-weight: 600;
      padding: 0.18rem 0.36rem;
      border-radius: 3px;
      align-self: center;
      width: 38px;
      text-align: center;
    }
    .brief-pr-src.gh { color: #b6c5d5; background: rgba(182, 197, 213, 0.10); }
    .brief-pr-src.sl { color: #f3a5b8; background: rgba(243, 165, 184, 0.10); }
    .brief-pr-src.ln { color: #9aa8d6; background: rgba(154, 168, 214, 0.10); }
    .brief-pr-src.nt { color: #e8b864; background: rgba(232, 184, 100, 0.10); }
    .brief-pr-title {
      grid-column: 2;
      color: #e4ecf4;
      font-weight: 500;
      font-size: 0.7rem;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .brief-pr-meta {
      grid-column: 2;
      grid-row: 2;
      font-family: var(--mono);
      font-size: 0.58rem;
      color: #6e7e8e;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .brief-pr-tag {
      grid-column: 3;
      grid-row: 1 / span 2;
      font-family: var(--mono);
      font-size: 0.55rem;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      padding: 0.2rem 0.45rem;
      border-radius: 4px;
      font-weight: 600;
      flex-shrink: 0;
    }
    .brief-pr-tag.good { color: #5eead4; background: rgba(94, 234, 212, 0.1); }
    .brief-pr-tag.warn { color: #f59e0b; background: rgba(245, 158, 11, 0.12); }
    .brief-pr-tag.muted { color: #94a4b3; background: rgba(148, 184, 220, 0.08); }

    /* Terminal-frame treatment for Forge (CTO desktop dashboard). Dark
       native macOS window showing a multi-agent terminal. CSS-only — no
       image asset. */
    .product-card-img.has-terminal {
      padding: 1.25rem;
    }
    .product-card-img.has-terminal>.term {
      position: relative;
      z-index: 1;
      width: 100%;
      height: 100%;
      background: #0d1419;
      border-radius: 8px;
      overflow: hidden;
      border: 1px solid rgba(148, 184, 220, 0.18);
      box-shadow: 0 14px 32px rgba(0, 0, 0, 0.6);
      display: flex;
      flex-direction: column;
      font-family: var(--mono);
    }
    .term-bar {
      background: #141c24;
      padding: 0.45rem 0.7rem;
      display: flex;
      align-items: center;
      gap: 0.35rem;
      border-bottom: 1px solid rgba(148, 184, 220, 0.09);
      flex-shrink: 0;
    }
    .term-bar>span {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      flex-shrink: 0;
    }
    .term-bar>span:nth-child(1) { background: #ff5f57; }
    .term-bar>span:nth-child(2) { background: #ffbd2e; }
    .term-bar>span:nth-child(3) { background: #28c941; }
    .term-title {
      margin-left: 0.5rem;
      font-size: 0.6rem;
      color: #94a4b3;
      letter-spacing: 0.04em;
    }
    .term-body {
      flex: 1;
      padding: 0.85rem 0.95rem;
      overflow: hidden;
      min-height: 0;
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      font-size: 0.7rem;
      line-height: 1.45;
    }
    .term-line {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      flex-wrap: nowrap;
      overflow: hidden;
    }
    .term-prompt { color: #f59e0b; font-weight: 600; flex-shrink: 0; }
    .term-agent {
      flex-shrink: 0;
      padding: 0.05rem 0.4rem;
      border-radius: 3px;
      font-weight: 600;
      font-size: 0.62rem;
    }
    .term-agent.claude  { background: rgba(245, 158, 11, 0.16); color: #f59e0b; }
    .term-agent.cursor  { background: rgba(94, 234, 212, 0.16); color: #5eead4; }
    .term-agent.codex   { background: rgba(132, 204, 22, 0.16); color: #84cc16; }
    .term-text {
      color: #e4ecf4;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      flex: 1;
      min-width: 0;
    }
    .term-status {
      flex-shrink: 0;
      font-size: 0.55rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      padding: 0.05rem 0.4rem;
      border-radius: 3px;
      font-weight: 600;
    }
    .term-status.running { color: #5eead4; background: rgba(94, 234, 212, 0.1); }
    .term-status.done    { color: #94a4b3; background: rgba(148, 184, 220, 0.08); }
    .term-cursor {
      display: inline-block;
      width: 6px;
      height: 0.85em;
      background: #f59e0b;
      animation: term-blink 1.1s steps(2, end) infinite;
      vertical-align: middle;
    }
    @keyframes term-blink {
      50% { opacity: 0; }
    }

    /* Muted status badge variant — for coming-soon / pre-launch items.
       No dot, neutral colors. Distinguishes from the red "live" glow. */
    .status-badge.muted {
      color: var(--text-muted);
      background: rgba(255, 255, 255, 0.04);
      border-color: var(--hairline);
    }

    /* Experimental status badge — amber/copper dot for very-early work. */
    .status-badge.experimental {
      color: #f59e0b;
      background: rgba(245, 158, 11, 0.1);
      border-color: rgba(245, 158, 11, 0.28);
    }
    .status-badge.experimental::before {
      content: '';
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: #f59e0b;
      box-shadow: 0 0 8px #f59e0b;
    }

    .product-card-body {
      padding: 1.4rem;
    }

    .product-card-body h3 {
      font-family: var(--sans);
      font-weight: 600;
      font-size: 1.15rem;
      color: var(--text);
      margin-bottom: 0.3rem;
      letter-spacing: -0.015em;
      display: inline-flex;
      align-items: center;
      gap: 0.55rem;
      flex-wrap: wrap;
    }
    .title-suffix {
      font-family: var(--mono);
      font-size: 0.62rem;
      font-weight: 500;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--text-muted);
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid var(--hairline);
      padding: 0.2rem 0.5rem;
      border-radius: 6px;
      letter-spacing: 0.08em;
    }
    .title-suffix.experimental {
      color: #f59e0b;
      background: rgba(245, 158, 11, 0.1);
      border-color: rgba(245, 158, 11, 0.28);
    }

    .product-card-body .tagline {
      font-family: var(--mono);
      font-size: 0.7rem;
      font-weight: 500;
      color: var(--red);
      text-transform: uppercase;
      letter-spacing: 0.1em;
      margin-bottom: 0.85rem;
    }

    .product-card-body p {
      font-size: 0.88rem;
      color: var(--text-muted);
      margin-bottom: 1rem;
      line-height: 1.6;
    }

    .product-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 0.35rem;
    }

    .product-tags span {
      font-size: 0.68rem;
      padding: 0.25rem 0.55rem;
      border-radius: 5px;
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid var(--hairline);
      color: var(--text-muted);
      font-family: var(--mono);
      letter-spacing: 0.02em;
    }

    .product-link {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      margin-top: 1.1rem;
      color: var(--text-muted);
      font-size: 0.85rem;
      font-weight: 500;
      transition: gap 0.2s, color 0.2s;
    }

    .product-link:hover {
      gap: 0.7rem;
      color: var(--red);
    }

    /* ── COMPARISON ── */
    .comparison {
      background: var(--bg);
      padding: 7rem 2rem;
    }

    .comparison-header {
      margin-bottom: 4rem;
      max-width: 720px;
    }

    .comparison-table {
      max-width: 1024px;
      margin: 0;
    }

    .comp-row {
      display: grid;
      grid-template-columns: 1.4fr 1fr 1fr;
      border-bottom: 1px solid var(--hairline);
    }

    .comp-cell {
      padding: 1.25rem 1rem;
      font-size: 0.92rem;
      color: var(--text-muted);
    }

    .comp-head {
      font-family: var(--mono);
      font-size: 0.7rem;
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--text-dim);
      padding: 1rem 1rem 0.85rem;
    }

    .comp-head.highlight {
      color: var(--text);
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
    }

    .comp-head:nth-child(3) {
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
    }

    .comp-head.highlight::before {
      content: '';
      width: 8px;
      height: 8px;
      background: var(--red);
      border-radius: 2px;
      display: inline-block;
      box-shadow: 0 0 12px rgba(255, 99, 99, 0.5);
    }

    .comp-cell.feature {
      color: var(--text);
    }

    .comp-cell.check {
      display: grid;
      place-items: center;
    }

    .comp-cell.check .icon-svg {
      display: block;
      width: 18px;
      height: 18px;
    }

    /* ── PHILOSOPHY ── */
    .philosophy {
      background: var(--bg-elev);
    }

    .philosophy-inner {
      margin: 0;
    }

    .philosophy-text {
      max-width: 720px;
      margin: 0 0 5rem;
    }

    .philosophy-text p {
      color: var(--text-muted);
      font-size: 1.02rem;
      margin-bottom: 1.1rem;
      line-height: 1.7;
    }

    .philosophy-visual {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 0.9rem;
    }

    .phil-card {
      background: var(--surface);
      border: 1px solid var(--hairline);
      border-radius: var(--r-lg);
      padding: 1.4rem;
      text-align: left;
      transition: border-color 0.2s, transform 0.2s, box-shadow 0.2s;
    }

    .phil-card:hover {
      border-color: var(--hairline-strong);
      transform: translateY(-2px);
      box-shadow: var(--glow-red-soft);
    }

    .phil-card .phil-icon {
      width: 32px;
      height: 32px;
      border-radius: var(--r-sm);
      background: var(--surface-2);
      border: 1px solid var(--hairline);
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 0.85rem;
      color: var(--red);
    }

    .phil-card .phil-icon .icon-svg {
      width: 16px;
      height: 16px;
    }

    .phil-card h4 {
      font-family: var(--sans);
      font-weight: 600;
      font-size: 0.98rem;
      color: var(--text);
      margin-bottom: 0.3rem;
      letter-spacing: -0.01em;
    }

    .phil-card p {
      font-size: 0.85rem;
      color: var(--text-muted);
    }

    .phil-card.tall {
      display: flex;
      flex-direction: column;
      justify-content: center;
      position: relative;
      overflow: hidden;
      border-color: rgba(255, 99, 99, 0.28);
      box-shadow: var(--glow-red-soft);
    }

