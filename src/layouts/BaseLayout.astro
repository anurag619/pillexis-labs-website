---
import SEO from '../components/SEO.astro';
import '../styles/tokens.css';

export interface Props {
  title: string;
  description: string;
  path?: string;
  image?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  type?: 'website' | 'article';
  /** Optional language. Default "en". */
  lang?: string;
  /** Pass-through inline body class (rare — for per-page utility flags). */
  bodyClass?: string;
  /**
   * Stash the query string into window.__bk and strip it from the URL BEFORE
   * GA/Pixel fire PageView. Used on /booked, where Cal forwards booking params
   * (incl. the attendee's raw email) — we want the data, but not in analytics
   * page_location. The page reads window.__bk after load.
   */
  scrubQuery?: boolean;
}

const {
  title,
  description,
  path,
  image,
  noindex,
  jsonLd,
  type,
  lang = 'en',
  bodyClass = '',
  scrubQuery = false,
} = Astro.props;

const GA_ID = import.meta.env.PUBLIC_GA_ID;
const FB_PIXEL_ID = import.meta.env.PUBLIC_FB_PIXEL_ID;
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    {/* Favicons + app icons. Master mark lives at /brand/logomark.svg */}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f5f1ee" data-theme-color />
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('pillexis-theme');
          var theme = saved === 'dark' ? 'dark' : 'light';
          if (saved !== theme) localStorage.setItem('pillexis-theme', theme);
          document.documentElement.dataset.theme = theme;
          document.documentElement.style.colorScheme = theme;
        } catch (e) {
          document.documentElement.dataset.theme = 'light';
          document.documentElement.style.colorScheme = 'light';
        }
      })();
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />

    <SEO
      title={title}
      description={description}
      path={path}
      image={image}
      noindex={noindex}
      jsonLd={jsonLd}
      type={type}
    />

    {/* Stash + strip query params BEFORE any analytics fire, so forwarded
        booking data (incl. raw email) never lands in GA/Pixel page_location.
        The page reads window.__bk after load. Must precede GA + Pixel. */}
    {scrubQuery && (
      <script is:inline>
        (function () {
          try {
            if (location.search) {
              window.__bk = Object.fromEntries(new URLSearchParams(location.search));
              history.replaceState(null, '', location.pathname + location.hash);
            }
          } catch (e) {}
        })();
      </script>
    )}

    {/* Google Analytics 4 */}
    {GA_ID && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>
        <script is:inline define:vars={{ GA_ID }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          window.gtag = gtag;
          gtag('js', new Date());
          gtag('config', GA_ID, { anonymize_ip: true });
        </script>
      </>
    )}

    {/* Facebook Pixel */}
    {FB_PIXEL_ID && (
      <script is:inline define:vars={{ FB_PIXEL_ID }}>
        !function(f,b,e,v,n,t,s)
        {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
        n.callMethod.apply(n,arguments):n.queue.push(arguments)};
        if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
        n.queue=[];t=b.createElement(e);t.async=!0;
        t.src=v;s=b.getElementsByTagName(e)[0];
        s.parentNode.insertBefore(t,s)}(window, document,'script',
        'https://connect.facebook.net/en_US/fbevents.js');
        fbq('init', FB_PIXEL_ID);
        fbq('track', 'PageView');
      </script>
    )}
  </head>
  <body class={bodyClass}>
    <slot />
    <script is:inline>
      (function () {
        var meta = document.querySelector('[data-theme-color]');
        function currentTheme() {
          return document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light';
        }
        function paint(theme, persist) {
          document.documentElement.dataset.theme = theme;
          document.documentElement.style.colorScheme = theme;
          if (persist) localStorage.setItem('pillexis-theme', theme);
          if (meta) meta.setAttribute('content', theme === 'light' ? '#f5f1ee' : '#0a0a0a');
          document.querySelectorAll('[data-theme-option]').forEach(function (button) {
            var selected = button.getAttribute('data-theme-option') === theme;
            button.setAttribute('aria-pressed', String(selected));
          });
        }
        paint(currentTheme(), false);
        document.querySelectorAll('[data-theme-option]').forEach(function (button) {
          button.addEventListener('click', function () {
            paint(button.getAttribute('data-theme-option'), true);
          });
        });
      })();
    </script>
  </body>
</html>
